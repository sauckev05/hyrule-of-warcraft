+bool ChatHandler::HandleZeldaSlashCommand(char* /*args*/)
+{
+    Player* player = m_session->GetPlayer();
+    if (!CanAct(player))
+        return true;
+
+    ZeldaState& state = StateFor(player);
+    Style style = StyleOf(player);
+    StyleStats stats = StatsFor(style);
+    uint32 now = WorldTimer::getMSTime();
+    if (now - state.lastSlash < stats.slashGapMs)
+        return true;
+
+    state.comboCount = (now - state.lastSlash <= COMBO_WINDOW_MS) ? state.comboCount + 1 : 1;
+    state.lastSlash = now;
+    bool finisher = state.comboCount >= 3;
+    if (finisher)
+        state.comboCount = 0;
+
+    std::list<Unit*> enemies;
+    CollectEnemies(player, stats.slashRange + 2.0f, enemies);
+
+    // Prefer the selected target if it is in reach, then everything else in the cone in front of us.
+    Unit* selected = ObjectAccessor::GetUnit(*player, player->GetSelectionGuid());
+    uint32 hit = 0;
+    for (Unit* unit : enemies)
+    {
+        bool inReach = player->IsWithinDistInMap(unit, stats.slashRange + unit->GetCombatReach());
+        bool inFront = player->HasInArc(unit, stats.slashArc) || unit == selected;
+        if (!inReach || !inFront)
+            continue;
+        ZeldaSwing(player, unit, finisher ? 2 : 1);
+        if (style == Style::DualWield && unit->IsAlive())
+            player->AttackerStateUpdate(unit, OFF_ATTACK, true);
+        ++hit;
+    }
+
+    if (hit == 0)
+        player->HandleEmoteCommand(EMOTE_ONESHOT_ATTACK1H); // swing at the air
+    return true;
+}
+
+bool ChatHandler::HandleZeldaSpinCommand(char* /*args*/)
+{
+    Player* player = m_session->GetPlayer();
+    if (!CanAct(player))
+        return true;
+
+    ZeldaState& state = StateFor(player);
+    uint32 now = WorldTimer::getMSTime();
+    if (now < state.spinReadyAt)
+        return true;
+
+    // The spin costs 50 rage; without it there is no spin.
+    bool const usesRage = player->GetPowerType() == POWER_RAGE;
+    if (usesRage && player->GetPower(POWER_RAGE) < SPIN_RAGE_COST)
+    {
+        player->GetSession()->SendNotification("Not enough rage for a Spin Attack (50 needed)");
+        return true;
+    }
+    if (usesRage)
+        player->ModifyPower(POWER_RAGE, -int32(SPIN_RAGE_COST));
+
+    state.spinReadyAt = now + SPIN_COOLDOWN_MS;
+    state.comboCount = 0;
+
+    StyleStats stats = StatsFor(StyleOf(player));
+    std::list<Unit*> enemies;
+    CollectEnemies(player, stats.spinRange + 2.0f, enemies);
+    std::vector<Unit*> victims;
+    std::vector<ObjectGuid> hitGuids;
+    for (Unit* unit : enemies)
+    {
+        if (player->IsWithinDistInMap(unit, stats.spinRange + unit->GetCombatReach()))
+        {
+            victims.push_back(unit);
+            hitGuids.push_back(unit->GetObjectGuid());
+        }
+    }
+    // the Whirlwind spin goes out first so the hits land while the hero is turning
+    PlayWhirlwind(player, hitGuids);
+    // two strikes per enemy, each worth three normal swings
+    t_meleeMultiplier = SPIN_DAMAGE_MULTIPLIER;
+    for (Unit* unit : victims)
+        ZeldaSwing(player, unit, SPIN_STRIKES);
+    t_meleeMultiplier = 1.0f;
+    return true;
+}
