--- /dev/null
+++ b/src/game/Chat/ZeldaCommands.cpp
@@ -0,0 +1,492 @@
+/*
+ * Zelda of Warcraft: Ocarina of Time style combat moves for players, driven by chat commands that
+ * the client sends from key bindings (any 1.12 client + the ZeldaControls addon, or Benilla).
+ *
+ *   .zslash     sword slash: hits every enemy in a cone in front of you; every 3rd quick slash is a finisher
+ *   .zspin      spin attack: hits every enemy around you twice (after holding the attack key)
+ *   .zroll      dodge roll forward with a short moment of invulnerability
+ *   .zflip      backflip away with a short moment of invulnerability
+ *   .zshield    toggles the shield: heavy damage reduction from the front, slower movement
+ *   .zhook      hookshot: pulls you to your target
+ *   .zbow       fire your bow, crossbow, gun, thrown weapon or wand at the target (or the enemy you face)
+ *
+ * Your WoW weapons decide your fighting style, as Link's sword and shield or the Biggoron's Sword:
+ *   one-handed weapon + shield   quick slashes, and the shield can block
+ *   two-handed weapon            slower, wider and longer slashes and a bigger spin, but no shield
+ *   two weapons (dual wield)     every slash strikes with both hands, no shield
+ */
+
+#include "Common.h"
+#include "Chat/Chat.h"
+#include "Chat/ZeldaCommands.h"
+#include "Entities/Player.h"
+#include "Entities/Unit.h"
+#include "Grids/GridNotifiers.h"
+#include "Grids/GridNotifiersImpl.h"
+#include "Grids/CellImpl.h"
+#include "Util/Timer.h"
+#include "Entities/Item.h"
+#include "Entities/ItemPrototype.h"
+#include "Globals/ObjectAccessor.h"
+#include "Config/Config.h"
+#include "Maps/MapManager.h"
+#include "Server/WorldPacket.h"
+#include "Server/Opcodes.h"
+
+#include <algorithm>
+#include <cmath>
+#include <vector>
+#include <mutex>
+#include <unordered_map>
+
+namespace
+{
+    struct ZeldaState
+    {
+        uint32 lastSlash = 0;
+        uint32 comboCount = 0;
+        uint32 spinReadyAt = 0;
+        uint32 dodgeReadyAt = 0;
+        uint32 invulnerableUntil = 0;
+        uint32 hookReadyAt = 0;
+        uint32 bowReadyAt = 0;
+        bool shield = false;
+    };
+
+    // Commands run on the session's thread and damage on map threads, so the table is locked.
+    std::unordered_map<uint32, ZeldaState> s_states;
+    std::mutex s_statesLock;
+
+    ZeldaState& StateFor(Player* player)
+    {
+        std::lock_guard<std::mutex> guard(s_statesLock);
+        return s_states[player->GetGUIDLow()]; // references stay valid: unordered_map never moves nodes
+    }
+
+    const uint32 COMBO_WINDOW_MS = 1100;
+    const uint32 SPIN_COOLDOWN_MS = 2500;
+    const uint32 SPIN_RAGE_COST = 50 * 10;        // 50 rage (stored x10)
+    const float SPIN_DAMAGE_MULTIPLIER = 3.0f;    // a spin hit is three normal swings
+
+    // Set while the spin attack's swings resolve; CalculateMeleeDamage reads it on the same thread.
+    thread_local float t_meleeMultiplier = 1.0f;
+    const uint32 DODGE_COOLDOWN_MS = 900;
+    const uint32 DODGE_INVULN_MS = 450;
+    const uint32 HOOK_COOLDOWN_MS = 4000;
+    const float HOOK_RANGE = 30.0f;
+    const float BOW_RANGE = 35.0f;
+    const uint32 BOW_COOLDOWN_MS = 1100;
+
+    enum class Style { OneHanded, TwoHanded, DualWield, Unarmed };
+
+    struct StyleStats
+    {
+        float slashRange;
+        float slashArc;
+        uint32 slashGapMs;
+        float spinRange;
+        uint32 spinHits;
+    };
+
+    Style StyleOf(Player* player)
+    {
+        Item* main = player->GetWeaponForAttack(BASE_ATTACK, true, true);
+        if (!main)
+            return Style::Unarmed;
+        if (main->GetProto()->InventoryType == INVTYPE_2HWEAPON)
+            return Style::TwoHanded;
+        if (player->GetWeaponForAttack(OFF_ATTACK, true, true))
+            return Style::DualWield;
+        return Style::OneHanded;
+    }
+
+    StyleStats StatsFor(Style style)
+    {
+        switch (style)
+        {
+            case Style::TwoHanded: return { 7.0f, M_PI_F * 5.0f / 6.0f, 650, 9.5f, 3 }; // Biggoron's Sword
+            case Style::DualWield: return { 5.5f, M_PI_F * 2.0f / 3.0f, 420, 7.5f, 2 };
+            case Style::Unarmed:   return { 4.5f, M_PI_F / 2.0f, 380, 6.0f, 1 };
+            default:               return { 5.5f, M_PI_F * 2.0f / 3.0f, 380, 7.5f, 2 }; // Kokiri/Master Sword
+        }
+    }
+
+    const char* StyleName(Style style)
+    {
+        switch (style)
+        {
+            case Style::TwoHanded: return "two-handed weapon";
+            case Style::DualWield: return "two weapons";
+            case Style::Unarmed:   return "no weapon";
+            default:               return "one-handed weapon";
+        }
+    }
+
+    void CollectEnemies(Player* player, float range, std::list<Unit*>& out)
+    {
+        MaNGOS::AnyUnfriendlyUnitInObjectRangeCheck check(player, range);
+        MaNGOS::UnitListSearcher<MaNGOS::AnyUnfriendlyUnitInObjectRangeCheck> searcher(out, check);
+        Cell::VisitAllObjects(player, searcher, range);
+
+        for (auto itr = out.begin(); itr != out.end();)
+        {
+            Unit* unit = *itr;
+            if (!unit->IsAlive() || !player->CanAttack(unit) || !player->IsWithinLOSInMap(unit))
+                itr = out.erase(itr);
+            else
+                ++itr;
+        }
+    }
+
+    bool CanAct(Player* player)
+    {
+        return player->IsAlive() && !player->IsTaxiFlying() && !player->IsMounted() &&
+               !player->hasUnitState(UNIT_STAT_CAN_NOT_REACT) && !player->HasFlag(UNIT_FIELD_FLAGS, UNIT_FLAG_PACIFIED);
+    }
+
+    void ZeldaSwing(Player* player, Unit* victim, uint32 hits)
+    {
+        for (uint32 i = 0; i < hits && victim->IsAlive(); ++i)
+            player->AttackerStateUpdate(victim, BASE_ATTACK, true);
+    }
+
+    // Warrior Whirlwind (rank 1). Its cast animation is the spin attack's look.
+    const uint32 WHIRLWIND_SPELL = 1680;
+
+    // Plays Whirlwind's spinning animation, swoosh and sound on the hero for every client nearby,
+    // without casting the spell: an SMSG_SPELL_GO with no effects, listing the enemies the spin hit
+    // so they show Whirlwind's impact too. The damage itself still comes from ZeldaSwing.
+    void PlayWhirlwind(Player* player, std::vector<ObjectGuid> const& hits)
+    {
+        uint8 const count = uint8(std::min<size_t>(hits.size(), 255));
+        WorldPacket data(SMSG_SPELL_GO, 32 + count * 8);
+        data << player->GetPackGUID();                 // caster (no item)
+        data << player->GetPackGUID();                 // caster unit
+        data << uint32(WHIRLWIND_SPELL);
+        data << uint16(0x0100 | 0x0001);               // CAST_FLAG_UNKNOWN9 | CAST_FLAG_HIDDEN_COMBATLOG
+        data << count;                                 // hit targets
+        for (uint8 i = 0; i < count; ++i)
+            data << hits[i];
+        data << uint8(0);                              // missed targets
+        data << uint16(0);                             // TARGET_FLAG_SELF
+        player->SendMessageToSet(data, true);
+
+        // the hero's own client starts Whirlwind's cooldown and global cooldown when the GO
+        // arrives - clear them, so the spin never locks the action bar
+        player->SendClearCooldown(WHIRLWIND_SPELL, player);
+    }
+}
+
+float ZeldaMeleeMultiplier()
+{
+    return t_meleeMultiplier;
+}
+
+uint8 ZeldaStatClass(Player const* player)
+{
+    static bool const warriorScaling = sConfig.GetBoolDefault("Zelda.WarriorScaling", true);
+    return warriorScaling ? uint8(CLASS_WARRIOR) : player->getClass();
+}
+
+bool ZeldaFreePotion(SpellEntry const& spell, ItemPrototype const* item)
+{
+    static bool const noPotionCooldown = sConfig.GetBoolDefault("Zelda.NoPotionCooldown", true);
+    if (!noPotionCooldown || !item || item->Class != ITEM_CLASS_CONSUMABLE)
+        return false;
+
+    uint32 category = spell.Category;
+    for (auto const& itemSpell : item->Spells)
+        if (itemSpell.SpellId == spell.Id && itemSpell.SpellCategory)
+            category = itemSpell.SpellCategory;
+    return category == 4; // SPELLCATEGORY_HEALTH_MANA_POTIONS: healing, mana and rejuvenation potions
+}
+
+uint32 ZeldaModifyIncomingDamage(Player* victim, Unit* attacker, uint32 damage)
+{
+    if (!victim || damage == 0)
+        return damage;
+
+    ZeldaState state;
+    {
+        std::lock_guard<std::mutex> guard(s_statesLock);
+        auto itr = s_states.find(victim->GetGUIDLow());
+        if (itr == s_states.end())
+            return damage;
+        state = itr->second;
+    }
+    if (WorldTimer::getMSTime() < state.invulnerableUntil)
+        return 0; // rolled through it
+
+    if (state.shield && attacker && attacker != victim && victim->HasInArc(attacker, M_PI_F * 2.0f / 3.0f))
+        return damage / 5; // blocked with the shield: 80% less
+
+    return damage;
+}
+
+bool ChatHandler::HandleZeldaSlashCommand(char* /*args*/)
+{
+    Player* player = m_session->GetPlayer();
+    if (!CanAct(player))
+        return true;
+
+    ZeldaState& state = StateFor(player);
+    Style style = StyleOf(player);
+    StyleStats stats = StatsFor(style);
+    uint32 now = WorldTimer::getMSTime();
+    if (now - state.lastSlash < stats.slashGapMs)
+        return true;
+
+    state.comboCount = (now - state.lastSlash <= COMBO_WINDOW_MS) ? state.comboCount + 1 : 1;
+    state.lastSlash = now;
+    bool finisher = state.comboCount >= 3;
+    if (finisher)
+        state.comboCount = 0;
+
+    std::list<Unit*> enemies;
+    CollectEnemies(player, stats.slashRange + 2.0f, enemies);
+
+    // Prefer the selected target if it is in reach, then everything else in the cone in front of us.
+    Unit* selected = ObjectAccessor::GetUnit(*player, player->GetSelectionGuid());
+    uint32 hit = 0;
+    for (Unit* unit : enemies)
+    {
+        bool inReach = player->IsWithinDistInMap(unit, stats.slashRange + unit->GetCombatReach());
+        bool inFront = player->HasInArc(unit, stats.slashArc) || unit == selected;
+        if (!inReach || !inFront)
+            continue;
+        ZeldaSwing(player, unit, finisher ? 2 : 1);
+        if (style == Style::DualWield && unit->IsAlive())
+            player->AttackerStateUpdate(unit, OFF_ATTACK, true);
+        ++hit;
+    }
+
+    if (hit == 0)
+        player->HandleEmoteCommand(EMOTE_ONESHOT_ATTACK1H); // swing at the air
+    return true;
+}
+
+bool ChatHandler::HandleZeldaSpinCommand(char* /*args*/)
+{
+    Player* player = m_session->GetPlayer();
+    if (!CanAct(player))
+        return true;
+
+    ZeldaState& state = StateFor(player);
+    uint32 now = WorldTimer::getMSTime();
+    if (now < state.spinReadyAt)
+        return true;
+
+    // The spin costs 50 rage; without it there is no spin.
+    bool const usesRage = player->GetPowerType() == POWER_RAGE;
+    if (usesRage && player->GetPower(POWER_RAGE) < SPIN_RAGE_COST)
+    {
+        player->GetSession()->SendNotification("Not enough rage for a Spin Attack (50 needed)");
+        return true;
+    }
+    if (usesRage)
+        player->ModifyPower(POWER_RAGE, -int32(SPIN_RAGE_COST));
+
+    state.spinReadyAt = now + SPIN_COOLDOWN_MS;
+    state.comboCount = 0;
+
+    StyleStats stats = StatsFor(StyleOf(player));
+    std::list<Unit*> enemies;
+    CollectEnemies(player, stats.spinRange + 2.0f, enemies);
+    std::vector<Unit*> victims;
+    std::vector<ObjectGuid> hitGuids;
+    for (Unit* unit : enemies)
+    {
+        if (player->IsWithinDistInMap(unit, stats.spinRange + unit->GetCombatReach()))
+        {
+            victims.push_back(unit);
+            hitGuids.push_back(unit->GetObjectGuid());
+        }
+    }
+    // the Whirlwind spin goes out first so the hits land while the hero is turning
+    PlayWhirlwind(player, hitGuids);
+    // one strike per enemy, worth three normal swings
+    t_meleeMultiplier = SPIN_DAMAGE_MULTIPLIER;
+    for (Unit* unit : victims)
+        ZeldaSwing(player, unit, 1);
+    t_meleeMultiplier = 1.0f;
+    return true;
+}
+
+static void ZeldaDodge(Player* player, float angleOffset, float horizontal, float vertical)
+{
+    ZeldaState& state = StateFor(player);
+    uint32 now = WorldTimer::getMSTime();
+    if (now < state.dodgeReadyAt)
+        return;
+    state.dodgeReadyAt = now + DODGE_COOLDOWN_MS;
+    state.invulnerableUntil = now + DODGE_INVULN_MS;
+
+    // KnockBackWithAngle pushes away from the angle given, so aim it opposite to where we want to go.
+    float angle = player->GetOrientation() + angleOffset + M_PI_F;
+    player->KnockBackWithAngle(angle, horizontal, vertical);
+}
+
+bool ChatHandler::HandleZeldaRollCommand(char* args)
+{
+    Player* player = m_session->GetPlayer();
+    if (!CanAct(player) || player->IsInWater())
+        return true;
+
+    // optional direction: f (forward, default), l (left), r (right), b (back)
+    float offset = 0.0f;
+    if (args && *args)
+    {
+        switch (args[0])
+        {
+            case 'l': case 'L': offset = M_PI_F / 2.0f; break;
+            case 'r': case 'R': offset = -M_PI_F / 2.0f; break;
+            case 'b': case 'B': offset = M_PI_F; break;
+            default: break;
+        }
+    }
+    ZeldaDodge(player, offset, 11.0f, 2.5f);
+    return true;
+}
+
+bool ChatHandler::HandleZeldaFlipCommand(char* /*args*/)
+{
+    Player* player = m_session->GetPlayer();
+    if (!CanAct(player) || player->IsInWater())
+        return true;
+    ZeldaDodge(player, M_PI_F, 8.0f, 7.0f);
+    return true;
+}
+
+bool ChatHandler::HandleZeldaShieldCommand(char* args)
+{
+    Player* player = m_session->GetPlayer();
+    ZeldaState& state = StateFor(player);
+
+    bool on = !state.shield;
+    if (args && *args)
+    {
+        std::string a = args;
+        if (a == "on" || a == "1")
+            on = true;
+        else if (a == "off" || a == "0")
+            on = false;
+    }
+    if (on && !CanAct(player))
+        on = false;
+    if (on && !player->GetShield(true))
+    {
+        Style style = StyleOf(player);
+        if (style == Style::TwoHanded)
+            SendSysMessage("You can't raise a shield while wielding a two-handed weapon - swing it instead!");
+        else
+            PSendSysMessage("You need a shield equipped in your off hand to block (you have %s).", StyleName(style));
+        on = false;
+    }
+    if (on == state.shield)
+        return true;
+
+    state.shield = on;
+    player->SetSpeedRate(MOVE_RUN, on ? 0.45f : 1.0f, true);
+    if (on)
+        player->HandleEmoteCommand(EMOTE_ONESHOT_PARRYSHIELD);
+    return true;
+}
+
+bool ChatHandler::HandleZeldaHookCommand(char* /*args*/)
+{
+    Player* player = m_session->GetPlayer();
+    if (!CanAct(player))
+        return true;
+
+    ZeldaState& state = StateFor(player);
+    uint32 now = WorldTimer::getMSTime();
+    if (now < state.hookReadyAt)
+    {
+        SendSysMessage("The hookshot is still retracting.");
+        return true;
+    }
+
+    Unit* target = ObjectAccessor::GetUnit(*player, player->GetSelectionGuid());
+    if (!target || target == player || !player->IsWithinDistInMap(target, HOOK_RANGE) || !player->IsWithinLOSInMap(target))
+    {
+        SendSysMessage("Hookshot: select something within 30 yards that you can see.");
+        return true;
+    }
+    state.hookReadyAt = now + HOOK_COOLDOWN_MS;
+
+    // Land just in front of the target, facing it.
+    float angle = target->GetAngle(player);
+    float dist = target->GetCombatReach() + 1.5f;
+    float x = target->GetPositionX() + std::cos(angle) * dist;
+    float y = target->GetPositionY() + std::sin(angle) * dist;
+    float z = target->GetPositionZ();
+    player->UpdateAllowedPositionZ(x, y, z);
+    player->NearTeleportTo(x, y, z, player->GetAngle(target));
+    return true;
+}
+
+bool ChatHandler::HandleZeldaBowCommand(char* /*args*/)
+{
+    Player* player = m_session->GetPlayer();
+    if (!CanAct(player))
+        return true;
+
+    Item* ranged = player->GetWeaponForAttack(RANGED_ATTACK, true, true);
+    if (!ranged)
+    {
+        SendSysMessage("Equip a bow, crossbow, gun, thrown weapon or wand in your ranged slot first.");
+        return true;
+    }
+
+    uint32 spellId = 0;
+    switch (ranged->GetProto()->SubClass)
+    {
+        case ITEM_SUBCLASS_WEAPON_BOW:      spellId = 2480; break; // Shoot Bow
+        case ITEM_SUBCLASS_WEAPON_GUN:      spellId = 7918; break; // Shoot Gun
+        case ITEM_SUBCLASS_WEAPON_CROSSBOW: spellId = 7919; break; // Shoot Crossbow
+        case ITEM_SUBCLASS_WEAPON_THROWN:   spellId = 2764; break; // Throw
+        case ITEM_SUBCLASS_WEAPON_WAND:     spellId = 5019; break; // Shoot (wand)
+        default:
+            SendSysMessage("That ranged item can't be fired.");
+            return true;
+    }
+
+    ZeldaState& state = StateFor(player);
+    uint32 now = WorldTimer::getMSTime();
+    if (now < state.bowReadyAt)
+        return true;
+
+    // The selected enemy if it is in range and in sight; otherwise the enemy closest to where we face.
+    Unit* target = ObjectAccessor::GetUnit(*player, player->GetSelectionGuid());
+    if (target && (!target->IsAlive() || !player->CanAttack(target) || !player->IsWithinDistInMap(target, BOW_RANGE) ||
+                   !player->IsWithinLOSInMap(target)))
+        target = nullptr;
+    if (!target)
+    {
+        std::list<Unit*> enemies;
+        CollectEnemies(player, BOW_RANGE, enemies);
+        float best = M_PI_F / 3.0f; // within 60 degrees of straight ahead
+        for (Unit* unit : enemies)
+        {
+            float off = std::fabs(MapManager::NormalizeOrientation(player->GetAngle(unit) - player->GetOrientation()));
+            if (off > M_PI_F)
+                off = 2.0f * M_PI_F - off;
+            if (off < best)
+            {
+                best = off;
+                target = unit;
+            }
+        }
+    }
+    if (!target)
+    {
+        SendSysMessage("No enemy in your sights.");
+        return true;
+    }
+
+    state.bowReadyAt = now + BOW_COOLDOWN_MS;
+    player->SetFacingToObject(target);
+    // Arrows come from your ammo pouch, like Link's quiver: no ammo, no shot.
+    player->CastSpell(target, spellId, TRIGGERED_INSTANT_CAST | TRIGGERED_IGNORE_GCD | TRIGGERED_IGNORE_COOLDOWNS);
+    return true;
+}
diff --git a/src/game/Chat/ZeldaCommands.h b/src/game/Chat/ZeldaCommands.h
new file mode 100644
index 0000000..adc5fc4
--- /dev/null
+++ b/src/game/Chat/ZeldaCommands.h
@@ -0,0 +1,26 @@
+#ifndef ZELDA_COMMANDS_H
+#define ZELDA_COMMANDS_H
+
+#include "Common.h"
+
+class Player;
+class Unit;
+struct SpellEntry;
+struct ItemPrototype;
+
+// Zelda of Warcraft: damage a player takes after dodge-roll invulnerability and shield blocking.
+uint32 ZeldaModifyIncomingDamage(Player* victim, Unit* attacker, uint32 damage);
+
+// Zelda of Warcraft: the class whose stat formulas weapons scale with. Every hero fights like a
+// warrior (Zelda.WarriorScaling = 1, the default), whatever class the character is.
+uint8 ZeldaStatClass(Player const* player);
+
+// Zelda of Warcraft: potions have no cooldown (Zelda.NoPotionCooldown = 1, the default), so you can
+// drink as many as you carry, like Ocarina's bottles. True when this item use should skip its cooldown.
+bool ZeldaFreePotion(SpellEntry const& spell, ItemPrototype const* item);
+
+// Zelda of Warcraft: extra factor on the melee hit being calculated right now (3 during a Spin
+// Attack, otherwise 1).
+float ZeldaMeleeMultiplier();
+
+#endif
diff --git a/src/game/Entities/CharacterHandler.cpp b/src/game/Entities/CharacterHandler.cpp
index 0656744..40ccbe6 100644
--- a/src/game/Entities/CharacterHandler.cpp
+++ b/src/game/Entities/CharacterHandler.cpp
@@ -17,6 +17,7 @@
  */
 
 #include "Common.h"
+#include "Config/Config.h"
