+
+    std::vector<Rank> const LIGHTNING_BOLT   = { {1, 403}, {8, 529}, {14, 548}, {20, 915}, {26, 943}, {32, 6041}, {38, 10391}, {44, 10392}, {50, 15207}, {56, 15208} };
