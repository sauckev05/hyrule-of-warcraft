+// Linken's Boomerang, the hero's boomerang: thrown at the enemy, it hits as hard as the weapon in
+// hand and either stuns (Knockdown) or disarms the enemy, 50/50, then flies back. 5 s per throw.
+bool ChatHandler::HandleZeldaBoomerangCommand(char* /*args*/)
+{
+    Player* player = m_session->GetPlayer();
+    if (!CanAct(player))
+        return true;
+
+    ZeldaState& state = StateFor(player);
+    uint32 now = WorldTimer::getMSTime();
+    if (now < state.boomerangReadyAt)
+    {
+        player->GetSession()->SendNotification("The boomerang is not back yet (%u s)", (state.boomerangReadyAt - now + 999) / 1000);
+        return true;
+    }
+
+    Unit* target = ZeldaAimTarget(player, BOOMERANG_RANGE);
+    if (!target)
+    {
+        player->GetSession()->SendNotification("No enemy in range for the boomerang");
+        return true;
+    }
+
+    state.boomerangReadyAt = now + BOOMERANG_COOLDOWN_MS;
+    player->SetFacingToObject(target);
+    player->CastSpell(target, BOOMERANG_SPELL, TRIGGERED_INSTANT_CAST | TRIGGERED_IGNORE_GCD | TRIGGERED_IGNORE_COOLDOWNS);
+    return true;
+}
