+float ZeldaEnemyMeleeMultiplier(Unit const* attacker, Unit const* victim)
+{
+    // normal (not elite) enemies' melee and ranged attacks - not spells or effects - hit heroes
+    // harder (Zelda.EnemyMeleeDamageRate, 3); elites, rare elites and bosses hit as before
+    static float const rate = std::max(0.0f, sConfig.GetFloatDefault("Zelda.EnemyMeleeDamageRate", 4.0f));
+    if (!attacker || !victim || attacker->GetTypeId() != TYPEID_UNIT || attacker->IsPlayerControlled())
+        return 1.0f;
+    // world elites, rare elites and bosses hit harder too (Zelda.EliteMeleeDamageRate, 1.75); inside
+    // dungeons and raids SoloCraft sets their strength instead
+    static float const eliteRate = std::max(0.0f, sConfig.GetFloatDefault("Zelda.EliteMeleeDamageRate", 1.75f));
+    if (victim->GetTypeId() != TYPEID_PLAYER && !victim->IsPlayerControlled())
+        return 1.0f;
+    uint32 const rank = static_cast<Creature const*>(attacker)->GetCreatureInfo()->Rank;
+    if (rank != CREATURE_ELITE_NORMAL && rank != CREATURE_ELITE_RARE)
+        return attacker->GetMap()->IsDungeon() ? 1.0f : eliteRate;
+    return rate;
+}
