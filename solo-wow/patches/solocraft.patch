+bool ZeldaExecuteBlocked(Unit const* caster, SpellEntry const* spell, Unit const* target)
+{
+    // Execute (every rank): the client lets it be pressed at any time (patch-Z.MPQ clears its
+    // target aura state), so the server keeps the rule - the target must be under 20% health -
+    // except when the warrior's rage is full (Zelda.FullRageExecute = 1).
+    if (spell->SpellFamilyName != SPELLFAMILY_WARRIOR || !spell->IsFitToFamilyMask(uint64(0x20000000)))
+        return false;
+    if (spell->TargetAuraState != AURA_STATE_HEALTHLESS_20_PERCENT || !caster || !target)
+        return false;
+    if (target->HasAuraState(AURA_STATE_HEALTHLESS_20_PERCENT))
+        return false;
+    static bool const fullRage = sConfig.GetBoolDefault("Zelda.FullRageExecute", true);
+    if (fullRage && caster->GetPowerType() == POWER_RAGE && caster->GetPower(POWER_RAGE) >= caster->GetMaxPower(POWER_RAGE))
+        return false;
+    return true;
+}
