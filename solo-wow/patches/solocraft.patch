+void ZeldaFollowerSet(Player* player, uint32 index, uint32 entry, ObjectGuid guid)
+{
+    if (!player || index >= COMPANION_COUNT)
+        return;
+    ZeldaState& state = StateFor(player);
+    // a girl only travels with you once: the copy already at your side goes
+    if (state.followerGuid[index] && state.followerGuid[index] != guid)
+        if (Creature* old = player->GetMap()->GetCreature(state.followerGuid[index]))
+            old->ForcedDespawn();
