+    std::vector<Rank> const SW_PAIN    = { {4, 589}, {10, 594}, {18, 970}, {26, 992}, {34, 2767}, {42, 10892}, {50, 10893}, {58, 10894} };
+    std::vector<Rank> const SMALL_HEAL = { {1, 2050}, {4, 2052}, {10, 2053}, {16, 2054}, {22, 2055}, {28, 6063}, {34, 6064} };
+    std::vector<Rank> const FLASH_HEAL = { {20, 2061}, {26, 9472}, {32, 9473}, {38, 9474}, {44, 10915}, {50, 10916}, {56, 10917} };
+    std::vector<Rank> const RENEW      = { {8, 139}, {14, 6074}, {20, 6075}, {26, 6076}, {32, 6077}, {38, 6078}, {44, 10927}, {50, 10928}, {56, 10929} };
+    std::vector<Rank> const PW_SHIELD  = { {6, 17}, {12, 592}, {18, 600}, {24, 3747}, {30, 6065}, {36, 6066}, {42, 10898}, {48, 10899}, {54, 10900}, {60, 10901} };
+    std::vector<Rank> const FORTITUDE  = { {1, 1243}, {12, 1244}, {24, 1245}, {36, 2791}, {48, 10937}, {60, 10938} };
+    uint32 const WEAKENED_SOUL = 6788;
+
+    uint32 const SHOOT = 6660;
+    std::vector<Rank> const ARCANE_SHOT    = { {6, 3044}, {12, 14281}, {20, 14282}, {28, 14283}, {36, 14284}, {44, 14285}, {52, 14286}, {60, 14287} };
