+/*
+ * Zelda of Warcraft: Ocarina of Time style combat moves for players, driven by chat commands that
+ * the client sends from key bindings (any 1.12 client + the ZeldaControls addon, or Benilla).
+ *
+ *   .zslash     sword slash: hits every enemy in a cone in front of you; every 3rd quick slash is a finisher
+ *   .zspin      spin attack: hits every enemy around you twice (after holding the attack key)
+ *   .zroll      dodge roll forward with a short moment of invulnerability
+ *   .zflip      backflip away with a short moment of invulnerability
+ *   .zshield    toggles the shield: heavy damage reduction from the front, slower movement
+ *   .zhook      hookshot: pulls you to your target
+ *   .zbow       fire your bow, crossbow, gun, thrown weapon or wand at the target (or the enemy you face)
+ *
+ * Your WoW weapons decide your fighting style, as Link's sword and shield or the Biggoron's Sword:
+ *   one-handed weapon + shield   quick slashes, and the shield can block
+ *   two-handed weapon            slower, wider and longer slashes and a bigger spin, but no shield
+ *   two weapons (dual wield)     every slash strikes with both hands, no shield
+ */
+
+#include "Common.h"
+#include "Chat/Chat.h"
+#include "Chat/ZeldaCommands.h"
+#include "Entities/Player.h"
+#include "Entities/Unit.h"
+#include "Grids/GridNotifiers.h"
+#include "Grids/GridNotifiersImpl.h"
+#include "Grids/CellImpl.h"
+#include "Util/Timer.h"
+#include "Entities/Item.h"
+#include "Entities/ItemPrototype.h"
+#include "Globals/ObjectAccessor.h"
+#include "Config/Config.h"
+#include "Maps/MapManager.h"
+#include "Server/WorldPacket.h"
+#include "Server/Opcodes.h"
+#include "Loot/LootMgr.h"
+#include "Spells/SpellAuras.h"
+#include "Entities/GameObject.h"
+#include "Server/DBCStores.h"
+#include "Server/SQLStorages.h"
+#include <array>
+#include <cctype>
+#include <string>
+
+#include <algorithm>
+#include <cmath>
+#include <vector>
+#include <mutex>
+#include <unordered_map>
+
+namespace
+{
+    struct ZeldaState
+    {
+        uint32 lastSlash = 0;
+        uint32 comboCount = 0;
+        uint32 spinReadyAt = 0;
+        uint32 dodgeReadyAt = 0;
+        uint32 invulnerableUntil = 0;
+        uint32 boomerangReadyAt = 0;
+        uint32 bowReadyAt = 0;
+        bool shield = false;
+        uint32 shoutCheckIn = 0;
+    };
+
+    // Commands run on the session's thread and damage on map threads, so the table is locked.
+    std::unordered_map<uint32, ZeldaState> s_states;
+    std::mutex s_statesLock;
+
+    ZeldaState& StateFor(Player* player)
+    {
+        std::lock_guard<std::mutex> guard(s_statesLock);
+        return s_states[player->GetGUIDLow()]; // references stay valid: unordered_map never moves nodes
+    }
+
+    const uint32 COMBO_WINDOW_MS = 1100;
+    const uint32 SPIN_COOLDOWN_MS = 2500;
+    const uint32 SPIN_RAGE_COST = 50 * 10;        // 50 rage (stored x10)
+    const float SPIN_DAMAGE_MULTIPLIER = 3.0f;    // a spin hit is three normal swings
+    const uint32 SPIN_STRIKES = 2;                // and every enemy in reach is hit twice
+
+    // Set while the spin attack's swings resolve; CalculateMeleeDamage reads it on the same thread.
+    thread_local float t_meleeMultiplier = 1.0f;
+    const uint32 DODGE_COOLDOWN_MS = 900;
+    const uint32 DODGE_INVULN_MS = 450;
+    const uint32 BOOMERANG_COOLDOWN_MS = 5000;
+    const float BOOMERANG_RANGE = 30.0f;
+    const uint32 BOOMERANG_SPELL = 15712;          // Linken's Boomerang: throw, flight and return visuals
+    const float BOW_RANGE = 35.0f;
+    const uint32 BOW_COOLDOWN_MS = 1100;
+
+    enum class Style { OneHanded, TwoHanded, DualWield, Unarmed };
+
+    struct StyleStats
+    {
+        float slashRange;
+        float slashArc;
+        uint32 slashGapMs;
+        float spinRange;
+        uint32 spinHits;
+    };
+
+    Style StyleOf(Player* player)
+    {
+        Item* main = player->GetWeaponForAttack(BASE_ATTACK, true, true);
+        if (!main)
+            return Style::Unarmed;
+        if (main->GetProto()->InventoryType == INVTYPE_2HWEAPON)
+            return Style::TwoHanded;
+        if (player->GetWeaponForAttack(OFF_ATTACK, true, true))
+            return Style::DualWield;
+        return Style::OneHanded;
+    }
+
+    StyleStats StatsFor(Style style)
+    {
+        switch (style)
+        {
+            case Style::TwoHanded: return { 7.0f, M_PI_F * 5.0f / 6.0f, 650, 9.5f, 3 }; // Biggoron's Sword
+            case Style::DualWield: return { 5.5f, M_PI_F * 2.0f / 3.0f, 420, 7.5f, 2 };
+            case Style::Unarmed:   return { 4.5f, M_PI_F / 2.0f, 380, 6.0f, 1 };
+            default:               return { 5.5f, M_PI_F * 2.0f / 3.0f, 380, 7.5f, 2 }; // Kokiri/Master Sword
+        }
+    }
+
+    const char* StyleName(Style style)
+    {
+        switch (style)
+        {
+            case Style::TwoHanded: return "two-handed weapon";
+            case Style::DualWield: return "two weapons";
+            case Style::Unarmed:   return "no weapon";
+            default:               return "one-handed weapon";
+        }
+    }
+
+    void CollectEnemies(Player* player, float range, std::list<Unit*>& out)
+    {
+        MaNGOS::AnyUnfriendlyUnitInObjectRangeCheck check(player, range);
+        MaNGOS::UnitListSearcher<MaNGOS::AnyUnfriendlyUnitInObjectRangeCheck> searcher(out, check);
+        Cell::VisitAllObjects(player, searcher, range);
+
+        for (auto itr = out.begin(); itr != out.end();)
+        {
+            Unit* unit = *itr;
+            if (!unit->IsAlive() || !player->CanAttack(unit) || !player->IsWithinLOSInMap(unit))
+                itr = out.erase(itr);
+            else
+                ++itr;
+        }
+    }
+
+    bool CanAct(Player* player)
+    {
+        return player->IsAlive() && !player->IsTaxiFlying() && !player->IsMounted() &&
+               !player->hasUnitState(UNIT_STAT_CAN_NOT_REACT) && !player->HasFlag(UNIT_FIELD_FLAGS, UNIT_FLAG_PACIFIED);
+    }
+
+    void ZeldaSwing(Player* player, Unit* victim, uint32 hits)
+    {
+        for (uint32 i = 0; i < hits && victim->IsAlive(); ++i)
+            player->AttackerStateUpdate(victim, BASE_ATTACK, true);
+    }
+
+    // Warrior Whirlwind (rank 1). Its cast animation is the spin attack's look.
+    const uint32 WHIRLWIND_SPELL = 1680;
+
+    // Plays Whirlwind's spinning animation, swoosh and sound on the hero for every client nearby,
+    // without casting the spell: an SMSG_SPELL_GO with no effects, listing the enemies the spin hit
+    // so they show Whirlwind's impact too. The damage itself still comes from ZeldaSwing.
+    void PlaySpellVisual(Player* player, uint32 spellId, std::vector<ObjectGuid> const& hits)
+    {
+        uint8 const count = uint8(std::min<size_t>(hits.size(), 255));
+        WorldPacket data(SMSG_SPELL_GO, 32 + count * 8);
+        data << player->GetPackGUID();                 // caster (no item)
+        data << player->GetPackGUID();                 // caster unit
+        data << uint32(spellId);
+        data << uint16(0x0100 | 0x0001);               // CAST_FLAG_UNKNOWN9 | CAST_FLAG_HIDDEN_COMBATLOG
+        data << count;                                 // hit targets
+        for (uint8 i = 0; i < count; ++i)
+            data << hits[i];
+        data << uint8(0);                              // missed targets
+        data << uint16(0);                             // TARGET_FLAG_SELF
+        player->SendMessageToSet(data, true);
+
+        // the hero's own client starts the spell's cooldown and global cooldown when the GO
+        // arrives - clear them, so the visual never locks the action bar
+        player->SendClearCooldown(spellId, player);
+    }
+
+    void PlayWhirlwind(Player* player, std::vector<ObjectGuid> const& hits)
+    {
+        PlaySpellVisual(player, WHIRLWIND_SPELL, hits);
+    }
+
+    // Heroic Strike (rank 1): its cast kit latches the red weapon trail onto the hero's next swing.
+    const uint32 RED_TRAIL_SPELL = 78;
+}
+
+void ZeldaSwingTrail(Player* player, Unit* victim)
+{
+    static bool const redTrail = sConfig.GetBoolDefault("Zelda.RedSwingTrail", true);
+    if (!redTrail || !player || !victim || t_meleeMultiplier > 1.0f)   // the spin plays Whirlwind instead
+        return;
+    std::vector<ObjectGuid> hits;
+    hits.push_back(victim->GetObjectGuid());
+    PlaySpellVisual(player, RED_TRAIL_SPELL, hits);
+}
+
+void ZeldaPlayerUpdate(Player* player, uint32 diff)
+{
+    static bool const passiveShout = sConfig.GetBoolDefault("Zelda.PassiveBattleShout", true);
+    if (!passiveShout || !player)
+        return;
+
+    ZeldaState& state = StateFor(player);
+    if (state.shoutCheckIn > diff)
+    {
+        state.shoutCheckIn -= diff;
+        return;
+    }
+    state.shoutCheckIn = 2000;
+
+    if (!player->IsAlive() || player->IsTaxiFlying() || player->IsBeingTeleported())
+        return;
+
+    // the best Battle Shout the hero has learned, highest rank first
+    static uint32 const ranks[] = { 25289, 11551, 11550, 11549, 6192, 5242, 6673 };
+    uint32 shout = 0;
+    for (uint32 id : ranks)
+    {
+        if (player->HasSpell(id))
+        {
+            shout = id;
+            break;
+        }
+    }
+    if (!shout)
+        return;
+
+    SpellAuraHolder* holder = player->GetSpellAuraHolder(shout, player->GetObjectGuid());
+    if (!holder)
+    {
+        player->CastSpell(player, shout, TRIGGERED_OLD_TRIGGERED | TRIGGERED_IGNORE_COSTS | TRIGGERED_IGNORE_GCD | TRIGGERED_IGNORE_COOLDOWNS);
+        holder = player->GetSpellAuraHolder(shout, player->GetObjectGuid());
+    }
+    // it never runs out: a passive, not a 2 minute buff
+    if (holder && holder->GetAuraMaxDuration() != -1)
+    {
+        holder->SetAuraMaxDuration(-1);
+        holder->SetAuraDuration(-1);
+        holder->UpdateAuraDuration();
+    }
+}
+
+uint32 ZeldaFishingSkillGain()
+{
+    static uint32 const gain = uint32(std::max(0, sConfig.GetIntDefault("Zelda.FishingSkillGain", 10)));
+    return gain;
+}
+
+float ZeldaMeleeMultiplier()
+{
+    return t_meleeMultiplier;
+}
+
+uint8 ZeldaStatClass(Player const* player)
+{
+    static bool const warriorScaling = sConfig.GetBoolDefault("Zelda.WarriorScaling", true);
+    return warriorScaling ? uint8(CLASS_WARRIOR) : player->getClass();
+}
+
+bool ZeldaFreePotion(SpellEntry const& spell, ItemPrototype const* item)
+{
+    static bool const noPotionCooldown = sConfig.GetBoolDefault("Zelda.NoPotionCooldown", true);
+    if (!noPotionCooldown || !item || item->Class != ITEM_CLASS_CONSUMABLE)
+        return false;
+
+    uint32 category = spell.Category;
+    for (auto const& itemSpell : item->Spells)
+        if (itemSpell.SpellId == spell.Id && itemSpell.SpellCategory)
+            category = itemSpell.SpellCategory;
+    return category == 4; // SPELLCATEGORY_HEALTH_MANA_POTIONS: healing, mana and rejuvenation potions
+}
+
+uint32 ZeldaModifyIncomingDamage(Player* victim, Unit* attacker, uint32 damage)
+{
+    if (!victim || damage == 0)
+        return damage;
+
+    ZeldaState state;
+    {
+        std::lock_guard<std::mutex> guard(s_statesLock);
+        auto itr = s_states.find(victim->GetGUIDLow());
+        if (itr == s_states.end())
+            return damage;
+        state = itr->second;
+    }
+    if (WorldTimer::getMSTime() < state.invulnerableUntil)
+        return 0; // rolled through it
+
+    if (state.shield && attacker && attacker != victim && victim->HasInArc(attacker, M_PI_F * 2.0f / 3.0f))
+        return damage / 5; // blocked with the shield: 80% less
+
+    return damage;
+}
+
+bool ChatHandler::HandleZeldaSlashCommand(char* /*args*/)
+{
+    Player* player = m_session->GetPlayer();
+    if (!CanAct(player))
+        return true;
+
+    ZeldaState& state = StateFor(player);
+    Style style = StyleOf(player);
+    StyleStats stats = StatsFor(style);
+    uint32 now = WorldTimer::getMSTime();
+    if (now - state.lastSlash < stats.slashGapMs)
+        return true;
+
+    state.comboCount = (now - state.lastSlash <= COMBO_WINDOW_MS) ? state.comboCount + 1 : 1;
+    state.lastSlash = now;
+    bool finisher = state.comboCount >= 3;
+    if (finisher)
+        state.comboCount = 0;
+
+    std::list<Unit*> enemies;
+    CollectEnemies(player, stats.slashRange + 2.0f, enemies);
+
+    // Prefer the selected target if it is in reach, then everything else in the cone in front of us.
+    Unit* selected = ObjectAccessor::GetUnit(*player, player->GetSelectionGuid());
+    uint32 hit = 0;
+    for (Unit* unit : enemies)
+    {
+        bool inReach = player->IsWithinDistInMap(unit, stats.slashRange + unit->GetCombatReach());
+        bool inFront = player->HasInArc(unit, stats.slashArc) || unit == selected;
+        if (!inReach || !inFront)
+            continue;
+        ZeldaSwing(player, unit, finisher ? 2 : 1);
+        if (style == Style::DualWield && unit->IsAlive())
+            player->AttackerStateUpdate(unit, OFF_ATTACK, true);
+        ++hit;
+    }
+
+    if (hit == 0)
+        player->HandleEmoteCommand(EMOTE_ONESHOT_ATTACK1H); // swing at the air
+    return true;
+}
+
+bool ChatHandler::HandleZeldaSpinCommand(char* /*args*/)
+{
+    Player* player = m_session->GetPlayer();
+    if (!CanAct(player))
+        return true;
+
+    ZeldaState& state = StateFor(player);
+    uint32 now = WorldTimer::getMSTime();
+    if (now < state.spinReadyAt)
+        return true;
+
+    // The spin costs 50 rage; without it there is no spin.
+    bool const usesRage = player->GetPowerType() == POWER_RAGE;
+    if (usesRage && player->GetPower(POWER_RAGE) < SPIN_RAGE_COST)
+    {
+        player->GetSession()->SendNotification("Not enough rage for a Spin Attack (50 needed)");
+        return true;
+    }
+    if (usesRage)
+        player->ModifyPower(POWER_RAGE, -int32(SPIN_RAGE_COST));
+
+    state.spinReadyAt = now + SPIN_COOLDOWN_MS;
+    state.comboCount = 0;
+
+    StyleStats stats = StatsFor(StyleOf(player));
+    std::list<Unit*> enemies;
+    CollectEnemies(player, stats.spinRange + 2.0f, enemies);
+    std::vector<Unit*> victims;
+    std::vector<ObjectGuid> hitGuids;
+    for (Unit* unit : enemies)
+    {
+        if (player->IsWithinDistInMap(unit, stats.spinRange + unit->GetCombatReach()))
+        {
+            victims.push_back(unit);
+            hitGuids.push_back(unit->GetObjectGuid());
+        }
+    }
+    // the Whirlwind spin goes out first so the hits land while the hero is turning
+    PlayWhirlwind(player, hitGuids);
+    // two strikes per enemy, each worth three normal swings
+    t_meleeMultiplier = SPIN_DAMAGE_MULTIPLIER;
+    for (Unit* unit : victims)
+        ZeldaSwing(player, unit, SPIN_STRIKES);
+    t_meleeMultiplier = 1.0f;
+    return true;
+}
+
+static void ZeldaDodge(Player* player, float angleOffset, float horizontal, float vertical)
+{
+    ZeldaState& state = StateFor(player);
+    uint32 now = WorldTimer::getMSTime();
+    if (now < state.dodgeReadyAt)
+        return;
+    state.dodgeReadyAt = now + DODGE_COOLDOWN_MS;
+    state.invulnerableUntil = now + DODGE_INVULN_MS;
+
+    // KnockBackWithAngle launches the hero along the angle given (0 = straight ahead, pi/2 = left).
+    float angle = MapManager::NormalizeOrientation(player->GetOrientation() + angleOffset);
+    player->KnockBackWithAngle(angle, horizontal, vertical);
+}
+
+bool ChatHandler::HandleZeldaRollCommand(char* args)
+{
+    Player* player = m_session->GetPlayer();
+    if (!CanAct(player) || player->IsInWater())
+        return true;
+
+    // optional direction: f (forward, default), l (left), r (right), b (back)
+    float offset = 0.0f;
+    if (args && *args)
+    {
+        switch (args[0])
+        {
+            case 'l': case 'L': offset = M_PI_F / 2.0f; break;
+            case 'r': case 'R': offset = -M_PI_F / 2.0f; break;
+            case 'b': case 'B': offset = M_PI_F; break;
+            default: break;
+        }
+    }
+    // the forward roll covers about 9 yards (20 yd/s for ~0.47 s in the air); the side rolls are
+    // short hops of about 3 yards
+    if (offset == 0.0f)
+        ZeldaDodge(player, offset, 20.0f, 4.5f);
+    else
+        ZeldaDodge(player, offset, 11.0f, 2.5f);
+    return true;
+}
+
+bool ChatHandler::HandleZeldaFlipCommand(char* /*args*/)
+{
+    Player* player = m_session->GetPlayer();
+    if (!CanAct(player) || player->IsInWater())
+        return true;
+    ZeldaDodge(player, M_PI_F, 8.0f, 7.0f);
+    return true;
+}
+
+bool ChatHandler::HandleZeldaShieldCommand(char* args)
+{
+    Player* player = m_session->GetPlayer();
+    ZeldaState& state = StateFor(player);
+
+    bool on = !state.shield;
+    if (args && *args)
+    {
+        std::string a = args;
+        if (a == "on" || a == "1")
+            on = true;
+        else if (a == "off" || a == "0")
+            on = false;
+    }
+    if (on && !CanAct(player))
+        on = false;
+    if (on && !player->GetShield(true))
+    {
+        Style style = StyleOf(player);
+        if (style == Style::TwoHanded)
+            SendSysMessage("You can't raise a shield while wielding a two-handed weapon - swing it instead!");
+        else
+            PSendSysMessage("You need a shield equipped in your off hand to block (you have %s).", StyleName(style));
+        on = false;
+    }
+    if (on == state.shield)
+        return true;
+
+    state.shield = on;
+    player->SetSpeedRate(MOVE_RUN, on ? 0.45f : 1.0f, true);
+    if (on)
+        player->HandleEmoteCommand(EMOTE_ONESHOT_PARRYSHIELD);
+    return true;
+}
+
+// The selected enemy if it is alive, in range and in sight; otherwise the enemy closest to where the
+// hero faces, within 60 degrees.
+static Unit* ZeldaAimTarget(Player* player, float range)
+{
+    Unit* target = ObjectAccessor::GetUnit(*player, player->GetSelectionGuid());
+    if (target && (target == player || !target->IsAlive() || !player->CanAttack(target) ||
+                   !player->IsWithinDistInMap(target, range) || !player->IsWithinLOSInMap(target)))
+        target = nullptr;
+    if (target)
+        return target;
+
+    std::list<Unit*> enemies;
+    CollectEnemies(player, range, enemies);
+    float best = M_PI_F / 3.0f;
+    for (Unit* unit : enemies)
+    {
+        float off = std::fabs(MapManager::NormalizeOrientation(player->GetAngle(unit) - player->GetOrientation()));
+        if (off > M_PI_F)
+            off = 2.0f * M_PI_F - off;
+        if (off < best)
+        {
+            best = off;
+            target = unit;
+        }
+    }
+    return target;
+}
+
+// Linken's Boomerang, the hero's boomerang: thrown at the enemy, it hits as hard as the weapon in
+// hand and either stuns (Knockdown) or disarms the enemy, 50/50, then flies back. 5 s per throw.
+bool ChatHandler::HandleZeldaBoomerangCommand(char* /*args*/)
+{
+    Player* player = m_session->GetPlayer();
+    if (!CanAct(player))
+        return true;
+
+    ZeldaState& state = StateFor(player);
+    uint32 now = WorldTimer::getMSTime();
+    if (now < state.boomerangReadyAt)
+    {
+        player->GetSession()->SendNotification("The boomerang is not back yet (%u s)", (state.boomerangReadyAt - now + 999) / 1000);
+        return true;
+    }
+
+    Unit* target = ZeldaAimTarget(player, BOOMERANG_RANGE);
+    if (!target)
+    {
+        player->GetSession()->SendNotification("No enemy in range for the boomerang");
+        return true;
+    }
+
+    state.boomerangReadyAt = now + BOOMERANG_COOLDOWN_MS;
+    player->SetFacingToObject(target);
+    player->CastSpell(target, BOOMERANG_SPELL, TRIGGERED_INSTANT_CAST | TRIGGERED_IGNORE_GCD | TRIGGERED_IGNORE_COOLDOWNS);
+    return true;
+}
+
+// .zhook is the boomerang now (the old hookshot key)
+bool ChatHandler::HandleZeldaHookCommand(char* args)
+{
+    return HandleZeldaBoomerangCommand(args);
+}
+
+uint32 ZeldaPackedGameTime(time_t now, float& speed)
+{
+    static float const dayMinutes = sConfig.GetFloatDefault("Zelda.DayLengthMinutes", 60.0f);
+    if (dayMinutes <= 0.0f || dayMinutes >= 1440.0f)
+    {
+        speed = 1.0f / 60.0f;                       // real time
+        return secsToTimeBitFields(now);
+    }
+    float const factor = 1440.0f / dayMinutes;      // game seconds per real second
+    time_t const anchor = 1767225600;               // 2026-01-01: keeps the packed year small
+    double const elapsed = double(now > anchor ? now - anchor : 0);
+    time_t const gameNow = anchor + time_t(elapsed * factor);
+    speed = factor / 60.0f;
+    return secsToTimeBitFields(gameNow);
+}
+
+uint32 ZeldaItemSheath(ItemPrototype const* proto)
+{
+    static bool const oneHandOnBack = sConfig.GetBoolDefault("Zelda.OneHandOnBack", true);
+    // one-handed maces stay at the hip: on the back they clash with the shield
+    if (oneHandOnBack && proto->Class == ITEM_CLASS_WEAPON && proto->Sheath == 3 &&
+        proto->SubClass != ITEM_SUBCLASS_WEAPON_MACE &&
+        (proto->InventoryType == INVTYPE_WEAPON || proto->InventoryType == INVTYPE_WEAPONMAINHAND ||
+         proto->InventoryType == INVTYPE_WEAPONOFFHAND))
+        return 1; // on the back, drawn over the shoulder
+    return proto->Sheath;
+}
+
+namespace
+{
+    // Bind on Equip weapons and armor by quality (green, blue, purple) and required level 1..60.
+    struct BoePools
+    {
+        std::array<std::array<std::vector<uint32>, 61>, 3> byQuality;
+    };
+
+    bool StartsWith(std::string const& s, char const* prefix)
+    {
+        return s.compare(0, std::char_traits<char>::length(prefix), prefix) == 0;
+    }
+
+    BoePools BuildBoePools()
+    {
+        BoePools pools;
+        for (uint32 id = 0; id < sItemStorage.GetMaxEntry(); ++id)
+        {
+            ItemPrototype const* proto = sItemStorage.LookupEntry<ItemPrototype>(id);
+            if (!proto || proto->Bonding != BIND_WHEN_EQUIPPED)
+                continue;
+            if (proto->Class != ITEM_CLASS_WEAPON && proto->Class != ITEM_CLASS_ARMOR)
+                continue;
+            if (proto->InventoryType == INVTYPE_NON_EQUIP || proto->InventoryType == INVTYPE_BODY || proto->InventoryType == INVTYPE_TABARD)
+                continue;
+            if (proto->Quality < ITEM_QUALITY_UNCOMMON || proto->Quality > ITEM_QUALITY_EPIC)
+                continue;
+            if (proto->RequiredLevel < 1 || proto->RequiredLevel > 60)
+                continue;
+            std::string const name = proto->Name1 ? proto->Name1 : "";
+            if (name.empty() || StartsWith(name, "Deprecated") || StartsWith(name, "Test") || StartsWith(name, "TEST") ||
+                StartsWith(name, "Monster") || StartsWith(name, "[PH]") || StartsWith(name, "OLD") || StartsWith(name, "QA") ||
+                name.find("Test ") != std::string::npos || name.find("(test)") != std::string::npos)
+                continue;
+            pools.byQuality[proto->Quality - ITEM_QUALITY_UNCOMMON][proto->RequiredLevel].push_back(proto->ItemId);
+        }
+        return pools;
+    }
+
+    // herbs, ore veins and fishing pools are chests to the game; they get nothing extra
+    bool IsGatheringNode(GameObjectInfo const* info)
+    {
+        if (LockEntry const* lock = sLockStore.LookupEntry(info->chest.lockId))
+            for (uint32 i = 0; i < MAX_LOCK_CASE; ++i)
+                if (lock->Type[i] == LOCK_KEY_SKILL &&
+                    (lock->Index[i] == LOCKTYPE_HERBALISM || lock->Index[i] == LOCKTYPE_MINING || lock->Index[i] == LOCKTYPE_FISHING))
+                    return true;
+        return false;
+    }
+
+    bool LooksLikeTreasure(GameObjectInfo const* info)
+    {
+        std::string name = info->name ? info->name : "";
+        for (char& c : name)
+            c = char(std::tolower(static_cast<unsigned char>(c)));
+        for (char const* word : { "chest", "strongbox", "coffer", "trunk", "footlocker", "lockbox", "treasure" })
+            if (name.find(word) != std::string::npos)
+                return true;
+        return false;
+    }
+
+    uint32 PickBoe(BoePools const& pools, uint32 quality, int32 level)
+    {
+        std::vector<uint32> const* lists[12];
+        uint32 count = 0;
+        uint32 total = 0;
+        // first the five levels up to the zone's, then a wider band
+        for (int32 spread : { 4, 8 })
+        {
+            count = 0;
+            total = 0;
+            for (int32 l = std::max(1, level - spread); l <= std::min(60, level + (spread > 4 ? 2 : 0)); ++l)
+            {
+                auto const& list = pools.byQuality[quality][l];
+                if (!list.empty() && count < 12)
+                {
+                    lists[count++] = &list;
+                    total += uint32(list.size());
+                }
+            }
+            if (total)
+                break;
+        }
+        if (!total)
+            return 0;
+        uint32 pick = urand(0, total - 1);
+        for (uint32 i = 0; i < count; ++i)
+        {
+            if (pick < lists[i]->size())
+                return (*lists[i])[pick];
+            pick -= uint32(lists[i]->size());
+        }
+        return 0;
+    }
+}
+
+void ZeldaChestBonus(Loot* loot, GameObject* chest, Player* opener)
+{
+    static int32 const chance = sConfig.GetIntDefault("Zelda.ChestBoEChance", 50);
+    if (!loot || !chest || !opener || chance <= 0)
+        return;
+    GameObjectInfo const* info = chest->GetGOInfo();
+    if (!info || info->type != GAMEOBJECT_TYPE_CHEST || IsGatheringNode(info) || !LooksLikeTreasure(info))
+        return;
+    if (!roll_chance_i(chance))
+        return;
+
+    // the zone's level: the area's exploration level, else its zone's, else the hero's own
+    uint32 zoneId = 0, areaId = 0;
+    chest->GetZoneAndAreaId(zoneId, areaId);
+    int32 level = 0;
+    if (AreaTableEntry const* area = GetAreaEntryByAreaID(areaId))
+        level = area->area_level;
+    if (level <= 0)
+        if (AreaTableEntry const* zone = GetAreaEntryByAreaID(zoneId))
+            level = zone->area_level;
+    if (level <= 0)
+        level = int32(opener->GetLevel());
+    level = std::min(60, std::max(1, level));
+
+    static BoePools const pools = BuildBoePools();
+    uint32 const roll = urand(1, 100);
+    uint32 quality = roll <= 2 ? 2u : (roll <= 17 ? 1u : 0u); // 2% purple, 15% blue, else green
+    uint32 itemId = 0;
+    for (int32 q = int32(quality); q >= 0 && !itemId; --q)
+        itemId = PickBoe(pools, uint32(q), level);
+    if (itemId)
+        loot->AddItem(LootStoreItem(0, itemId, 100.0f, 0, 0, 1, 1));
+}
+
+void ZeldaAutoLoot(Player* looter, Loot* loot)
+{
+    static bool const autoLoot = sConfig.GetBoolDefault("Zelda.AutoLoot", true);
+    if (!autoLoot || !looter || !loot || !looter->IsInWorld() || !looter->GetSession() || looter->GetGroup())
+        return;
+
+    loot->AutoStore(looter);
+
+    uint32 const gold = loot->GetGoldAmount();
+    if (gold)
+    {
+        ChatHandler(looter).PSendSysMessage("|cffffff00You loot %ug %us %uc.|r", gold / 10000, (gold % 10000) / 100, gold % 100);
+        loot->SendGold(looter);               // releases the corpse when it is now empty
+    }
+    else if (loot->IsLootedFor(looter))
+        loot->Release(looter);                // empty: stop the sparkle, allow skinning
+}
+
+uint32 ZeldaBoomerangDamage(Player* player)
+{
+    // one roll of the main-hand weapon, as a normal swing would deal before armor
+    return player->CalculateDamage(BASE_ATTACK, false, 0);
+}
+
+bool ZeldaBoomerangTrigger(Player* player, Unit* target, uint8 effIndex)
+{
+    if (effIndex == 1 && target && target->IsAlive())
+        player->CastSpell(target, roll_chance_i(50) ? 15753u : 15752u, TRIGGERED_OLD_TRIGGERED); // Knockdown : Disarm
+    return true; // the DBC's own triggers (both at 101%) are replaced by the 50/50 above
+}
+
+bool ChatHandler::HandleZeldaBowCommand(char* /*args*/)
+{
+    Player* player = m_session->GetPlayer();
+    if (!CanAct(player))
+        return true;
+
+    Item* ranged = player->GetWeaponForAttack(RANGED_ATTACK, true, true);
+    if (!ranged)
+    {
+        SendSysMessage("Equip a bow, crossbow, gun, thrown weapon or wand in your ranged slot first.");
+        return true;
+    }
+
+    uint32 spellId = 0;
+    switch (ranged->GetProto()->SubClass)
+    {
+        case ITEM_SUBCLASS_WEAPON_BOW:      spellId = 2480; break; // Shoot Bow
+        case ITEM_SUBCLASS_WEAPON_GUN:      spellId = 7918; break; // Shoot Gun
+        case ITEM_SUBCLASS_WEAPON_CROSSBOW: spellId = 7919; break; // Shoot Crossbow
+        case ITEM_SUBCLASS_WEAPON_THROWN:   spellId = 2764; break; // Throw
+        case ITEM_SUBCLASS_WEAPON_WAND:     spellId = 5019; break; // Shoot (wand)
+        default:
+            SendSysMessage("That ranged item can't be fired.");
+            return true;
+    }
+
+    ZeldaState& state = StateFor(player);
+    uint32 now = WorldTimer::getMSTime();
+    if (now < state.bowReadyAt)
+        return true;
+
+    Unit* target = ZeldaAimTarget(player, BOW_RANGE);
+    if (!target)
+    {
+        SendSysMessage("No enemy in your sights.");
+        return true;
+    }
+
+    state.bowReadyAt = now + BOW_COOLDOWN_MS;
+    player->SetFacingToObject(target);
+    // Arrows come from your ammo pouch, like Link's quiver: no ammo, no shot.
+    player->CastSpell(target, spellId, TRIGGERED_INSTANT_CAST | TRIGGERED_IGNORE_GCD | TRIGGERED_IGNORE_COOLDOWNS);
+    return true;
+}
