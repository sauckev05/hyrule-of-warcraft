+// ---------------------------------------------------------------------------------------------------------------
+// SoloCraft: scale creatures inside dungeons and raids so a single player can clear them, while keeping
+// raids harder than dungeons. Configured in mangosd.conf (SoloCraft.*).
+// ---------------------------------------------------------------------------------------------------------------
+float SoloCraftFactor(Creature const* creature, bool health)
+{
+    static bool loaded = false;
+    static bool enabled = true;
+    static float dungeonHealth = 0.45f, dungeonDamage = 0.55f, raidHealthExp = 0.9f, raidDamageExp = 0.55f;
+    if (!loaded)
+    {
+        loaded = true;
+        enabled = sConfig.GetBoolDefault("SoloCraft.Enable", true);
+        dungeonHealth = sConfig.GetFloatDefault("SoloCraft.DungeonHealth", 0.45f);
+        dungeonDamage = sConfig.GetFloatDefault("SoloCraft.DungeonDamage", 0.55f);
+        raidHealthExp = sConfig.GetFloatDefault("SoloCraft.RaidHealthExponent", 0.9f);
+        raidDamageExp = sConfig.GetFloatDefault("SoloCraft.RaidDamageExponent", 0.55f);
+    }
+    if (!enabled || !creature || creature->IsPet())
+        return 1.0f;
+    // Zelda of Warcraft: the companions and story characters keep their full strength in dungeons
+    if (creature->GetEntry() >= 190000 && creature->GetEntry() < 191000)
+        return 1.0f;
+
+    MapEntry const* mapEntry = sMapStore.LookupEntry(creature->GetMapId());
+    if (!mapEntry || !mapEntry->IsDungeon())
+        return 1.0f;
+
+    InstanceTemplate const* temp = ObjectMgr::GetInstanceTemplate(creature->GetMapId());
+    uint32 maxPlayers = (temp && temp->maxPlayers) ? temp->maxPlayers : (mapEntry->IsRaid() ? 40 : 5);
+    float ratio = 5.0f / float(std::max(5u, maxPlayers));
+    float factor = health ? dungeonHealth * std::pow(ratio, raidHealthExp) : dungeonDamage * std::pow(ratio, raidDamageExp);
+    return std::max(0.01f, std::min(1.0f, factor));
+}
