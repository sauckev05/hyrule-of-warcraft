+namespace
+{
+    // the shards of the dungeons a hero had already finished before clears were counted, by mail
+    void RetroactiveShards()
+    {
+        if (CharacterDatabase.PQuery("SELECT 1 FROM `ai_playerbot_db_store` WHERE `guid` = 0 AND `preset` = 'zelda' AND `key` = 'once:retro-shards'"))
+            return;
+        CharacterDatabase.DirectExecute("INSERT INTO `ai_playerbot_db_store` (`guid`, `preset`, `key`, `value`) VALUES (0, 'zelda', 'once:retro-shards', '1')");
+        std::string const shardList = sConfig.GetStringDefault("Zelda.RetroShards", "191102 191105 191103 191104 191101 191107 191106");
+        std::string const accountName = sConfig.GetStringDefault("Zelda.HeroAccount", "PLAYER");
+        uint32 const accountId = sAccountMgr.GetId(accountName);
+        if (!accountId)
+            return;
+        std::vector<uint32> shards;
+        std::istringstream in(shardList);
+        for (uint32 id; in >> id;)
+            if (sObjectMgr.GetItemPrototype(id))
+                shards.push_back(id);
+        auto chars = CharacterDatabase.PQuery("SELECT `guid`, `name` FROM `characters` WHERE `account` = '%u'", accountId);
+        if (!chars)
+            return;
+        do
+        {
+            uint32 const guid = (*chars)[0].GetUInt32();
+            std::string const name = (*chars)[1].GetCppString();
+            bool hero = false;
+            for (ZeldaHero const& def : ZELDA_HEROES)
+                hero = hero || name == def.name;
+            if (hero)
+                continue;
+            for (uint32 id : shards)
+            {
+                Item* item = Item::CreateItem(id, 1, nullptr);
+                if (!item)
+                    continue;
+                CharacterDatabase.BeginTransaction();
+                item->SaveToDB();
+                CharacterDatabase.CommitTransaction();
+                // the mail owns the item from here (an offline receiver's copy is freed by it)
+                MailDraft(item->GetProto()->Name1, "You already cleared this one before anyone was counting. Here is its shard! Hey! Listen!")
+                    .AddItem(item).SendMailTo(MailReceiver(ObjectGuid(HIGHGUID_PLAYER, guid)), MailSender(MAIL_CREATURE, CLEAR_MAIL_SENDER), MAIL_CHECK_MASK_COPIED);
+                CharacterDatabase.PExecute("INSERT INTO `ai_playerbot_db_store` (`guid`, `preset`, `key`, `value`) VALUES ('%u', 'zelda', 'shard:%u', '1')", guid, id);
+            }
+            sLog.outString("Zelda: mailed %u crystal shards to %s", uint32(shards.size()), name.c_str());
+        }
+        while (chars->NextRow());
+    }
+}
+
+void ZeldaStartupCharacters()
+{
+    RemoveRetiredContent();
+    OneTimeCharacterChanges();
+    EnsureHeroes();
+    RetroactiveShards();
+}
+
+void ZeldaHeroFirstLogin(Player* player)
+{
+    {
+        std::lock_guard<std::mutex> guard(s_heroLock);
+        if (!s_pendingHeroes.erase(player->GetGUIDLow()))
+            return;
+    }
+    CharacterDatabase.PExecute("DELETE FROM `ai_playerbot_db_store` WHERE `guid` = '%u' AND `preset` = 'zelda' AND `key` = 'herolevel'", player->GetGUIDLow());
+
+    if (player->GetLevel() < HERO_LEVEL)
+        player->GiveLevel(HERO_LEVEL);
+
+    // every class spell a trainer would have taught her by now (talents are hers to choose)
+    if (ChrClassesEntry const* classEntry = sChrClassesStore.LookupEntry(player->getClass()))
+    {
+        for (uint32 i = 0; i < sSkillLineAbilityStore.GetNumRows(); ++i)
+        {
+            SkillLineAbilityEntry const* ability = sSkillLineAbilityStore.LookupEntry(i);
+            if (!ability)
+                continue;
+            SpellEntry const* spellInfo = sSpellTemplate.LookupEntry<SpellEntry>(ability->spellId);
+            if (!spellInfo || spellInfo->spellLevel == 0 || spellInfo->spellLevel > HERO_LEVEL)
+                continue;
+            if (spellInfo->SpellFamilyName != classEntry->spellfamily)
+                continue;
+            uint32 reqLevel = 0;
+            if (!player->IsSpellFitByClassAndRace(spellInfo->Id, &reqLevel) || reqLevel > HERO_LEVEL)
+                continue;
+            if (GetTalentSpellCost(sSpellMgr.GetFirstSpellInChain(spellInfo->Id)) > 0)
+                continue;
+            if (!SpellMgr::IsSpellValid(spellInfo, player, false) || player->HasSpell(spellInfo->Id))
+                continue;
+            player->learnSpell(spellInfo->Id, false);
+        }
+    }
+
+    // a shaman's totems
+    if (player->getClass() == CLASS_SHAMAN)
+    {
+        for (uint32 totem : { 5175u, 5176u, 5177u })
+        {
+            ItemPosCountVec dest;
+            if (!player->HasItemCount(totem, 1) && player->CanStoreNewItem(NULL_BAG, NULL_SLOT, dest, totem, 1) == EQUIP_ERR_OK)
+                player->StoreNewItem(dest, totem, true);
+        }
+    }
+
+    player->SaveToDB();
+    sLog.outString("Zelda: %s is now level %u with her class spells", player->GetName(), player->GetLevel());
+}
