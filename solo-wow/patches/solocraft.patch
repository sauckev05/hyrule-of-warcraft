+void instance_wailing_caverns::OnCreatureDeath(Creature* pCreature)
+{
+    // The Fanglords' EventAI death scripts set these too; counting here as well keeps the event
+    // from hanging on a missed script.
+    uint32 type;
+    switch (pCreature->GetEntry())
+    {
+        case NPC_ANACONDRA: type = TYPE_ANACONDRA; break;
+        case NPC_COBRAHN:   type = TYPE_COBRAHN;   break;
+        case NPC_PYTHAS:    type = TYPE_PYTHAS;    break;
+        case NPC_SERPENTIS: type = TYPE_SERPENTIS; break;
+        default: return;
+    }
+    if (m_auiEncounter[type] != DONE)
+        SetData(type, DONE);
+
+    uint32 slain = 0;
+    for (uint32 i = TYPE_ANACONDRA; i <= TYPE_SERPENTIS; ++i)
+        if (m_auiEncounter[i] == DONE)
+            ++slain;
+    if (slain < 4)
+    {
+        char text[96];
+        snprintf(text, sizeof(text), "Fanglords slain: %u of 4", slain);
+        TellPlayers(text);
+    }
+}
+
+void instance_wailing_caverns::TellPlayers(const char* text) const
+{
+    for (const auto& ref : instance->GetPlayers())
+    {
+        if (Player* player = ref.getSource())
+        {
+            player->GetSession()->SendAreaTriggerMessage("%s", text);
+            ChatHandler(player).PSendSysMessage("|cff33ff99%s|r", text);
+        }
+    }
+}
