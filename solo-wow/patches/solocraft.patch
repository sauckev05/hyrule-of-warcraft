+                                             TEMPSPAWN_CORPSE_TIMED_DESPAWN, 15000, false, marchTo != nullptr);
+        if (!c)
+            return nullptr;
+        c->SelectLevel(std::min<uint32>(63, player->GetLevel() + levelBonus));
+        if (marchTo)
+        {
+            // their "home" is the enemy base: after every fight they carry on there
+            c->SetRespawnCoord(marchTo->x, marchTo->y, marchTo->z, marchTo->o);
+            c->GetMotionMaster()->MovePoint(1, marchTo->x, marchTo->y, marchTo->z);
+        }
