+// ---------------------------------------------------------------------------------- guard: parry
+bool ZeldaShieldHolds(Unit const* victim, Unit const* attacker)
+{
+    if (!victim || !attacker || victim == attacker || victim->GetTypeId() != TYPEID_PLAYER || !victim->IsAlive())
+        return false;
+    {
+        std::lock_guard<std::mutex> guard(s_statesLock);
+        auto itr = s_states.find(victim->GetGUIDLow());
+        if (itr == s_states.end() || !itr->second.shield)
+            return false;
+    }
+    return victim->HasInArc(attacker, M_PI_F * 2.0f / 3.0f);
+}
+
+bool ZeldaParryHolds(Unit const* victim, Unit const* attacker)
+{
+    if (!victim || !attacker || victim == attacker || victim->GetTypeId() != TYPEID_PLAYER || !victim->IsAlive())
+        return false;
+    {
+        std::lock_guard<std::mutex> guard(s_statesLock);
+        auto itr = s_states.find(victim->GetGUIDLow());
+        if (itr == s_states.end() || !itr->second.parry)
+            return false;
+    }
+    return victim->HasInArc(attacker, M_PI_F * 2.0f / 3.0f);
+}
