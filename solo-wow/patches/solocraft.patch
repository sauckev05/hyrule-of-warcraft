+void MotionMaster::MovePushedBack(Unit const& from, float dist, float speed)
+{
+    if (m_owner->hasUnitState(UNIT_STAT_NO_FREE_MOVE) || !m_owner->IsInWorld())
+        return;
+
+    Position pos;
+    m_owner->GetFirstCollisionPosition(pos, dist, from.GetAngle(m_owner));
+
+    Movement::MoveSplineInit init(*m_owner);
+    init.SetWalk(false);
+    init.SetVelocity(speed);
+    init.MoveTo(pos.x, pos.y, pos.z, true);
+    init.SetFacing(&from);
+
+    Mutate(new EffectMovementGenerator(init, 0x5E7DA));
+}
