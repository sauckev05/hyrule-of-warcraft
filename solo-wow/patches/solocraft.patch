+
+namespace
+{
+    struct ZeldaState
+    {
+        uint32 lastSlash = 0;
+        uint32 comboCount = 0;
+        uint32 spinReadyAt = 0;
+        uint32 dodgeReadyAt = 0;
+        uint32 invulnerableUntil = 0;
+        uint32 boomerangReadyAt = 0;
+        uint32 bowReadyAt = 0;
+        bool shield = false;
+        uint32 shoutCheckIn = 0;
+        Player const* speedAppliedFor = nullptr;   // the login whose run speed was set
+        // companions travelling with this hero, by companion (Lyra, Faelin, Durza, Vesper)
+        uint32 followerEntry[4] = { 0, 0, 0, 0 };
+        ObjectGuid followerGuid[4];
+        uint32 followerBackAt[4] = { 0, 0, 0, 0 };   // after she falls, she rejoins at this time
+    };
+
+    // Commands run on the session's thread and damage on map threads, so the table is locked.
+    std::unordered_map<uint32, ZeldaState> s_states;
+    std::mutex s_statesLock;
+
+    ZeldaState& StateFor(Player* player)
+    {
+        std::lock_guard<std::mutex> guard(s_statesLock);
+        return s_states[player->GetGUIDLow()]; // references stay valid: unordered_map never moves nodes
+    }
+
+    const uint32 COMBO_WINDOW_MS = 1100;
+    const uint32 SPIN_COOLDOWN_MS = 2500;
+    const uint32 SPIN_RAGE_COST = 50 * 10;        // 50 rage (stored x10)
+    const float SPIN_DAMAGE_MULTIPLIER = 3.0f;    // a spin hit is three normal swings
+    const uint32 SPIN_STRIKES = 2;                // and every enemy in reach is hit twice
+
+    // Set while the spin attack's swings resolve; CalculateMeleeDamage reads it on the same thread.
+    thread_local float t_meleeMultiplier = 1.0f;
+    const uint32 DODGE_COOLDOWN_MS = 900;
+    const uint32 DODGE_INVULN_MS = 450;
+    const uint32 BOOMERANG_COOLDOWN_MS = 5000;
+    const float BOOMERANG_RANGE = 30.0f;
+    const uint32 BOOMERANG_SPELL = 15712;          // Linken's Boomerang: throw, flight and return visuals
+    const float BOW_RANGE = 35.0f;
+    const uint32 BOW_COOLDOWN_MS = 1100;
+
+    enum class Style { OneHanded, TwoHanded, DualWield, Unarmed };
+
+    struct StyleStats
+    {
+        float slashRange;
+        float slashArc;
+        uint32 slashGapMs;
+        float spinRange;
+        uint32 spinHits;
+    };
+
+    Style StyleOf(Player* player)
+    {
+        Item* main = player->GetWeaponForAttack(BASE_ATTACK, true, true);
+        if (!main)
+            return Style::Unarmed;
+        if (main->GetProto()->InventoryType == INVTYPE_2HWEAPON)
+            return Style::TwoHanded;
+        if (player->GetWeaponForAttack(OFF_ATTACK, true, true))
+            return Style::DualWield;
+        return Style::OneHanded;
+    }
+
+    StyleStats StatsFor(Style style)
+    {
+        switch (style)
+        {
+            case Style::TwoHanded: return { 7.0f, M_PI_F * 5.0f / 6.0f, 650, 9.5f, 3 }; // Biggoron's Sword
+            case Style::DualWield: return { 5.5f, M_PI_F * 2.0f / 3.0f, 420, 7.5f, 2 };
+            case Style::Unarmed:   return { 4.5f, M_PI_F / 2.0f, 380, 6.0f, 1 };
+            default:               return { 5.5f, M_PI_F * 2.0f / 3.0f, 380, 7.5f, 2 }; // Kokiri/Master Sword
+        }
+    }
+
+    const char* StyleName(Style style)
+    {
+        switch (style)
+        {
+            case Style::TwoHanded: return "two-handed weapon";
+            case Style::DualWield: return "two weapons";
+            case Style::Unarmed:   return "no weapon";
+            default:               return "one-handed weapon";
+        }
+    }
+
+    void CollectEnemies(Player* player, float range, std::list<Unit*>& out)
+    {
+        MaNGOS::AnyUnfriendlyUnitInObjectRangeCheck check(player, range);
+        MaNGOS::UnitListSearcher<MaNGOS::AnyUnfriendlyUnitInObjectRangeCheck> searcher(out, check);
+        Cell::VisitAllObjects(player, searcher, range);
+
+        for (auto itr = out.begin(); itr != out.end();)
+        {
+            Unit* unit = *itr;
+            if (!unit->IsAlive() || !player->CanAttack(unit) || !player->IsWithinLOSInMap(unit))
+                itr = out.erase(itr);
+            else
+                ++itr;
+        }
+    }
+
+    bool CanAct(Player* player)
+    {
+        return player->IsAlive() && !player->IsTaxiFlying() && !player->IsMounted() &&
+               !player->hasUnitState(UNIT_STAT_CAN_NOT_REACT) && !player->HasFlag(UNIT_FIELD_FLAGS, UNIT_FLAG_PACIFIED);
+    }
+
+    void ZeldaSwing(Player* player, Unit* victim, uint32 hits)
+    {
+        for (uint32 i = 0; i < hits && victim->IsAlive(); ++i)
+            player->AttackerStateUpdate(victim, BASE_ATTACK, true);
+    }
+
+    // Warrior Whirlwind (rank 1). Its cast animation is the spin attack's look.
+    const uint32 WHIRLWIND_SPELL = 1680;
+
+    // Plays Whirlwind's spinning animation, swoosh and sound on the hero for every client nearby,
+    // without casting the spell: an SMSG_SPELL_GO with no effects, listing the enemies the spin hit
+    // so they show Whirlwind's impact too. The damage itself still comes from ZeldaSwing.
+    void PlaySpellVisual(Player* player, uint32 spellId, std::vector<ObjectGuid> const& hits)
+    {
+        uint8 const count = uint8(std::min<size_t>(hits.size(), 255));
+        WorldPacket data(SMSG_SPELL_GO, 32 + count * 8);
+        data << player->GetPackGUID();                 // caster (no item)
+        data << player->GetPackGUID();                 // caster unit
+        data << uint32(spellId);
+        data << uint16(0x0100 | 0x0001);               // CAST_FLAG_UNKNOWN9 | CAST_FLAG_HIDDEN_COMBATLOG
+        data << count;                                 // hit targets
+        for (uint8 i = 0; i < count; ++i)
+            data << hits[i];
+        data << uint8(0);                              // missed targets
+        data << uint16(0);                             // TARGET_FLAG_SELF
+        player->SendMessageToSet(data, true);
+
+        // the hero's own client starts the spell's cooldown and global cooldown when the GO
+        // arrives - clear them, so the visual never locks the action bar
+        player->SendClearCooldown(spellId, player);
+    }
+
+    void PlayWhirlwind(Player* player, std::vector<ObjectGuid> const& hits)
+    {
+        PlaySpellVisual(player, WHIRLWIND_SPELL, hits);
+    }
+
+    // Heroic Strike (rank 1): its cast kit latches the red weapon trail onto the hero's next swing.
+    const uint32 RED_TRAIL_SPELL = 78;
+}
+
+void ZeldaSwingTrail(Player* player, Unit* victim)
+{
+    static bool const redTrail = sConfig.GetBoolDefault("Zelda.RedSwingTrail", true);
+    if (!redTrail || !player || !victim || t_meleeMultiplier > 1.0f)   // the spin plays Whirlwind instead
+        return;
+    std::vector<ObjectGuid> hits;
+    hits.push_back(victim->GetObjectGuid());
+    PlaySpellVisual(player, RED_TRAIL_SPELL, hits);
+}
+
+float ZeldaSpeedFactor(Player* player, uint32 moveType)
+{
+    if (moveType != MOVE_RUN || !player)
+        return 1.0f;
+    if (StateFor(player).shield)
+        return 0.45f;                           // shield up: a careful walk, whatever the run speed
+    static float const runRate = std::max(0.1f, sConfig.GetFloatDefault("Zelda.RunSpeedRate", 2.0f));
+    return runRate;
+}
+
+bool ZeldaQuestItemsAlwaysDrop()
+{
+    static bool const always = sConfig.GetBoolDefault("Zelda.QuestItemsAlwaysDrop", true);
+    return always;
+}
+
+float ZeldaRangedDamageMultiplier()
+{
