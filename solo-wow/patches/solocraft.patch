+    float const FOLLOW_DIST = 2.5f;
+    float const FOLLOW_ANGLES[4] = { M_PI_F * 0.75f, M_PI_F * 1.25f, M_PI_F * 0.5f, M_PI_F * 1.5f };
+}
+
+struct npc_zelda_companionAI : public ScriptedAI
+{
+    npc_zelda_companionAI(Creature* creature) : ScriptedAI(creature),
+        m_index(CompanionIndex(creature->GetEntry())), m_follower(creature->IsTemporarySummon())
+    {
+        Companion const& c = Data();
+        SetRangedMode(true, c.castRange, TYPE_FULL_CASTER);
+        if (m_follower)
+            m_ownerGuid = creature->GetSpawnerGuid();
+        m_roaming = !m_follower && m_index == ELARA_INDEX;
+        if (m_roaming)
+        {
+            creature->SetActiveObjectState(true);   // she keeps walking when nobody is near
+            m_roamWait = urand(20000, 60000);
+        }
+        Reset();
+    }
+
+    int32 m_index;
+    bool m_follower;
+    ObjectGuid m_ownerGuid;
+    uint32 m_tick = 0;
+    uint32 m_globalCooldown = 0;
+    uint32 m_shockTimer = 0;
+    uint32 m_buffTimer = 0;
+    uint32 m_idleLineTimer = 0;
+    uint32 m_hurtLineTimer = 0;
+    uint32 m_novaTimer = 0;
+    bool m_boundToOwner = false;
+    // Elara's own wandering
+    bool m_roaming = false;
+    int32 m_hub = -1;               // where she is heading (-1: resting, waiting to set off)
+    uint32 m_roamWait = 0;          // resting time left at a hub
+    uint32 m_progressTimer = 0;     // checks she is still getting closer
+    float m_lastDist = 0.0f;
+    uint32 m_stuckCount = 0;
+
+    Companion const& Data() const { return COMPANIONS[m_index < 0 ? 0 : m_index]; }
+    uint32 Level() const { return m_creature->GetLevel(); }
+
+    void Reset() override
+    {
+        m_globalCooldown = 0;
+        m_shockTimer = 0;
+        m_buffTimer = 2000;
+        m_idleLineTimer = urand(20000, 60000);
+        m_hurtLineTimer = 0;
+        if (m_creature->GetEntry() == LYRA_CAPTIVE)
+            m_creature->SetStandState(UNIT_STAND_STATE_KNEEL);
+    }
+
+    Player* Owner() const
+    {
+        if (!m_follower || !m_ownerGuid)
+            return nullptr;
+        return m_creature->GetMap()->GetPlayer(m_ownerGuid);
+    }
+
+    void Say(char const* text, Unit const* target = nullptr)
+    {
+        if (text)
+            m_creature->MonsterSay(text, LANG_UNIVERSAL, target);
+    }
+
+    // a follower fights as one of the hero's own: same side, same reactions, the hero's kills
+    void BindToOwner(Player* owner)
+    {
+        if (m_boundToOwner)
+            return;
+        m_boundToOwner = true;
+        m_creature->SetOwnerGuid(owner->GetObjectGuid());
+        m_creature->setFaction(owner->GetFaction());
+        m_creature->SetFlag(UNIT_FIELD_FLAGS, UNIT_FLAG_PLAYER_CONTROLLED);
+        m_creature->SelectLevel(owner->GetLevel());
+        m_creature->GetMotionMaster()->Clear();
+        m_creature->GetMotionMaster()->MoveFollow(owner, FOLLOW_DIST, FOLLOW_ANGLES[m_index & 3]);
+    }
+
+    void JustDied(Unit* /*killer*/) override
+    {
+        Say(Pick(Data().died));
+        if (Player* owner = Owner())
+            ZeldaFollowerDied(owner, FollowerSlot(m_index));
+    }
+
+    void Aggro(Unit* /*who*/) override
+    {
+        if (urand(0, 2) == 0)
+            Say(Pick(Data().aggro));
+    }
+
+    void KilledUnit(Unit* /*victim*/) override
+    {
+        if (urand(0, 3) == 0)
+            Say(Pick(Data().kill));
+    }
+
+    void EnterEvadeMode() override
+    {
+        if (m_roaming)
+        {
+            // the fight is over: she simply carries on with her walk
+            m_creature->RemoveAllAurasOnEvade();
+            m_creature->CombatStop(true);
+            m_creature->SetLootRecipient(nullptr);
+            m_creature->GetMotionMaster()->Clear();
+            if (m_hub >= 0)
+                MoveOn();
+            else
+                m_creature->GetMotionMaster()->MoveIdle();
+            return;
+        }
+        if (!m_follower)
+        {
+            ScriptedAI::EnterEvadeMode();
+            return;
+        }
+        m_creature->RemoveAllAurasOnEvade();
+        m_creature->CombatStop(true);
+        m_creature->SetLootRecipient(nullptr);
+        if (Player* owner = Owner())
+        {
+            m_creature->GetMotionMaster()->Clear();
+            m_creature->GetMotionMaster()->MoveFollow(owner, FOLLOW_DIST, FOLLOW_ANGLES[m_index & 3]);
+        }
+    }
+
+    bool Cast(Unit* target, uint32 spellId, uint32 flags = 0)
+    {
+        if (!spellId || !target)
+            return false;
+        if (DoCastSpellIfCan(target, spellId, flags) == CAST_OK)
+        {
+            m_globalCooldown = 1500;
+            return true;
+        }
+        return false;
+    }
+
+    // healing and buffs for the hero (and herself); true when a spell went out
+    bool Support(Player* owner)
+    {
+        uint32 const lvl = Level();
+        Unit* patient = nullptr;
+        if (owner && owner->IsAlive() && owner->GetHealthPercent() < 55.0f && m_creature->IsWithinDistInMap(owner, 35.0f))
+            patient = owner;
+        else if (m_creature->GetHealthPercent() < 40.0f)
+            patient = m_creature;
+
+        if (patient && patient == owner && m_hurtLineTimer == 0 && owner->GetHealthPercent() < 30.0f)
+        {
+            Say(Pick(Data().hurt));
+            m_hurtLineTimer = 20000;
+        }
+
+        switch (Data().role)
+        {
+            case ROLE_PRIEST:
+                if (patient)
+                {
+                    if (patient == owner && !owner->HasAura(WEAKENED_SOUL) && Cast(owner, BestRank(PW_SHIELD, lvl)))
+                        return true;
+                    uint32 heal = lvl >= 20 ? BestRank(FLASH_HEAL, lvl) : BestRank(SMALL_HEAL, lvl);
+                    if (Cast(patient, heal))
+                        return true;
+                }
+                if (owner && owner->IsAlive() && owner->GetHealthPercent() < 85.0f && Cast(owner, BestRank(RENEW, lvl), CAST_AURA_NOT_PRESENT))
+                    return true;
+                break;
+            case ROLE_SHAMAN:
+                if (patient && Cast(patient, BestRank(HEALING_WAVE, lvl)))
+                    return true;
+                break;
+            case ROLE_WARLOCK:
+            case ROLE_HUNTER:
+            case ROLE_MAGE:
+                break;
+        }
+        return false;
+    }
+
+    void Buffs(Player* owner)
+    {
+        uint32 const lvl = Level();
+        switch (Data().role)
+        {
+            case ROLE_PRIEST:
+                if (owner && owner->IsAlive() && m_creature->IsWithinDistInMap(owner, 30.0f))
+                    Cast(owner, BestRank(FORTITUDE, lvl), CAST_AURA_NOT_PRESENT);
+                break;
+            case ROLE_SHAMAN:
+                Cast(m_creature, BestRank(LIGHTNING_SHIELD, lvl), CAST_AURA_NOT_PRESENT);
+                break;
+            case ROLE_WARLOCK:
+                Cast(m_creature, BestRank(DEMON_ARMOR, lvl), CAST_AURA_NOT_PRESENT);
+                break;
+            case ROLE_HUNTER:
+                break;
+            case ROLE_MAGE:
+                if (Cast(m_creature, BestRank(MAGE_ARMOR, lvl), CAST_AURA_NOT_PRESENT))
+                    break;
+                Cast(m_creature, BestRank(ARCANE_INTELLECT, lvl), CAST_AURA_NOT_PRESENT);
+                break;
+        }
+    }
+
+    void Attack(Unit* target)
+    {
+        uint32 const lvl = Level();
+        switch (Data().role)
+        {
+            case ROLE_PRIEST:
+                if (Cast(target, BestRank(SW_PAIN, lvl), CAST_AURA_NOT_PRESENT))
+                    return;
+                Cast(target, BestRank(SMITE, lvl));
+                break;
+            case ROLE_HUNTER:
+                if (Cast(target, BestRank(SERPENT_STING, lvl), CAST_AURA_NOT_PRESENT))
+                    return;
+                if (m_shockTimer == 0 && Cast(target, BestRank(ARCANE_SHOT, lvl)))
+                {
+                    m_shockTimer = 6000;
+                    return;
+                }
+                if (lvl >= 8 && target->GetHealthPercent() < 30.0f && Cast(target, CONCUSSIVE_SHOT, CAST_AURA_NOT_PRESENT))
+                    return;
+                Cast(target, SHOOT);
+                break;
+            case ROLE_SHAMAN:
+                if (lvl >= 10 && Cast(target, BestRank(FLAME_SHOCK, lvl), CAST_AURA_NOT_PRESENT))
+                    return;
+                if (m_shockTimer == 0 && Cast(target, BestRank(EARTH_SHOCK, lvl)))
+                {
+                    m_shockTimer = 6000;
+                    return;
+                }
+                Cast(target, BestRank(LIGHTNING_BOLT, lvl));
+                break;
+            case ROLE_WARLOCK:
+                if (Cast(target, BestRank(CORRUPTION, lvl), CAST_AURA_NOT_PRESENT))
+                    return;
+                if (Cast(target, BestRank(CURSE_OF_AGONY, lvl), CAST_AURA_NOT_PRESENT))
+                    return;
+                if (Cast(target, BestRank(IMMOLATE, lvl), CAST_AURA_NOT_PRESENT))
+                    return;
+                Cast(target, BestRank(SHADOW_BOLT, lvl));
+                break;
+            case ROLE_MAGE:
+                // too close: freeze them in place, then blast
+                if (m_novaTimer == 0 && lvl >= 10 && m_creature->IsWithinDistInMap(target, 9.0f) && Cast(target, BestRank(FROST_NOVA, lvl)))
+                {
+                    m_novaTimer = 25000;
+                    return;
+                }
+                if (m_shockTimer == 0 && lvl >= 6 && Cast(target, BestRank(FIRE_BLAST, lvl)))
+                {
+                    m_shockTimer = 8000;
+                    return;
+                }
+                if (lvl >= 4 && urand(0, 2) == 0 && Cast(target, BestRank(FROSTBOLT, lvl)))
+                    return;
+                Cast(target, BestRank(FIREBALL, lvl));
+                break;
+        }
+    }
+
+    void UpdateFollower(uint32 diff, Player* owner)
+    {
+        // the hero logged out or went elsewhere, or another copy of her travels with the hero now
+        // (one was left behind on this map when the hero went into a dungeon): this one goes home
+        if (!owner || !ZeldaIsCurrentFollower(owner, FollowerSlot(m_index), m_creature->GetObjectGuid()))
+        {
+            m_creature->ForcedDespawn();
+            return;
+        }
+        BindToOwner(owner);
+
+        // keep up with the hero: a long way behind, she catches up at once
+        if (!m_creature->IsWithinDistInMap(owner, 60.0f) && !owner->IsTaxiFlying())
+        {
+            float x, y, z;
+            owner->GetNearPoint(owner, x, y, z, 0.0f, 2.0f, owner->GetOrientation() + M_PI_F);
+            m_creature->NearTeleportTo(x, y, z, owner->GetOrientation());
+            EnterEvadeMode();
+            return;
+        }
+
+        // keep pace with the hero's run, sprint or mount
+        float const rate = owner->GetSpeedRate(MOVE_RUN) * 1.1f;
+        if (!m_creature->IsInCombat() && std::fabs(m_creature->GetSpeedRate(MOVE_RUN) - rate) > 0.01f)
+            m_creature->SetSpeedRate(MOVE_RUN, rate);
+
+        m_tick += diff;
+        if (m_tick >= 5000)
+        {
+            m_tick = 0;
+            if (m_creature->GetLevel() != owner->GetLevel())
+                m_creature->SelectLevel(owner->GetLevel());
+        }
+
+        // fight what the hero fights
+        if (!m_creature->IsInCombat() && owner->IsInCombat())
+        {
+            Unit* target = owner->GetVictim();
+            if (!target || !target->IsAlive() || !m_creature->CanAttack(target))
+                target = owner->getAttackerForHelper();
+            if (target && target->IsAlive() && m_creature->CanAttack(target))
+                AttackStart(target);
+        }
+
+        if (!m_creature->IsInCombat() && m_creature->GetMotionMaster()->GetCurrentMovementGeneratorType() != FOLLOW_MOTION_TYPE)
+            m_creature->GetMotionMaster()->MoveFollow(owner, FOLLOW_DIST, FOLLOW_ANGLES[m_index & 3]);
+    }
+
+    // ---------------------------------------------------------------- Elara's wandering
+    Player* PlayerNear(float range) const
+    {
+        Map::PlayerList const& players = m_creature->GetMap()->GetPlayers();
+        for (auto const& ref : players)
+        {
+            Player* player = ref.getSource();
+            if (player && player->IsAlive() && m_creature->IsWithinDistInMap(player, range))
+                return player;
+        }
+        return nullptr;
+    }
+
+    void SayAbout(char const* format, char const* place)
+    {
+        if (Player* listener = PlayerNear(30.0f))      // ("near" is a Windows macro)
+        {
+            char text[256];
+            snprintf(text, sizeof(text), format, place);
+            m_creature->MonsterSay(text, LANG_UNIVERSAL, listener);
+        }
+    }
+
+    float DistToHub() const
+    {
+        Hub const& h = ELARA_HUBS[m_hub];
+        return m_creature->GetDistance(h.x, h.y, h.z);
+    }
+
+    void MoveOn()
+    {
+        Hub const& h = ELARA_HUBS[m_hub];
+        m_creature->GetMotionMaster()->MovePoint(1, h.x, h.y, h.z, FORCED_MOVEMENT_RUN, true);
+        m_lastDist = DistToHub();
+        m_progressTimer = 20000;
+    }
+
+    void SetOff()
+    {
+        // somewhere joined to where she is now (or the nearest place, the first time)
+        int32 from = 0;
+        float best = 1e9f;
+        for (uint32 i = 0; i < ELARA_HUBS.size(); ++i)
+        {
+            float d = m_creature->GetDistance(ELARA_HUBS[i].x, ELARA_HUBS[i].y, ELARA_HUBS[i].z);
+            if (d < best)
+            {
+                best = d;
+                from = int32(i);
+            }
+        }
+        std::vector<uint32> const& next = ELARA_HUBS[from].next;
+        m_hub = int32(next[urand(0, uint32(next.size()) - 1)]);
+        m_stuckCount = 0;
+        SayAbout(ELARA_SETTING_OFF[urand(0, 2)], ELARA_HUBS[m_hub].name);
+        MoveOn();
+    }
+
+    void MovementInform(uint32 type, uint32 id) override
+    {
+        if (!m_roaming || type != POINT_MOTION_TYPE || id != 1 || m_hub < 0 || m_creature->IsInCombat())
+            return;
+        if (DistToHub() > 10.0f)
+        {
+            MoveOn();                            // a long road comes in pieces: on to the next
+            return;
+        }
+        SayAbout(ELARA_ARRIVED[urand(0, 2)], ELARA_HUBS[m_hub].name);
+        m_hub = -1;
+        m_roamWait = urand(90000, 240000);       // a rest, a snack, a book
+        m_idleLineTimer = urand(20000, 40000);
+        m_creature->GetMotionMaster()->Clear();
+        m_creature->GetMotionMaster()->MoveRandomAroundPoint(m_creature->GetPositionX(), m_creature->GetPositionY(),
+                                                              m_creature->GetPositionZ(), 6.0f);
+    }
+
+    void UpdateRoam(uint32 diff)
+    {
+        if (m_hub < 0)
+        {
+            UpdateIdle(diff);
+            if (m_roamWait > diff)
+            {
+                m_roamWait -= diff;
+                return;
+            }
+            SetOff();
+            return;
+        }
+        // on the road: make sure she is still getting somewhere
+        if (m_progressTimer > diff)
+        {
+            m_progressTimer -= diff;
+            return;
+        }
+        float const d = DistToHub();
+        if (d > m_lastDist - 3.0f)
+        {
+            if (++m_stuckCount >= 3)
+            {
+                // this road is no good today: somewhere else
+                m_creature->GetMotionMaster()->Clear();
+                m_hub = -1;
+                m_roamWait = 5000;
+                return;
+            }
+        }
+        else
+            m_stuckCount = 0;
+        if (m_creature->GetMotionMaster()->GetCurrentMovementGeneratorType() != POINT_MOTION_TYPE)
+            MoveOn();
+        m_lastDist = d;
+        m_progressTimer = 20000;
+    }
+
+    void UpdateIdle(uint32 diff)
+    {
+        if (m_creature->GetEntry() == LYRA_CAPTIVE)
+            return;
+        if (m_idleLineTimer > diff)
+        {
+            m_idleLineTimer -= diff;
+            return;
+        }
+        m_idleLineTimer = urand(60000, 120000);
+
+        // only talks when someone who can see her is around to hear it
+        Map::PlayerList const& players = m_creature->GetMap()->GetPlayers();
+        for (auto const& ref : players)
+        {
+            Player* player = ref.getSource();
+            if (player && player->IsAlive() && m_creature->IsWithinDistInMap(player, 15.0f) && !ZeldaStageHidden(m_creature, player))
+            {
+                Say(Pick(Data().idle), player);
+                break;
+            }
+        }
+    }
+
+    void UpdateAI(const uint32 diff) override
+    {
+        if (m_globalCooldown > diff) m_globalCooldown -= diff; else m_globalCooldown = 0;
+        if (m_shockTimer > diff) m_shockTimer -= diff; else m_shockTimer = 0;
+        if (m_hurtLineTimer > diff) m_hurtLineTimer -= diff; else m_hurtLineTimer = 0;
+        if (m_novaTimer > diff) m_novaTimer -= diff; else m_novaTimer = 0;
+
+        Player* owner = Owner();
+        if (m_follower)
+            UpdateFollower(diff, owner);
+        else if (m_roaming && m_creature->IsAlive() && !m_creature->IsInCombat())
+            UpdateRoam(diff);
+        else if (!m_creature->IsInCombat())
+            UpdateIdle(diff);
+
+        if (!m_creature->IsAlive() || !m_creature->IsInWorld())
+            return;
+
+        // the enemy fell: the next one the hero (or anyone) is fighting, else out of combat and
+        // back to the hero's side - never standing about "in combat" with nobody
+        if (m_creature->IsInCombat())
+        {
+            Unit* victim = m_creature->GetVictim();
+            if (!victim || !victim->IsAlive() || !m_creature->CanAttack(victim))
+            {
+                Unit* next = nullptr;
+                if (owner && owner->IsInCombat())
+                {
+                    next = owner->GetVictim();
+                    if (!next || !next->IsAlive() || !m_creature->CanAttack(next))
+                        next = owner->getAttackerForHelper();
+                }
+                if (!next)
+                    next = m_creature->getAttackerForHelper();
+                if (next && next->IsAlive() && m_creature->CanAttack(next))
+                    AttackStart(next);
+                else
+                {
+                    EnterEvadeMode();
+                    return;
+                }
+            }
+        }
+
+        if (m_globalCooldown == 0 && !m_creature->IsNonMeleeSpellCasted(false))
+        {
+            if (Support(owner))
+                return;
+
+            if (m_creature->IsInCombat() && m_creature->GetVictim())
+            {
+                Attack(m_creature->GetVictim());
+            }
+            else
+            {
+                if (m_buffTimer > diff)
+                    m_buffTimer -= diff;
+                else
+                {
+                    m_buffTimer = 5000;
+                    Buffs(owner);
+                }
+            }
+        }
+
+        if (m_creature->IsInCombat() && m_creature->GetVictim())
+            DoMeleeAttackIfReady();
+    }
+};
