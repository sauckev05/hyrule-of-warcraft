+                    player->GetHitChance(SPELL_SCHOOL_MASK_HOLY), player->GetFloatValue(PLAYER_DODGE_PERCENTAGE),
+                    player->GetFloatValue(PLAYER_PARRY_PERCENTAGE), player->GetFloatValue(PLAYER_BLOCK_PERCENTAGE),
+                    player->GetWeaponSkillValue(BASE_ATTACK), uint32(player->GetSkillMaxForLevel()),
+                    player->SpellBaseDamageBonusDone(SPELL_SCHOOL_MASK_HOLY));
