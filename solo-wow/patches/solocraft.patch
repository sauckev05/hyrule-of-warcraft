+    // splits a .sql file into statements: ';' ends one unless inside a quoted string or comment
+    std::vector<std::string> SplitSql(std::string const& text)
+    {
+        std::vector<std::string> out;
+        std::string cur;
+        char quote = 0;
+        for (size_t i = 0; i < text.size(); ++i)
+        {
+            char c = text[i];
+            if (quote)
+            {
+                cur += c;
+                if (c == '\\' && i + 1 < text.size())
+                {
+                    cur += text[++i];
+                    continue;
+                }
+                if (c == quote)
+                {
+                    if (i + 1 < text.size() && text[i + 1] == quote)
+                    {
+                        cur += text[++i];
+                        continue;
+                    }
+                    quote = 0;
+                }
+                continue;
+            }
+            if (c == '-' && i + 1 < text.size() && text[i + 1] == '-')
+            {
+                while (i < text.size() && text[i] != '\n')
+                    ++i;
+                cur += '\n';
+                continue;
+            }
+            if (c == '\'' || c == '"' || c == '`')
+            {
+                quote = c;
+                cur += c;
+                continue;
+            }
+            if (c == ';')
+            {
+                if (cur.find_first_not_of(" \t\r\n") != std::string::npos)
+                    out.push_back(cur);
+                cur.clear();
+                continue;
+            }
+            cur += c;
+        }
+        if (cur.find_first_not_of(" \t\r\n") != std::string::npos)
+            out.push_back(cur);
+        return out;
+    }
+
+    std::string Fingerprint(std::string const& text)
+    {
+        uint64 h = 1469598103934665603ULL;          // FNV-1a
+        for (unsigned char c : text)
+        {
+            h ^= c;
+            h *= 1099511628211ULL;
+        }
+        std::ostringstream ss;
+        ss << std::hex << h;
+        return ss.str();
+    }
+}
+
+void ZeldaApplyContentSql()
+{
+    namespace fs = std::filesystem;
+    std::string const dir = sConfig.GetStringDefault("Zelda.ContentDir", "zelda-sql");
+    std::error_code ec;
+    if (!fs::is_directory(dir, ec))
+    {
+        sLog.outString(">> Zelda: no content folder '%s'", dir.c_str());
+        return;
+    }
+
+    WorldDatabase.DirectExecute("CREATE TABLE IF NOT EXISTS `zelda_applied` (`name` VARCHAR(190) NOT NULL PRIMARY KEY, `fingerprint` VARCHAR(32) NOT NULL) ENGINE=InnoDB DEFAULT CHARSET=utf8");
+
+    std::vector<fs::path> files;
+    for (auto const& entry : fs::directory_iterator(dir, ec))
+        if (entry.is_regular_file() && entry.path().extension() == ".sql")
+            files.push_back(entry.path());
+    std::sort(files.begin(), files.end());
+
+    for (fs::path const& file : files)
+    {
+        std::ifstream in(file, std::ios::binary);
+        std::stringstream buffer;
+        buffer << in.rdbuf();
+        std::string const text = buffer.str();
+        std::string const name = file.filename().string();
+        std::string const print = Fingerprint(text);
+
+        std::string escapedName = name;
+        WorldDatabase.escape_string(escapedName);
+        if (auto result = WorldDatabase.PQuery("SELECT `fingerprint` FROM `zelda_applied` WHERE `name` = '%s'", escapedName.c_str()))
+            if (result->Fetch()[0].GetCppString() == print)
+                continue;                           // already in the database
+
+        uint32 ok = 0, failed = 0;
+        for (std::string const& statement : SplitSql(text))
+        {
+            if (WorldDatabase.DirectExecute(statement.c_str()))
+                ++ok;
+            else
+                ++failed;
+        }
+        WorldDatabase.DirectPExecute("REPLACE INTO `zelda_applied` (`name`, `fingerprint`) VALUES ('%s', '%s')", escapedName.c_str(), print.c_str());
+        sLog.outString(">> Zelda: applied %s (%u statements, %u failed)", name.c_str(), ok, failed);
+        if (failed)
+            sLog.outError("Zelda: %u statements in %s failed - see the database error log", failed, name.c_str());
+    }
+}
