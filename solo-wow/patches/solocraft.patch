+uint32 ZeldaNaviResurrection(Player* player)
+{
+    if (!player || !WearsNavisLight(player))
+        return 0;
+    ZeldaState& state = StateFor(player);
+    time_t const now = time(nullptr);
+    Creature* navi = NaviOf(player, state);
+    if (now < state.naviReviveReadyAt)
+    {
+        if (navi)
+            navi->MonsterSay("Hey! Get... up...! I can't - I'm too tired! Not yet! Somebody help!", LANG_UNIVERSAL, player);
+        return 0;
+    }
+    static uint32 const reviveMinutes = uint32(std::max(0, sConfig.GetIntDefault("Zelda.NaviReviveMinutes", 5)));
+    state.naviReviveReadyAt = now + time_t(reviveMinutes) * 60;
+    if (navi)
+        navi->MonsterSay("NO! Hey! LISTEN! You don't get to stop here! Take my light - get up!", LANG_UNIVERSAL, player);
+
+    // Navi's Light (custom spell 40009, 006_mastery): back on your feet with 10% of your health, in
+    // a priest's resurrection light
+    return 40009;
+}
