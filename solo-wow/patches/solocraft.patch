+void ZeldaSwingTrail(Player* player, Unit* victim)
+{
+    static bool const redTrail = sConfig.GetBoolDefault("Zelda.RedSwingTrail", true);
+    // the spin plays Whirlwind instead; the sword combo's swings are animated by the client, and the
+    // trail's Heroic Strike cast would replace them with Heroic Strike's own swing
+    if (!redTrail || !player || !victim || t_meleeMultiplier > 1.0f || t_noSwingAnim)
+        return;
+    std::vector<ObjectGuid> hits;
+    hits.push_back(victim->GetObjectGuid());
+    PlaySpellVisual(player, RED_TRAIL_SPELL, hits);
+}
