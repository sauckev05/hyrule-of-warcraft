+    std::vector<Rank> const LIGHTNING_SHIELD = { {8, 324}, {16, 325}, {24, 905}, {32, 945}, {40, 8134}, {48, 10431}, {56, 10432} };
+
+    std::vector<Rank> const SHADOW_BOLT    = { {1, 686}, {6, 695}, {12, 705}, {20, 1088}, {28, 1106}, {36, 7641}, {44, 11659}, {52, 11660}, {60, 11661} };
