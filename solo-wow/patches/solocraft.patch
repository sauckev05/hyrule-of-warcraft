+    // characters made for the player's own account: they start at the Darnassus inn and become
+    // level 25, with their class spells, the first time they log in
+    struct ZeldaHero
+    {
+        char const* name;
+        uint8 race, cls, skin, face, hairStyle, hairColor;
+    };
+
+    ZeldaHero const ZELDA_HEROES[] =
+    {
+        { "Ruuka", RACE_ORC, CLASS_SHAMAN, 2, 3, 2, 1 },
+        { "Morwenna", RACE_UNDEAD, CLASS_PRIEST, 1, 2, 3, 4 },
+        { "Lianne", RACE_HUMAN, CLASS_PRIEST, 2, 1, 7, 6 },
+        { "Faelenna", RACE_NIGHTELF, CLASS_DRUID, 3, 4, 2, 5 },
+    };
+
+    uint32 const HERO_LEVEL = 25;
+    std::mutex s_heroLock;
+    std::set<uint32> s_pendingHeroes;
+
+    void EnsureHeroes()
+    {
+        if (!sConfig.GetBoolDefault("Zelda.HeroCharacters", true))
+            return;
+        std::string const accountName = sConfig.GetStringDefault("Zelda.HeroAccount", "PLAYER");
+        uint32 const accountId = sAccountMgr.GetId(accountName);
+        if (!accountId)
+            return;
+
+        uint32 created = 0;
+        for (ZeldaHero const& def : ZELDA_HEROES)
+        {
+            std::string escaped = def.name;
+            CharacterDatabase.escape_string(escaped);
+            // made once: a hero the player deleted stays deleted
+            if (CharacterDatabase.PQuery("SELECT 1 FROM `ai_playerbot_db_store` WHERE `guid` = 0 AND `preset` = 'zelda' AND `key` = 'hero:%s'", escaped.c_str()))
+                continue;
+            CharacterDatabase.PExecute("INSERT INTO `ai_playerbot_db_store` (`guid`, `preset`, `key`, `value`) VALUES (0, 'zelda', 'hero:%s', '1')", escaped.c_str());
+            if (CharacterDatabase.PQuery("SELECT guid FROM characters WHERE name = '%s'", escaped.c_str()))
+                continue;
+
+            WorldSession* session = new WorldSession(accountId, nullptr, SEC_PLAYER, 0, LOCALE_enUS, accountName, 0);
+            Player* hero = new Player(session);
+            if (!hero->Create(sObjectMgr.GeneratePlayerLowGuid(), def.name, def.race, def.cls, GENDER_FEMALE, def.skin, def.face, def.hairStyle, def.hairColor, 0, 0))
+            {
+                sLog.outError("Zelda: could not create %s", def.name);
+                delete hero;
+                delete session;
+                continue;
+            }
+            hero->setCinematic(1);
+            hero->SetAtLoginFlag(AT_LOGIN_NONE);
+            hero->SaveToDB();
+            uint32 const guid = hero->GetGUIDLow();
+            delete hero;
+            delete session;
+
+            // the Darnassus inn, and her hearthstone set there
+            CharacterDatabase.PExecute("UPDATE `characters` SET `map` = 1, `position_x` = '10126.5', `position_y` = '2226.0', `position_z` = '1328.81', `orientation` = '2.2', `zone` = 1657 WHERE `guid` = '%u'", guid);
+            CharacterDatabase.PExecute("REPLACE INTO `character_homebind` (`guid`, `map`, `zone`, `position_x`, `position_y`, `position_z`) VALUES ('%u', 1, 1657, '10126.5', '2226.0', '1328.81')", guid);
+            CharacterDatabase.PExecute("INSERT INTO `ai_playerbot_db_store` (`guid`, `preset`, `key`, `value`) VALUES ('%u', 'zelda', 'herolevel', '%u')", guid, HERO_LEVEL);
+            {
+                std::lock_guard<std::mutex> guard(s_heroLock);
+                s_pendingHeroes.insert(guid);
+            }
+            ++created;
+            sLog.outString("Zelda: created %s (guid %u) on the account %s", def.name, guid, accountName.c_str());
+        }
+
+        if (auto result = CharacterDatabase.Query("SELECT `guid` FROM `ai_playerbot_db_store` WHERE `preset` = 'zelda' AND `key` = 'herolevel'"))
+        {
+            std::lock_guard<std::mutex> guard(s_heroLock);
+            do
+                s_pendingHeroes.insert(result->Fetch()[0].GetUInt32());
+            while (result->NextRow());
+        }
+
+        if (created)
+        {
+            uint32 count = created;
+            if (auto result = CharacterDatabase.PQuery("SELECT COUNT(*) FROM characters WHERE account = '%u'", accountId))
+                count = std::max<uint32>(count, result->Fetch()[0].GetUInt32());
+            LoginDatabase.PExecute("DELETE FROM realmcharacters WHERE acctid = '%u' AND realmid = '%u'", accountId, realmID);
+            LoginDatabase.PExecute("INSERT INTO realmcharacters (numchars, acctid, realmid) VALUES (%u, %u, %u)", count, accountId, realmID);
+        }
+    }
+}
