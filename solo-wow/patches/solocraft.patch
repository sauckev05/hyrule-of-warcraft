+
+static void KeepCompanionsClose(Player* player, ZeldaState& state)
+{
+    uint32 const now = WorldTimer::getMSTime();
+
+    // Navi comes with her light and goes when it is taken off
+    if (WearsNavisLight(player))
+        state.followerEntry[NAVI_INDEX] = NAVI_ENTRY;
+    else if (state.followerEntry[NAVI_INDEX])
+    {
+        if (Creature* navi = NaviOf(player, state))
+            navi->ForcedDespawn();
+        state.followerEntry[NAVI_INDEX] = 0;
+        state.followerGuid[NAVI_INDEX] = ObjectGuid();
+    }
+
+    for (uint32 i = 0; i < COMPANION_COUNT; ++i)
+    {
+        if (!state.followerEntry[i])
+            continue;
+        Creature* follower = state.followerGuid[i] ? player->GetMap()->GetCreature(state.followerGuid[i]) : nullptr;
+        if (follower && follower->IsInWorld())
+        {
+            // left far behind (her part of the world went to sleep): she catches up at once
+            if (follower->IsAlive() && !follower->IsInCombat() && !follower->IsWithinDistInMap(player, 50.0f))
+            {
+                float x, y, z;
+                player->GetNearPoint(player, x, y, z, 0.0f, 2.0f, player->GetOrientation() + M_PI_F);
+                follower->NearTeleportTo(x, y, z, player->GetOrientation());
+            }
+            continue;                               // with you (alive or fallen)
+        }
+        if (state.followerBackAt[i] && now < state.followerBackAt[i])
+            continue;                               // she'll catch up after she recovers
+        // new map, dungeon, or she fell: she rejoins at your side
+        float x, y, z;
+        player->GetNearPoint(player, x, y, z, 0.0f, 2.0f, player->GetOrientation() + M_PI_F);
+        if (Creature* summoned = player->SummonCreature(state.followerEntry[i], x, y, z, player->GetOrientation(), TEMPSPAWN_CORPSE_TIMED_DESPAWN, 10000))
+            state.followerGuid[i] = summoned->GetObjectGuid();
+        state.followerBackAt[i] = 0;
+    }
+}
