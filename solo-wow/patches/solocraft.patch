@@ -158,6 +159,39 @@ void AuctionHouseBot::Initialize()
 
 void AuctionHouseBot::Update()
 {
+    // Zelda of Warcraft: every in-game day the auction houses restock: the bot's unbid auctions
+    // go and new goods (other weapons, armor and the rest) take their place
+    static uint32 s_day = 0;
+    static bool s_restocking = false;
+    if (!s_restocking && ZeldaAuctionDailyRestock())
+    {
+        uint32 const day = ZeldaGameDayIndex(time(nullptr));
+        if (s_day == 0)
+            s_day = day;
+        else if (day != s_day)
+        {
+            s_day = day;
