+    // tenths of breath left while holding it underwater (10 = full / breathing air)
+    int32 BreathStep(Player const* player)
+    {
+        MirrorTimer const& breath = player->GetMirrorTimer(MirrorTimer::BREATH);
+        if (!breath.IsActive() || breath.IsRegenerating() || !breath.GetDuration())
+            return 10;
+        return int32(std::ceil(10.0f * float(breath.GetRemaining()) / float(breath.GetDuration())));
+    }
+}
+
+float ZeldaSpeedFactor(Player* player, uint32 moveType)
+{
+    if (!player)
+        return 1.0f;
+    if (moveType == MOVE_SWIM)
+    {
+        // a fast swimmer, who slows down as the breath runs out
+        static float const swimRate = std::max(0.1f, sConfig.GetFloatDefault("Zelda.SwimSpeedRate", 2.0f));
+        static float const swimMin = std::max(0.1f, sConfig.GetFloatDefault("Zelda.SwimSpeedOutOfBreath", 0.6f));
+        float const breath = std::min(10, std::max(0, BreathStep(player))) / 10.0f;
+        return swimMin + (swimRate - swimMin) * breath;
+    }
+    if (moveType != MOVE_RUN)
+        return 1.0f;
+    if (StateFor(player).shield)
+        return 0.45f;                           // shield up: a careful walk, whatever the run speed
+    static float const runRate = std::max(0.1f, sConfig.GetFloatDefault("Zelda.RunSpeedRate", 1.3f));
+    static float const sprintRate = std::max(0.1f, sConfig.GetFloatDefault("Zelda.SprintSpeedRate", 2.0f));
+    return StateFor(player).sprinting ? sprintRate : runRate;
+}
