+bool ZeldaBattlegroundQuestSpent(Player* player, Quest const* quest)
+{
+    if (!player || !quest)
+        return false;
+    // the battlegrounds this quest belongs to: by its marks, its zone, or the reputation it gives
+    bool any = false;
+    for (ZeldaBgInfo const& bg : ZELDA_BGS)
+    {
+        bool belongs = quest->GetZoneOrSort() == bg.zone;
+        for (uint8 i = 0; i < QUEST_ITEM_OBJECTIVES_COUNT; ++i)
+            belongs = belongs || quest->ReqItemId[i] == bg.mark;
+        for (uint32 i = 0; i < QUEST_REPUTATIONS_COUNT; ++i)
+            belongs = belongs || (quest->RewRepFaction[i] && (quest->RewRepFaction[i] == bg.alliance ||
+                                                               quest->RewRepFaction[i] == bg.horde));
+        if (!belongs)
+            continue;
+        if (!ExaltedFor(player, bg))
+            return false;
+        any = true;
+    }
+    return any;
+}
