+// Falling through the world (Zelda.UnderWorldRescue, default on): a hero who has been falling for
+// over a second and a half with no floor anywhere below and under the land's surface is put back on
+// the last spot it stood on (or on the surface right above when there is none).
+static void ZeldaUnderWorldRescue(Player* player, ZeldaState& state, uint32 diff)
+{
+    static bool const on = sConfig.GetBoolDefault("Zelda.UnderWorldRescue", true);
+    if (!on || !player->IsInWorld() || player->IsBeingTeleported() || player->IsTaxiFlying() ||
+        player->GetTransport() || (!player->IsAlive() && !player->HasFlag(PLAYER_FLAGS, PLAYER_FLAGS_GHOST)))
+    {
+        state.fallingSince = 0;
+        return;
+    }
+    state.rescueCheckIn = state.rescueCheckIn > diff ? state.rescueCheckIn - diff : 0;
+    if (state.rescueCheckIn)
+        return;
+    state.rescueCheckIn = 250;
+
+    uint32 const now = WorldTimer::getMSTime();
+    float const x = player->GetPositionX(), y = player->GetPositionY(), z = player->GetPositionZ();
+    uint32 const mapId = player->GetMapId();
+    if (!player->IsFalling() || player->IsInWater())
+    {
+        state.fallingSince = 0;
+        // standing on something: remember it
+        float const ground = player->GetMap()->GetHeight(x, y, z + 2.0f);
+        if (ground > INVALID_HEIGHT && std::fabs(ground - z) < 3.0f)
+        {
+            state.safeMap = mapId;
+            state.safeX = x;
+            state.safeY = y;
+            state.safeZ = z;
+            state.safeO = player->GetOrientation();
+        }
+        return;
+    }
+    if (!state.fallingSince)
+        state.fallingSince = now;
+    if (WorldTimer::getMSTimeDiff(state.fallingSince, now) < 1500)
+        return;
+
+    // a floor somewhere below (a cave, a deep drop): a real fall
+    float const floor = VMAP::VMapFactory::createOrGetVMapManager()->getHeight(mapId, x, y, z + 2.0f, 2000.0f);
+    if (floor > INVALID_HEIGHT)
+        return;
+    float const surface = player->GetMap()->GetTerrain()->GetHeightStatic(x, y, z, false);
+    if (surface > INVALID_HEIGHT && z > surface - 2.0f)
+        return;                             // above the land: it will land on it
+
+    state.fallingSince = 0;
+    if (state.safeMap == mapId)
+        player->TeleportTo(mapId, state.safeX, state.safeY, state.safeZ + 0.5f, state.safeO);
+    else if (surface > INVALID_HEIGHT)
+        player->TeleportTo(mapId, x, y, surface + 1.0f, player->GetOrientation());
+    else
+        player->TeleportToHomebind();
+    ChatHandler(player).PSendSysMessage("|cff33ff99You fell through the world - back to solid ground.|r");
+}
+
+// Zelda.DoneQuests "Name:quest,quest,... Name2:..." - quests a hero has already done (a dungeon
+// cleared before its story quest came along): once taken, their objectives fill and they are ready
+// to hand in. Kale has Faelin's four dungeon quests (Wailing Caverns, Blackfathom Deeps, Razorfen
+// Kraul, Gnomeregan).
+static void ZeldaDoneQuests(Player* player)
+{
+    static std::string const list = sConfig.GetStringDefault("Zelda.DoneQuests", "Kale:90208,90203,90209,90210");
+    std::istringstream in(list);
+    std::string word;
+    while (in >> word)
+    {
+        size_t const colon = word.find(':');
+        if (colon == std::string::npos || word.substr(0, colon) != player->GetName())
+            continue;
+        std::istringstream ids(word.substr(colon + 1));
+        std::string idText;
+        while (std::getline(ids, idText, ','))
+        {
+            uint32 const questId = uint32(std::strtoul(idText.c_str(), nullptr, 10));
+            Quest const* quest = questId ? sObjectMgr.GetQuestTemplate(questId) : nullptr;
+            if (!quest || player->GetQuestStatus(questId) != QUEST_STATUS_INCOMPLETE)
+                continue;
+            for (uint8 i = 0; i < QUEST_OBJECTIVES_COUNT; ++i)
+            {
+                int32 const target = quest->ReqCreatureOrGOId[i];
+                uint32 const count = quest->ReqCreatureOrGOCount[i];
+                if (target > 0 && !quest->ReqSpell[i])
+                    if (CreatureInfo const* info = ObjectMgr::GetCreatureTemplate(uint32(target)))
+                        for (uint32 n = 0; n < count; ++n)
+                            player->KilledMonster(info, nullptr);
+            }
+            if (player->GetQuestStatus(questId) == QUEST_STATUS_INCOMPLETE)
+                player->CompleteQuest(questId);
+            ChatHandler(player).PSendSysMessage("|cff33ff99%s: you have done this one already - it is complete.|r",
+                                                quest->GetTitle().c_str());
+        }
+    }
+}
