+// ---------------------------------------------------------------- personal crest
+// A hero without a guild designs a crest of her own at a tabard vendor; the Universal Tabard
+// (the old Guild Tabard) shows it. The client is told with a hidden "ZCREST:a;b;c;d;e" line
+// (all -1 for none); the ZeldaHUD addon asks with .zcrest on entering the world.
+static void SendPersonalCrest(Player* player)
+{
+    std::string crest = "-1;-1;-1;-1;-1";
+    if (auto result = CharacterDatabase.PQuery("SELECT `value` FROM `ai_playerbot_db_store` WHERE `guid` = '%u' AND `preset` = 'zelda' AND `key` = 'crest'",
+                                               player->GetGUIDLow()))
+        crest = (*result)[0].GetCppString();
+    ChatHandler(player).PSendSysMessage("ZCREST:%s", crest.c_str());
+}
+
+void ZeldaSetPersonalCrest(Player* player, uint32 emblemStyle, uint32 emblemColor, uint32 borderStyle,
+                           uint32 borderColor, uint32 backgroundColor)
+{
+    char value[64];
+    snprintf(value, sizeof(value), "%u;%u;%u;%u;%u", emblemStyle, emblemColor, borderStyle, borderColor, backgroundColor);
+    CharacterDatabase.PExecute("DELETE FROM `ai_playerbot_db_store` WHERE `guid` = '%u' AND `preset` = 'zelda' AND `key` = 'crest'",
+                               player->GetGUIDLow());
+    CharacterDatabase.PExecute("INSERT INTO `ai_playerbot_db_store` (`guid`, `preset`, `key`, `value`) VALUES ('%u', 'zelda', 'crest', '%s')",
+                               player->GetGUIDLow(), value);
+    ChatHandler(player).PSendSysMessage("ZCREST:%s", value);
+    ChatHandler(player).SendSysMessage("|cff33ff99Your crest is made. Wear a Universal Tabard to show it.|r");
+}
