+static void ZeldaSoloBattleground(Player* player, ZeldaState& state, uint32 diff)
+{
+    BattleGround* bg = player->InBattleGround() ? player->GetBattleGround() : nullptr;
+    bool const inBg = bg && player->IsInWorld() && player->GetMap()->IsBattleGround();
+    SetCrossFactionSuspended(player, state, inBg);
+    if (!inBg || !ZeldaSoloBattlegrounds())
+    {
+        if (state.bgInstance)
+            ClearBgArmies(player, state);
+        return;
+    }
+    if (state.bgInstance != player->GetInstanceId())
+    {
+        ClearBgArmies(player, state);
+        state.bgInstance = player->GetInstanceId();
+        state.bgWaveTimer = 5000;
+        state.bgTickTimer = 0;
+    }
+    if (bg->GetStatus() != STATUS_IN_PROGRESS)
+    {
+        bool const armies = !state.bgSoldiers.empty() || state.bgBoss[0] || state.bgBoss[1] ||
+                            std::any_of(std::begin(state.bgGuards), std::end(state.bgGuards),
+                                        [](ObjectGuid const& g) { return bool(g); });
+        if (bg->GetStatus() == STATUS_WAIT_LEAVE && armies)
+            ClearBgArmies(player, state), state.bgInstance = player->GetInstanceId();
+        return;
+    }
+    BgLayout const* layout = nullptr;
+    for (BgLayout const& l : BgLayouts())
+        if (l.map == player->GetMapId())
+            layout = &l;
+    if (!layout)
+        return;
+
+    state.bgTickTimer -= int32(diff);
+    if (state.bgTickTimer > 0)
+        return;
+    int32 const step = 2000 - state.bgTickTimer;
+    state.bgTickTimer = 2000;
+    Map* map = player->GetMap();
+    uint32 const now = WorldTimer::getMSTime();
+
+    // the soldiers still standing keep marching; the fallen are forgotten
+    uint32 alive = 0;
+    for (auto itr = state.bgSoldiers.begin(); itr != state.bgSoldiers.end();)
+    {
+        Creature* c = map->GetAnyTypeCreature(*itr);
+        if (!c || !c->IsAlive())
+        {
+            itr = state.bgSoldiers.erase(itr);
+            continue;
+        }
+        ++alive;
+        if (!c->IsInCombat() && !c->IsMoving() &&
+            c->GetMotionMaster()->GetCurrentMovementGeneratorType() == IDLE_MOTION_TYPE)
+        {
+            BgPoint const& to = c->GetEntry() == BG_SOLDIER_ALLIANCE ? layout->horde : layout->alliance;
+            if (!c->IsWithinDist3d(to.x, to.y, to.z, 12.0f))
+                c->GetMotionMaster()->MovePoint(1, to.x, to.y, to.z);
+        }
+        ++itr;
+    }
+
+    // the next wave, from both bases
+    state.bgWaveTimer -= step;
+    if (state.bgWaveTimer <= 0)
+    {
+        state.bgWaveTimer = layout->waveMs;
+        for (uint32 i = 0; i < layout->waveSize && state.bgSoldiers.size() + 2 <= BG_MAX_SOLDIERS; ++i)
+        {
+            if (Creature* a = SpawnBgUnit(player, BG_SOLDIER_ALLIANCE, layout->alliance, &layout->horde, 0))
+                state.bgSoldiers.push_back(a->GetObjectGuid());
+            if (Creature* h = SpawnBgUnit(player, BG_SOLDIER_HORDE, layout->horde, &layout->alliance, 0))
+                state.bgSoldiers.push_back(h->GetObjectGuid());
+        }
+        if (alive == 0)
+            player->GetSession()->SendAreaTriggerMessage("|cffffcc33The armies march! Soldiers pour out of both bases.|r");
+    }
+
+    // the base champions, standing at each base's entrance where the other side's soldiers march
+    // to: the side whose champion falls first loses (the flags or banners can still win it first)
+    if (layout->champions)
+    {
+        for (uint32 side = 0; side < 2; ++side)
+        {
+            if (!state.bgBoss[side])
+            {
+                if (Creature* champ = SpawnBgUnit(player, side == 0 ? BG_CHAMPION_ALLIANCE : BG_CHAMPION_HORDE,
+                                                  side == 0 ? layout->alliance : layout->horde,
+                                                  layout->flagWar ? &layout->middle[side] : nullptr, 3))
+                    state.bgBoss[side] = champ->GetObjectGuid();
+                continue;
+            }
+            Creature* champ = map->GetAnyTypeCreature(state.bgBoss[side]);
+            if (champ && champ->IsAlive())
+                continue;
+            Team const winner = side == 0 ? HORDE : ALLIANCE;
+            std::string const fallen = champ ? champ->GetName() : (side == 0 ? "The Alliance champion" : "The Horde champion");
+            player->GetSession()->SendAreaTriggerMessage("|cffffcc33%s has fallen! The %s wins the battle!|r", fallen.c_str(),
+                                                         winner == ALLIANCE ? "Alliance" : "Horde");
+            bg->EndBattleGround(winner);
+            // everything the armies left behind goes at once: a soldier or champion left standing
+            // away from its "home" (the far base, the middle) would be moved there when the map
+            // unloads its grids, loading new ones after the battleground is gone
+            ClearBgArmies(player, state);
+            state.bgInstance = player->GetInstanceId();
+            return;
+        }
+    }
+
+    // Warsong Gulch: each side's army grows with the flags it has captured (world states 1581, 1582)
+    if (layout->flagWar)
+    {
+        uint32 const flags[2] = { uint32(std::max(0, bg->GetBgMap()->GetVariableManager().GetVariable(1581))),
+                                  uint32(std::max(0, bg->GetBgMap()->GetVariableManager().GetVariable(1582))) };
+        auto strengthen = [&](ObjectGuid const& guid)
+        {
+            Creature* c = guid ? map->GetAnyTypeCreature(guid) : nullptr;
+            if (!c || !c->IsAlive())
+                return;
+            uint32 const want = flags[IsAllianceArmy(c->GetEntry()) ? 0 : 1];
+            uint32& have = state.bgMight[guid.GetRawValue()];
+            SetFlagMight(c, have, want);
+            have = want;
+        };
+        for (ObjectGuid const& guid : state.bgSoldiers)
+            strengthen(guid);
+        for (ObjectGuid const& guid : state.bgGuards)
+            strengthen(guid);
+        for (ObjectGuid const& guid : state.bgBoss)
+            strengthen(guid);
+        for (uint32 side = 0; side < 2; ++side)
+            if (flags[side] > state.bgMightTold[side])
+            {
+                state.bgMightTold[side] = flags[side];
+                player->GetSession()->SendAreaTriggerMessage("|cffffcc33The %s army grows stronger: +%u%% health, armor and damage!|r",
+                                                             side == 0 ? "Alliance" : "Horde", uint32(BG_FLAG_MIGHT_PCT * flags[side]));
+            }
+    }
+
+    // the guards: one each, back a while after falling
+    for (size_t i = 0; i < layout->guards.size() && i < 8; ++i)
+    {
+        Creature* g = state.bgGuards[i] ? map->GetAnyTypeCreature(state.bgGuards[i]) : nullptr;
+        if (g && g->IsAlive())
+            continue;
+        if (state.bgGuards[i] && !state.bgGuardDeadAt[i])
+            state.bgGuardDeadAt[i] = now ? now : 1;
+        if (state.bgGuards[i] && now - state.bgGuardDeadAt[i] < uint32(layout->guardRespawnMs))
+            continue;
+        if (Creature* fresh = SpawnBgUnit(player, layout->guards[i].first, layout->guards[i].second, nullptr, 2))
+        {
+            if (state.bgGuards[i])
+                player->GetSession()->SendAreaTriggerMessage("|cffff4040%s has returned!|r", fresh->GetName());
+            state.bgGuards[i] = fresh->GetObjectGuid();
+            state.bgGuardDeadAt[i] = 0;
+        }
+    }
+}
