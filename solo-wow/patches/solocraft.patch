+bool ZeldaDungeonRelease(Player* player)
+{
+    static bool const enabled = sConfig.GetBoolDefault("Zelda.DungeonReleaseAtEntrance", true);
+    static float const health = std::min(1.0f, std::max(0.01f, sConfig.GetFloatDefault("Zelda.DungeonReleaseHealth", 0.05f)));
+    if (!enabled || !player || player->IsAlive() || !player->IsInWorld() || !player->GetMap()->IsDungeon())
+        return false;
+
+    ZeldaState& state = StateFor(player);
+    float x, y, z, o;
+    if (state.entryMap == player->GetMapId() && state.entryInstance == player->GetInstanceId())
+    {
+        x = state.entryX; y = state.entryY; z = state.entryZ; o = state.entryO;
+    }
+    else if (AreaTrigger const* at = sObjectMgr.GetMapEntranceTrigger(player->GetMapId()))
+    {
+        x = at->target_X; y = at->target_Y; z = at->target_Z; o = at->target_Orientation;
+    }
+    else
+        return false;
+
+    player->RemovePet(PET_SAVE_REAGENTS);
+    player->ResurrectPlayer(health);
+    player->NearTeleportTo(x, y, z, o);
+    ChatHandler(player).SendSysMessage("|cff33ff99You wake up at the entrance, battered but alive.|r");
+    return true;
+}
