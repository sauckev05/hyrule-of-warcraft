+uint32 ZeldaModifyIncomingDamage(Player* victim, Unit* attacker, uint32 damage)
+{
+    if (!victim || damage == 0)
+        return damage;
+
+    ZeldaState state;
+    {
+        std::lock_guard<std::mutex> guard(s_statesLock);
+        auto itr = s_states.find(victim->GetGUIDLow());
+        if (itr == s_states.end())
+            return damage;
+        state = itr->second;
+    }
+    if (WorldTimer::getMSTime() < state.invulnerableUntil)
+        return 0; // rolled through it
+
+    if (state.shield && attacker && attacker != victim && victim->HasInArc(attacker, M_PI_F * 2.0f / 3.0f))
+        damage = damage / 5; // blocked with the shield: 80% less
+
+    // the Arena Grand Master: a blow that leaves the hero under 10% raises its shield by itself
+    uint32 const health = victim->GetHealth();
+    if (damage >= health || health - damage <= victim->GetMaxHealth() / 10)
+    {
+        static uint32 const ARENA_GRAND_MASTER = 19024;
+        static uint32 const AURA_OF_PROTECTION = 23506;            // absorbs 750 damage for 20 sec
+        static time_t const cooldown = std::max(0, sConfig.GetIntDefault("Zelda.ArenaGrandMasterCooldown", 300));
+        if (victim->IsAlive() && victim->HasItemWithIdEquipped(ARENA_GRAND_MASTER, 1))
+        {
+            ZeldaState& live = StateFor(victim);
+            time_t const now = time(nullptr);
+            if (now >= live.grandMasterReadyAt)
+            {
+                live.grandMasterReadyAt = now + cooldown;
+                victim->CastSpell(victim, AURA_OF_PROTECTION, TRIGGERED_OLD_TRIGGERED);
+                damage -= std::min<uint32>(damage, 750);      // this blow is the first it stops
+                victim->GetSession()->SendAreaTriggerMessage("Arena Grand Master: the champion's shield saves you!");
+            }
+        }
+    }
+
+    return damage;
+}
