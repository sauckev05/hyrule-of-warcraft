+
+static void KeepCompanionsClose(Player* player, ZeldaState& state)
+{
+    uint32 const now = WorldTimer::getMSTime();
+
+    // Navi comes with her light and goes when it is taken off
+    if (WearsNavisLight(player))
+        state.followerEntry[NAVI_INDEX] = NAVI_ENTRY;
+    else if (state.followerEntry[NAVI_INDEX])
+    {
+        if (Creature* navi = NaviOf(player, state))
+            navi->ForcedDespawn();
+        state.followerEntry[NAVI_INDEX] = 0;
+        state.followerGuid[NAVI_INDEX] = ObjectGuid();
+    }
+
+    for (uint32 i = 0; i < COMPANION_COUNT; ++i)
+    {
+        if (!state.followerEntry[i])
+            continue;
+        Creature* follower = state.followerGuid[i] ? player->GetMap()->GetCreature(state.followerGuid[i]) : nullptr;
+        if (follower && follower->IsInWorld())
+        {
+            // left far behind (her part of the world went to sleep): she catches up at once
+            if (follower->IsAlive() && !follower->IsInCombat() && !follower->IsWithinDistInMap(player, 50.0f))
+            {
+                float x, y, z;
+                player->GetNearPoint(player, x, y, z, 0.0f, 2.0f, player->GetOrientation() + M_PI_F);
+                follower->NearTeleportTo(x, y, z, player->GetOrientation());
+            }
+            continue;                               // with you (alive or fallen)
+        }
+        if (state.followerBackAt[i] && now < state.followerBackAt[i])
+            continue;                               // she'll catch up after she recovers
+        // new map, dungeon, or she fell: she rejoins at your side
+        float x, y, z;
+        player->GetNearPoint(player, x, y, z, 0.0f, 2.0f, player->GetOrientation() + M_PI_F);
+        if (Creature* summoned = player->SummonCreature(state.followerEntry[i], x, y, z, player->GetOrientation(), TEMPSPAWN_CORPSE_TIMED_DESPAWN, 10000))
+            state.followerGuid[i] = summoned->GetObjectGuid();
+        state.followerBackAt[i] = 0;
+    }
+}
+
+void ZeldaPlayerUpdate(Player* player, uint32 diff)
+{
+    if (!player)
+        return;
+
+    ZeldaState& state = StateFor(player);
+
+    // once per login: the faster run speed, and friends on the other side
+    if (state.speedAppliedFor != player && player->IsInWorld())
+    {
+        state.speedAppliedFor = player;
+        player->UpdateSpeed(MOVE_RUN, true);
+        ApplyCrossFaction(player);
+        ZeldaHeroFirstLogin(player);
+    }
+
+    // running without stopping for a while turns into a sprint; stopping ends it
+    {
+        static uint32 const sprintAfter = uint32(std::max(0, sConfig.GetIntDefault("Zelda.SprintAfterSeconds", 15))) * 1000;
+        uint32 const now = WorldTimer::getMSTime();
+        bool const running = player->IsAlive() && player->IsMoving() && !player->IsWalking() && !player->IsTaxiFlying() &&
+                             !state.shield && player->IsInWorld();
+        if (running)
+        {
+            if (!state.runningSince)
+                state.runningSince = now ? now : 1;
+            else if (!state.sprinting && now - state.runningSince >= sprintAfter)
+            {
+                state.sprinting = true;
+                player->UpdateSpeed(MOVE_RUN, true);
+            }
+        }
+        else if (state.runningSince)
+        {
+            state.runningSince = 0;
+            if (state.sprinting)
+            {
+                state.sprinting = false;
+                if (player->IsInWorld())
+                    player->UpdateSpeed(MOVE_RUN, true);
+            }
+        }
+    }
+
+    // leaving a five-player dungeon resets it (raids keep their weekly lockout)
+    if (player->IsInWorld() && !player->IsBeingTeleported())
+    {
+        MapEntry const* entry = sMapStore.LookupEntry(player->GetMapId());
+        uint32 const dungeon = (entry && entry->map_type == MAP_INSTANCE) ? player->GetMapId() : 0;
+        if (state.inDungeonMap && state.inDungeonMap != dungeon)
+            state.pendingDungeonReset = true;
+        state.inDungeonMap = dungeon;
+    }
+
+    // remember where the hero came into a dungeon or raid: releasing there brings them back to it
+    if (player->IsInWorld() && !player->IsBeingTeleported() && player->IsAlive() && player->GetMap()->IsDungeon() &&
+        (state.entryMap != player->GetMapId() || state.entryInstance != player->GetInstanceId()))
+    {
+        state.entryMap = player->GetMapId();
+        state.entryInstance = player->GetInstanceId();
+        state.entryX = player->GetPositionX();
+        state.entryY = player->GetPositionY();
+        state.entryZ = player->GetPositionZ();
+        state.entryO = player->GetOrientation();
+    }
+
+    // swimming slows as the breath runs out
+    if (player->IsInWorld())
+    {
+        int32 const step = BreathStep(player);
+        if (step != state.swimStep)
+        {
+            state.swimStep = step;
+            player->UpdateSpeed(MOVE_SWIM, true);
+        }
+    }
+
+    // a flight path: the companions and Navi wait at the other end (they come back on landing)
+    if (player->IsTaxiFlying() && player->IsInWorld())
+    {
+        for (uint32 i = 0; i < COMPANION_COUNT; ++i)
+        {
+            if (!state.followerGuid[i])
+                continue;
+            if (Creature* follower = player->GetMap()->GetCreature(state.followerGuid[i]))
+                follower->ForcedDespawn();
+            state.followerGuid[i] = ObjectGuid();
+            state.followerBackAt[i] = 0;
+        }
+    }
+
+    if (state.shoutCheckIn > diff)
+    {
+        state.shoutCheckIn -= diff;
+        return;
+    }
+    state.shoutCheckIn = 2000;
+
+    if (player->IsInWorld())
+        UpdateSetBonuses(player, state);
+
+    if (!player->IsAlive() || player->IsTaxiFlying() || player->IsBeingTeleported() || !player->IsInWorld())
+        return;
+
+    KeepCompanionsClose(player, state);
+
+    // Navi's Light: 25% of the hero's health every 10 seconds while fighting
+    static uint32 const healEvery = uint32(std::max(1, sConfig.GetIntDefault("Zelda.NaviHealSeconds", 10))) * 1000;
+    if (player->IsInCombat() && player->GetHealth() < player->GetMaxHealth() && WearsNavisLight(player) && (!state.naviHealReadyAt ||
+        int32(WorldTimer::getMSTime() - state.naviHealReadyAt) >= 0))
+    {
+        state.naviHealReadyAt = WorldTimer::getMSTime() + healEvery;
+        static uint32 const healPct = sConfig.GetIntDefault("Zelda.NaviHealPercent", 25);
+        uint32 const amount = std::max<uint32>(1, player->GetMaxHealth() * healPct / 100);
+        if (SpellEntry const* healInfo = sSpellTemplate.LookupEntry<SpellEntry>(NAVI_HEAL_VISUAL))
+            player->DealHeal(player, amount, healInfo);
+        else
+            player->ModifyHealth(int32(amount));
+        std::vector<ObjectGuid> self;
+        self.push_back(player->GetObjectGuid());
+        PlaySpellVisual(player, NAVI_HEAL_VISUAL, self);
+    }
+
+    static bool const passiveShout = sConfig.GetBoolDefault("Zelda.PassiveBattleShout", true);
+    if (!passiveShout)
+        return;
+
+    // the best Battle Shout the hero has learned, highest rank first
+    static uint32 const ranks[] = { 25289, 11551, 11550, 11549, 6192, 5242, 6673 };
+    uint32 shout = 0;
+    for (uint32 id : ranks)
+    {
+        if (player->HasSpell(id))
+        {
+            shout = id;
+            break;
+        }
+    }
+    if (!shout)
+        return;
+
+    SpellAuraHolder* holder = player->GetSpellAuraHolder(shout, player->GetObjectGuid());
+    if (!holder)
+    {
+        player->CastSpell(player, shout, TRIGGERED_OLD_TRIGGERED | TRIGGERED_IGNORE_COSTS | TRIGGERED_IGNORE_GCD | TRIGGERED_IGNORE_COOLDOWNS);
+        holder = player->GetSpellAuraHolder(shout, player->GetObjectGuid());
+    }
+    // it never runs out: a passive, not a 2 minute buff
+    if (holder && holder->GetAuraMaxDuration() != -1)
+    {
+        holder->SetAuraMaxDuration(-1);
+        holder->SetAuraDuration(-1);
+        holder->UpdateAuraDuration();
+    }
+}
