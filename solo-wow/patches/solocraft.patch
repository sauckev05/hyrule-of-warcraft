+// ---------------------------------------------------------------------------------- gifts
+// Items handed to a character once (Zelda.Gifts: "Name:item Name:item ..."), into the bags or,
+// when they are full, by mail from Navi; marker 'gift:<item>' per character.
+static void ZeldaGifts(Player* player)
+{
+    static std::string const gifts = sConfig.GetStringDefault("Zelda.Gifts", "Kale:6975 Kale:191140");
+    std::istringstream in(gifts);
+    std::string word;
+    while (in >> word)
+    {
+        size_t const colon = word.find(':');
+        if (colon == std::string::npos || word.substr(0, colon) != player->GetName())
+            continue;
+        uint32 const itemId = uint32(std::strtoul(word.c_str() + colon + 1, nullptr, 10));
+        ItemPrototype const* proto = sObjectMgr.GetItemPrototype(itemId);
+        if (!proto)
+            continue;
+        std::string const key = "gift:" + std::to_string(itemId);
+        if (CharacterDatabase.PQuery("SELECT 1 FROM `ai_playerbot_db_store` WHERE `guid` = '%u' AND `preset` = 'zelda' AND `key` = '%s'",
+                                     player->GetGUIDLow(), key.c_str()))
+            continue;
+        CharacterDatabase.PExecute("INSERT INTO `ai_playerbot_db_store` (`guid`, `preset`, `key`, `value`) VALUES ('%u', 'zelda', '%s', '1')",
+                                   player->GetGUIDLow(), key.c_str());
+        ItemPosCountVec dest;
+        if (player->CanStoreNewItem(NULL_BAG, NULL_SLOT, dest, itemId, 1) == EQUIP_ERR_OK)
+        {
+            if (Item* item = player->StoreNewItem(dest, itemId, true, Item::GenerateItemRandomPropertyId(itemId)))
+                player->SendNewItem(item, 1, true, false);
+            ChatHandler(player).PSendSysMessage("|cff33ff99Your %s is back in your bags.|r", proto->Name1);
+        }
+        else if (Item* item = Item::CreateItem(itemId, 1, player))
+        {
+            CharacterDatabase.BeginTransaction();
+            item->SaveToDB();
+            CharacterDatabase.CommitTransaction();
+            MailDraft(proto->Name1, "Hey! Listen! You dropped this - your bags were full, so here it is.")
+                .AddItem(item).SendMailTo(player, MailSender(MAIL_CREATURE, uint32(190601)), MAIL_CHECK_MASK_COPIED);
+            ChatHandler(player).PSendSysMessage("|cff33ff99Your bags are full: your %s was sent to your mailbox.|r", proto->Name1);
+        }
+    }
+}
