+bool ZeldaStageHidden(Creature const* creature, Player const* player)
+{
+    if (!creature || !player || creature->IsTemporarySummon())
+        return false;
+    // a companion travelling with this hero is not also standing at her usual spot; sent home, she
+    // is there again at once
+    uint32 const entry = creature->GetEntry();
+    if ((entry >= 190100 && entry < 190500) || entry == 190701)
+    {
+        std::lock_guard<std::mutex> guard(s_statesLock);
+        auto st = s_states.find(player->GetGUIDLow());
+        if (st != s_states.end())
+            for (uint32 followerEntry : st->second.followerEntry)
+                if (followerEntry && followerEntry / 100 == entry / 100)
+                    return true;
+    }
+    auto itr = s_stages.find(creature->GetEntry());
+    if (itr == s_stages.end())
+        return false;
+    StageRule const& rule = itr->second;
+    if (rule.showQuest && !QuestReached(player, rule.showQuest, rule.showState))
+        return true;
+    if (rule.hideQuest && QuestReached(player, rule.hideQuest, rule.hideState))
+        return true;
+    return false;
+}
