+// A mana potion's mana becomes a shield that absorbs as much damage (Zelda.ManaPotionShield).
+static uint32 const POTION_SHIELD = 40010;     // custom (006_mastery, patch-Z): Aura of Protection's absorb, 20 sec
+
+bool ZeldaManaPotionShieldItem(ItemPrototype const* item, SpellEntry const& spell)
+{
+    static bool const on = sConfig.GetBoolDefault("Zelda.ManaPotionShield", true);
+    if (!on || !item || item->Class != ITEM_CLASS_CONSUMABLE)
+        return false;
+    uint32 category = spell.Category;
+    for (auto const& itemSpell : item->Spells)
+        if (itemSpell.SpellId == spell.Id && itemSpell.SpellCategory)
+            category = itemSpell.SpellCategory;
