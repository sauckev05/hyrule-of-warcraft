+        return index == ELARA_INDEX ? 5u : uint32(index < 0 ? 0 : index);
+    }
+
+    // where Elara likes to go, and which places she walks between (the roads join them)
+    struct Hub { char const* name; float x, y, z; std::vector<uint32> next; };
+    std::vector<Hub> const ELARA_HUBS =
+    {
+        { "Goldshire",              -9460.0f,    62.0f,  56.6f, { 1, 2, 5 } },
+        { "the Mage Quarter",       -8993.0f,   866.0f,  29.7f, { 0 } },
+        { "the Tower of Azora",     -9550.5f,  -726.0f,  99.3f, { 0, 3 } },
