+void ZeldaHeartPieceDrop(Player* looter, Creature* victim, Loot* loot)
+{
+    if (!looter || !victim || !loot || looter->GetQuestStatus(HEART_PIECE_QUEST) != QUEST_STATUS_INCOMPLETE)
