+bool ZeldaIsBattlegroundQuest(Quest const* quest)
+{
+    if (!quest)
+        return false;
+    for (uint8 i = 0; i < QUEST_ITEM_OBJECTIVES_COUNT; ++i)
+        if (quest->ReqItemId[i] == 20558 || quest->ReqItemId[i] == 20559 || quest->ReqItemId[i] == 20560)
+            return true;
+    // the quests given for the battlegrounds' own zones and factions
+    switch (quest->GetZoneOrSort())
+    {
+        case 3277: case 3358: case 2597:        // Warsong Gulch, Arathi Basin, Alterac Valley
+        case -25:                               // the "Battlegrounds" quest sort
+            return true;
+    }
+    for (uint32 i = 0; i < QUEST_REPUTATIONS_COUNT; ++i)
+        switch (quest->RewRepFaction[i])
+        {
+            case 509: case 510: case 729: case 730: case 889: case 890:
+                return true;
+        }
+    return false;
+}
