+    // reply is a system line it hides from the chat
+    Player* player = m_session->GetPlayer();
+    PSendSysMessage("ZSTATS:%.2f;%.2f;%.2f;%.2f;%.2f;%.2f;%.2f;%.2f;%u;%u;%d",
+                    player->GetCritChance(BASE_ATTACK), player->GetCritChance(RANGED_ATTACK),
