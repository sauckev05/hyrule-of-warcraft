+void ZeldaAfterMeleeHit(Unit* attacker, Unit* victim, bool hit)
+{
+    if (!hit || !attacker || !attacker->IsPlayer() || !victim || t_bonusSwing)
+        return;
+    Player* player = static_cast<Player*>(attacker);
+
+    // a solid hit sends the enemy back a step
+    float const knock = SetBonusOf(player, SET_BONUS_KNOCKBACK);
+    if (knock > 0.0f && victim->IsAlive() && roll_chance_f(knock))
+    {
+        if (victim->IsPlayer())
+            victim->KnockBackFrom(player, 6.0f, 2.0f);
+        else
+        {
+            Creature* creature = static_cast<Creature*>(victim);
+            CreatureInfo const* info = creature->GetCreatureInfo();
+            if (!creature->IsWorldBoss() && !(info && info->Rank == CREATURE_ELITE_WORLDBOSS))
+                creature->GetMotionMaster()->MovePushedBack(*player, 2.5f, 12.0f);
+        }
+    }
+
+    // and sometimes the blade swings again before the enemy can answer
+    float const extra = SetBonusOf(player, SET_BONUS_EXTRA_SWING);
+    if (extra > 0.0f && victim->IsAlive() && roll_chance_f(extra))
+    {
+        t_bonusSwing = true;
+        player->AttackerStateUpdate(victim, BASE_ATTACK, true);
+        t_bonusSwing = false;
+    }
+}
+
+void ZeldaOnKill(Player* killer, Creature* victim)
+{
+    if (!killer || !victim || !killer->IsAlive())
+        return;
+    float const pct = SetBonusOf(killer, SET_BONUS_HEAL_ON_KILL);
+    if (pct <= 0.0f || killer->GetHealth() >= killer->GetMaxHealth())
+        return;
+    CreatureInfo const* info = victim->GetCreatureInfo();
+    if (!info || info->CreatureType == CREATURE_TYPE_CRITTER || victim->GetLevel() + 8 < killer->GetLevel())
+        return;
+    uint32 const amount = std::max<uint32>(1, uint32(killer->GetMaxHealth() * pct / 100.0f));
+    if (SpellEntry const* healInfo = sSpellTemplate.LookupEntry<SpellEntry>(NAVI_HEAL_VISUAL))
+        killer->DealHeal(killer, amount, healInfo);
+    else
+        killer->ModifyHealth(int32(amount));
+}
