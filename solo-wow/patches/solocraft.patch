+struct npc_zelda_naviAI : public ScriptedAI
+{
+    npc_zelda_naviAI(Creature* creature) : ScriptedAI(creature), m_follower(creature->IsTemporarySummon())
+    {
+        if (m_follower)
+            m_ownerGuid = creature->GetSpawnerGuid();
+        Reset();
+    }
+
+    bool m_follower;
+    ObjectGuid m_ownerGuid;
+    uint32 m_chatterTimer = 0;
+    uint32 m_warnTimer = 0;
+    bool m_following = false;
+
+    void Reset() override
+    {
+        m_chatterTimer = m_follower ? urand(60000, 120000) : urand(10000, 25000);
+        m_warnTimer = 0;
+    }
+
+    // a wisp: nothing to fight, nothing to chase
+    void MoveInLineOfSight(Unit* /*who*/) override {}
+    void AttackStart(Unit* /*who*/) override {}
+
+    Player* Owner() const
+    {
+        return m_ownerGuid ? m_creature->GetMap()->GetPlayer(m_ownerGuid) : nullptr;
+    }
+
+    char const* FollowerLine(Player* owner) const
+    {
+        // she nudges the hero toward the next part of her story
+        if (owner->GetLevel() >= 45 && owner->GetQuestStatus(NAVI_QUEST_HERO) == QUEST_STATUS_NONE &&
+            owner->GetQuestRewardStatus(NAVI_QUEST_HEART) && urand(0, 1))
+            return "Hey! Listen! I feel something far to the south... a heartbeat I know. Talk to me!";
+        // any errand of hers the hero is ready for (each waits for its own level)
+        for (uint32 questId = NAVI_QUEST_HEART; questId <= NAVI_QUEST_LAST; ++questId)
+        {
+            if (questId == NAVI_QUEST_HERO || owner->GetQuestStatus(questId) != QUEST_STATUS_NONE)
+                continue;
+            Quest const* quest = sObjectMgr.GetQuestTemplate(questId);
+            if (quest && owner->CanTakeQuest(quest, false) && urand(0, 1))
+                return "Hey! Listen! I've got something to ask you! Talk to me!";
+        }
+        return PickLine(NAVI_CHATTER);
+    }
+
+    void UpdateFollower(uint32 diff, Player* owner)
+    {
+        if (!owner || !ZeldaIsCurrentFollower(owner, NAVI_FOLLOWER_INDEX, m_creature->GetObjectGuid()))
+        {
+            m_creature->ForcedDespawn();     // the hero went on without this Navi (a new one is with them)
+            return;
+        }
+        if (!m_following)
+        {
+            m_following = true;
+            m_creature->GetMotionMaster()->Clear();
+            m_creature->GetMotionMaster()->MoveFollow(owner, 1.2f, M_PI_F * 0.3f);
+        }
+        if (!m_creature->IsWithinDistInMap(owner, 25.0f) && !owner->IsTaxiFlying())
+        {
+            float x, y, z;
+            owner->GetNearPoint(owner, x, y, z, 0.0f, 1.2f, owner->GetOrientation() + M_PI_F * 0.3f);
+            m_creature->NearTeleportTo(x, y, z + 1.0f, owner->GetOrientation());
+            m_following = false;
+            return;
+        }
+        if (m_creature->GetMotionMaster()->GetCurrentMovementGeneratorType() != FOLLOW_MOTION_TYPE)
+            m_following = false;
+
+        // as fast as the hero (running, sprinting or riding), a little faster to catch up
+        float const rate = owner->GetSpeedRate(MOVE_RUN) * 1.15f;
+        if (std::fabs(m_creature->GetSpeedRate(MOVE_RUN) - rate) > 0.01f)
+        {
+            m_creature->SetSpeedRate(MOVE_RUN, rate);
+            m_creature->SetSpeedRate(MOVE_WALK, rate);
+            m_creature->SetSpeedRate(MOVE_SWIM, owner->GetSpeedRate(MOVE_SWIM) * 1.15f);
+        }
+
+        if (m_warnTimer > diff) m_warnTimer -= diff; else m_warnTimer = 0;
+        if (!m_warnTimer && owner->IsAlive() && owner->IsInCombat() && owner->GetHealthPercent() < 30.0f)
+        {
+            m_creature->MonsterSay(PickLine(NAVI_WARNINGS), LANG_UNIVERSAL, owner);
+            m_warnTimer = 20000;
+        }
+
+        if (m_chatterTimer > diff)
+        {
+            m_chatterTimer -= diff;
+            return;
+        }
+        m_chatterTimer = urand(180000, 360000);
+        if (owner->IsAlive() && !owner->IsInCombat())
+            m_creature->MonsterSay(FollowerLine(owner), LANG_UNIVERSAL, owner);
+    }
+
+    void UpdateWaiting(uint32 diff)
+    {
+        if (m_chatterTimer > diff)
+        {
+            m_chatterTimer -= diff;
+            return;
+        }
+        m_chatterTimer = urand(20000, 40000);
+        // calls out to a hero who has not yet heard her
+        Map::PlayerList const& players = m_creature->GetMap()->GetPlayers();
+        for (auto const& ref : players)
+        {
+            Player* player = ref.getSource();
+            if (player && player->IsAlive() && m_creature->IsWithinDistInMap(player, 25.0f) &&
+                !ZeldaStageHidden(m_creature, player))
+            {
+                m_creature->MonsterSay(PickLine(NAVI_CALLING), LANG_UNIVERSAL, player);
+                break;
+            }
+        }
+    }
+
+    void UpdateAI(const uint32 diff) override
+    {
+        if (m_follower)
+            UpdateFollower(diff, Owner());
+        else
+            UpdateWaiting(diff);
+    }
+};
