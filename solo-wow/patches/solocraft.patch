+// ---------------------------------------------------------------------------------- spell stats
+// Every hero fights as a warrior (ZeldaStatClass): intellect gives spell power as strength gives
+// attack power, and spirit gives spell crit as agility gives melee crit (Zelda.WarriorSpellStats).
+static bool WarriorSpellStats(Player const* player)
+{
+    static bool const on = sConfig.GetBoolDefault("Zelda.WarriorSpellStats", true);
+    return on && player && ZeldaStatClass(player) == CLASS_WARRIOR;
+}
+
+int32 ZeldaSpellPowerFromStats(Player const* player)
+{
+    static float const perIntellect = std::max(0.0f, sConfig.GetFloatDefault("Zelda.IntellectSpellPower", 2.0f));
+    if (!WarriorSpellStats(player))
+        return 0;
+    return int32(player->GetStat(STAT_INTELLECT) * perIntellect);
+}
+
+bool ZeldaSpiritSpellCrit(Player const* player)
+{
+    return WarriorSpellStats(player);
+}
+
+float ZeldaSpellCritFromSpirit(Player const* player)
+{
+    // the warrior's agility-to-crit rate: 3.9 points per 1% at level 1, 20 at level 60
+    float const level = float(player->GetLevel());
+    float const rate = 3.9f * (60.0f - level) / 59.0f + 20.0f * (level - 1.0f) / 59.0f;
+    return rate > 0.0f ? player->GetStat(STAT_SPIRIT) / rate : 0.0f;
+}
