+#include "Server/Opcodes.h"
+#include "Loot/LootMgr.h"
+#include "Spells/SpellAuras.h"
+#include "Spells/Spell.h"
+#include "VMapFactory.h"
+#include "Entities/GameObject.h"
+#include "Entities/Pet.h"
+#include "Server/DBCStores.h"
