+// ---------------------------------------------------------------------------------- enemy heavy blows
+// Enemies fighting a hero wind up a heavy blow now and then (Heavy Blow, 40011: a two-second Slam
+// windup) - casters a Charged Bolt (40012) when they are not in melee - and the hero is told in
+// front of the screen. A raised shield blocks it and staggers the enemy, a parry (no shield, melee
+// only) turns it aside and staggers it, a roll or stepping out of reach avoids it; otherwise it
+// lands for a share of the hero's health and a blow knocks the hero down (Zelda.HeavyBlows).
+static uint32 const HEAVY_BLOW = 40011;
+static uint32 const CHARGED_BOLT = 40012;
+static uint32 const HEAVY_KNOCKDOWN = 5164;    // Knockdown
+static uint32 const HEAVY_STAGGER = 7922;      // Charge Stun, held for the stagger
+
+namespace
+{
+    enum class Threat { Normal, Elite, Boss };
+
+    Threat ThreatOf(Creature const* creature)
+    {
+        CreatureInfo const* info = creature->GetCreatureInfo();
+        if (creature->IsWorldBoss() || info->Rank == CREATURE_ELITE_WORLDBOSS)
+            return Threat::Boss;
+        if (info->Rank == CREATURE_ELITE_ELITE || info->Rank == CREATURE_ELITE_RAREELITE)
+            // a dungeon's bosses carry far more health than its other elites
+            return creature->GetMap()->IsDungeon() && info->HealthMultiplier >= 5.0f ? Threat::Boss : Threat::Elite;
+        return Threat::Normal;
+    }
+
+    uint32 HeavyInterval(Threat t)
+    {
+        switch (t)
+        {
+            case Threat::Boss:  return urand(7000, 10000);
+            case Threat::Elite: return urand(9000, 14000);
+            default:            return urand(14000, 20000);
+        }
+    }
+
+    float HeavyShare(Threat t)
+    {
+        static float const normal = sConfig.GetFloatDefault("Zelda.HeavyBlowNormal", 0.20f);
+        static float const elite = sConfig.GetFloatDefault("Zelda.HeavyBlowElite", 0.30f);
+        static float const boss = sConfig.GetFloatDefault("Zelda.HeavyBlowBoss", 0.40f);
+        switch (t)
+        {
+            case Threat::Boss:  return boss;
+            case Threat::Elite: return elite;
+            default:            return normal;
+        }
+    }
+
+    bool IsCasterCreature(Creature const* creature)
+    {
+        CreatureInfo const* info = creature->GetCreatureInfo();
+        return creature->GetPowerType() == POWER_MANA && creature->GetMaxPower(POWER_MANA) > 0 &&
+               (info->UnitClass == CLASS_MAGE || info->UnitClass == CLASS_PALADIN);
+    }
+
+    void Stagger(Unit* hero, Unit* enemy, int32 ms)
+    {
+        if (!enemy->IsAlive())
+            return;
+        enemy->InterruptNonMeleeSpells(false);
+        hero->CastSpell(enemy, HEAVY_STAGGER, TRIGGERED_OLD_TRIGGERED);
+        if (SpellAuraHolder* holder = enemy->GetSpellAuraHolder(HEAVY_STAGGER, hero->GetObjectGuid()))
+        {
+            holder->SetAuraMaxDuration(ms);
+            holder->SetAuraDuration(ms);
+            holder->UpdateAuraDuration();
+        }
+    }
+}
+
+static void ZeldaEnemyMechanics(Player* player, ZeldaState& state)
+{
+    static bool const on = sConfig.GetBoolDefault("Zelda.HeavyBlows", true);
+    if (!on || !player->IsAlive() || !player->IsInWorld() || player->IsTaxiFlying() || player->IsGameMaster())
+        return;
+    uint32 const now = WorldTimer::getMSTime();
+    if (now < state.heavyCleanAt && player->getAttackers().empty())
+        return;
+
+    // forget enemies that are no longer fighting
+    if (now >= state.heavyCleanAt)
+    {
+        state.heavyCleanAt = now + 10000;
+        for (auto itr = state.heavyReadyAt.begin(); itr != state.heavyReadyAt.end();)
+        {
+            Creature* c = player->GetMap()->GetAnyTypeCreature(ObjectGuid(itr->first));
+            if (!c || !c->IsAlive() || c->GetVictim() != player)
+                itr = state.heavyReadyAt.erase(itr);
+            else
+                ++itr;
+        }
+    }
+
+    // one windup at a time: none starts while another enemy is still winding one up at this hero
+    for (Unit* attacker : player->getAttackers())
+        if (Spell const* spell = attacker->GetCurrentSpell(CURRENT_GENERIC_SPELL))
+            if (spell->m_spellInfo->Id == HEAVY_BLOW || spell->m_spellInfo->Id == CHARGED_BOLT)
+                return;
+
+    for (Unit* attacker : player->getAttackers())
+    {
+        if (attacker->GetTypeId() != TYPEID_UNIT || attacker->IsPlayerControlled() || !attacker->IsAlive())
+            continue;
+        Creature* c = static_cast<Creature*>(attacker);
+        uint32 const entry = c->GetEntry();
+        if (entry >= 190000 && entry < 190960)  // companions, story characters, Beedle
+            continue;
+        CreatureInfo const* info = c->GetCreatureInfo();
+        if (info->CreatureType == CREATURE_TYPE_CRITTER || c->GetLevel() < 5 || c->GetVictim() != player)
+            continue;
+        Threat const threat = ThreatOf(c);
+        uint64 const key = c->GetObjectGuid().GetRawValue();
+        auto itr = state.heavyReadyAt.find(key);
+        if (itr == state.heavyReadyAt.end())
+        {
+            state.heavyReadyAt[key] = now + (threat == Threat::Normal ? urand(6000, 10000) : urand(3500, 6500));
+            continue;
+        }
+        if (now < itr->second)
+            continue;
+        if (c->IsNonMeleeSpellCasted(false) || c->hasUnitState(UNIT_STAT_CAN_NOT_REACT_OR_LOST_CONTROL))
+        {
+            itr->second = now + 1000;
+            continue;
+        }
+        bool const melee = c->CanReachWithMeleeAttack(player);
+        bool const bolt = !melee && IsCasterCreature(c) && c->IsWithinDistInMap(player, 30.0f) && c->IsWithinLOSInMap(player);
+        if (!melee && !bolt)
+        {
+            itr->second = now + 1000;
+            continue;
+        }
+        uint32 const spellId = melee ? HEAVY_BLOW : CHARGED_BOLT;
+        c->SetFacingToObject(player);
+        if (c->CastSpell(player, spellId, TRIGGERED_NONE) != SPELL_CAST_OK)
+        {
+            itr->second = now + 1500;
+            continue;
+        }
+        itr->second = now + HeavyInterval(threat);
+        if (melee)
+            player->GetSession()->SendAreaTriggerMessage("|cffff4040%s winds up a heavy blow - raise your shield!|r", c->GetName());
+        else
+            player->GetSession()->SendAreaTriggerMessage("|cffff4040%s charges a bolt - shield up or roll!|r", c->GetName());
+        return;                                  // one at a time
+    }
+}
+
+// ------------------------------------------------------------------ enemy charge-ups
+// The hero an enemy's cast is meant for: its unit target when that is a hero (or a hero's pet),
+// else the enemy's own victim, for its area attacks.
+static Player* ZeldaChargeHero(Unit* caster, Unit* target)
+{
+    auto heroOf = [](Unit* unit) -> Player*
+    {
+        if (!unit)
+            return nullptr;
+        if (unit->IsPlayer())
+            return static_cast<Player*>(unit);
+        if (unit->IsPlayerControlled())
+            return unit->GetBeneficiaryPlayer();
+        return nullptr;
+    };
+    if (target && target != caster)
+        return heroOf(target);
+    return heroOf(caster->GetVictim());
+}
+
+uint32 ZeldaEnemyCharge(Spell* spell, uint32 castTime, ObjectGuid& alerted)
+{
+    static uint32 const minimum = std::max(0, sConfig.GetIntDefault("Zelda.EnemyChargeTime", 1500));
+    if (!spell || minimum == 0)
+        return castTime;
+    Unit* caster = spell->GetCaster();
+    SpellEntry const* info = spell->m_spellInfo;
+    if (!caster || !info || caster->GetTypeId() != TYPEID_UNIT || caster->IsPlayerControlled() || !caster->IsAlive())
+        return castTime;
+    if (IsChanneledSpell(info) || IsNextMeleeSwingSpell(info) || info->HasAttribute(SPELL_ATTR_PASSIVE) ||
+        spell->IsAutoRepeat())
+        return castTime;
+    Unit* target = spell->m_targets.getUnitTarget();
+    if (IsPositiveSpell(info, caster, target ? target : caster))
+        return castTime;
+    Player* hero = ZeldaChargeHero(caster, target);
+    if (!hero || !hero->IsInWorld() || !hero->IsAlive() || hero->GetMap() != caster->GetMap())
+        return castTime;
+
+    uint32 const charge = std::max(castTime, minimum);
+    alerted = hero->GetObjectGuid();
+    char const* name = info->SpellName[0] ? info->SpellName[0] : "";
+    ChatHandler(hero).PSendSysMessage("ZCAST:%s;%s;%u", caster->GetName(), name, charge);
+    return charge;
+}
+
+void ZeldaEnemyChargeStopped(Unit* caster, ObjectGuid const& hero)
+{
+    if (!caster || hero.IsEmpty())
+        return;
+    if (Player* player = ObjectAccessor::FindPlayer(hero))
+        ChatHandler(player).PSendSysMessage("ZCAST:%s;;0", caster->GetName());
+}
+
+// a charged-up enemy attack blocked or parried fills a quarter of the rage bar (Zelda.GuardRagePercent)
+static void GuardRage(Player* hero)
+{
+    static uint32 const pct = uint32(std::max(0, sConfig.GetIntDefault("Zelda.GuardRagePercent", 25)));
+    if (!hero || !pct || !hero->IsAlive())
+        return;
+    hero->ModifyPower(POWER_RAGE, int32(hero->GetMaxPower(POWER_RAGE) * pct / 100));
+}
+
+void ZeldaChargeLanded(Spell* spell)
+{
+    if (!spell || spell->m_zeldaChargeAlert.IsEmpty())
+        return;
+    ObjectGuid const heroGuid = spell->m_zeldaChargeAlert;
+    spell->m_zeldaChargeAlert = ObjectGuid();
+    SpellEntry const* info = spell->m_spellInfo;
+    Unit* caster = spell->GetCaster();
+    if (!info || !caster || info->Id == HEAVY_BLOW || info->Id == CHARGED_BOLT)
+        return;                                 // these two resolve themselves (ZeldaHeavyBlowLands)
+    Player* hero = ObjectAccessor::FindPlayer(heroGuid);
+    if (!hero || hero->GetMap() != caster->GetMap())
+        return;
+    if (ZeldaShieldHolds(hero, caster))
+    {
+        GuardRage(hero);
+        hero->GetSession()->SendAreaTriggerMessage("|cff66ccffBlocked %s!|r", info->SpellName[0]);
+    }
+    else if (info->DmgClass == SPELL_DAMAGE_CLASS_MELEE && ZeldaParryHolds(hero, caster))
+    {
+        GuardRage(hero);
+        hero->GetSession()->SendAreaTriggerMessage("|cffffcc66Parried %s!|r", info->SpellName[0]);
+    }
+}
+
+bool ZeldaHeavyBlowLands(Unit* caster, Unit* target, uint32 spellId)
+{
+    if (spellId != HEAVY_BLOW && spellId != CHARGED_BOLT)
+        return false;
+    if (!caster || !target || !target->IsAlive() || target->GetTypeId() != TYPEID_PLAYER)
+        return true;
+    Player* hero = static_cast<Player*>(target);
+    bool const melee = spellId == HEAVY_BLOW;
+
+    ZeldaState snapshot;
+    {
+        std::lock_guard<std::mutex> guard(s_statesLock);
+        auto itr = s_states.find(hero->GetGUIDLow());
+        if (itr != s_states.end())
+            snapshot = itr->second;
+    }
+    WorldSession* session = hero->GetSession();
+    bool const inFront = hero->HasInArc(caster, M_PI_F * 2.0f / 3.0f);
+    if (WorldTimer::getMSTime() < snapshot.invulnerableUntil ||
+        (melee && !caster->CanReachWithMeleeAttack(hero, 1.5f)))
+    {
+        Unit::SendSpellMiss(caster, hero, spellId, SPELL_MISS_DODGE);
+        session->SendAreaTriggerMessage("|cff66ff66Dodged!|r");
+        return true;
+    }
+    if (snapshot.shield && inFront)
+    {
+        Unit::SendSpellMiss(caster, hero, spellId, SPELL_MISS_BLOCK);
+        hero->HandleEmoteCommand(EMOTE_ONESHOT_PARRYSHIELD);
+        GuardRage(hero);
+        if (melee)
+        {
+            Stagger(hero, caster, 2000);
+            session->SendAreaTriggerMessage("|cff66ccffBlocked! %s is staggered - strike now!|r", caster->GetName());
+        }
+        else
+            session->SendAreaTriggerMessage("|cff66ccffBlocked!|r");
+        return true;
+    }
+    if (melee && snapshot.parry && inFront)
+    {
+        Unit::SendSpellMiss(caster, hero, spellId, SPELL_MISS_PARRY);
+        Stagger(hero, caster, 1500);
+        GuardRage(hero);
+        session->SendAreaTriggerMessage("|cffffcc66Parried! %s is thrown off balance!|r", caster->GetName());
+        return true;
+    }
+
+    Threat const threat = caster->GetTypeId() == TYPEID_UNIT ? ThreatOf(static_cast<Creature*>(caster)) : Threat::Normal;
+    uint32 damage = std::max<uint32>(1, uint32(hero->GetMaxHealth() * HeavyShare(threat)));
+    SpellSchoolMask const mask = melee ? SPELL_SCHOOL_MASK_NORMAL : SPELL_SCHOOL_MASK_ARCANE;
+    SpellNonMeleeDamage info(caster, hero, spellId, melee ? SPELL_SCHOOL_NORMAL : SPELL_SCHOOL_ARCANE);
+    uint32 absorb = 0;
+    int32 resist = 0;
+    hero->CalculateDamageAbsorbAndResist(caster, mask, SPELL_DIRECT_DAMAGE, damage, &absorb, &resist, false, false);
+    info.absorb = absorb;
+    info.damage = damage > absorb ? damage - absorb : 0;
+    Unit::SendSpellNonMeleeDamageLog(&info);
+    Unit::DealSpellDamage(caster, &info, true, false);
+    if (melee && hero->IsAlive())
+        caster->CastSpell(hero, HEAVY_KNOCKDOWN, TRIGGERED_OLD_TRIGGERED);
+    return true;
+}
+
+bool ChatHandler::HandleZeldaSlashCommand(char* args)
+{
+    Player* player = m_session->GetPlayer();
+    if (!CanAct(player))
+        return true;
+
+    // ".zslash <step> <animates>": the ZeldaControls addon keeps the combo's count and timing and
+    // says which swing this is, and whether the client plays its animation itself. Without them
+    // the server counts on its own.
+    uint32 step = 0, clientAnimates = 0;
+    if (args && *args)
+    {
+        ExtractUInt32(&args, step);
+        ExtractUInt32(&args, clientAnimates);
+    }
+
+    ZeldaState& state = StateFor(player);
+    Style style = StyleOf(player);
+    StyleStats stats = StatsFor(style);
+    uint32 now = WorldTimer::getMSTime();
+    // mid-swing presses do nothing, quietly
+    if (now + SLASH_LOCK_TOLERANCE_MS < state.slashReadyAt)
+        return true;
+
+    if (step < 1 || step > COMBO_STEPS)
+    {
+        bool const chained = state.slashReadyAt && now <= state.slashReadyAt + COMBO_WINDOW_MS;
+        step = chained ? state.comboCount % COMBO_STEPS + 1 : 1;
+    }
+    state.comboCount = step;
+    state.lastSlash = now;
+    // a two-handed weapon swings 50% slower (the addon's TWO_HANDED_SLOWER)
+    uint32 duration = SlashDurationMs(player, step);
+    if (style == Style::TwoHanded)
+        duration = duration * 3 / 2;
+    // Flurry: every swing goes its percentage faster (the addon's FlurryPercent)
+    duration = uint32(duration / (1.0f + ZeldaFlurryPercent(player) / 100.0f));
+    state.slashReadyAt = now + duration;
+    bool const finisher = step == COMBO_STEPS;
+
+    std::list<Unit*> enemies;
+    CollectEnemies(player, stats.slashRange + 8.0f, enemies);
+
+    // Prefer the selected target if it is in reach, then everything else in the cone in front of us.
+    Unit* selected = ObjectAccessor::GetUnit(*player, player->GetSelectionGuid());
+    uint32 hit = 0;
+    t_noSwingAnim = clientAnimates != 0;
+    for (Unit* unit : enemies)
+    {
+        bool inReach = player->IsWithinDistInMap(unit, stats.slashRange + unit->GetCombatReach());
+        bool inFront = player->HasInArc(unit, stats.slashArc) || unit == selected;
+        if (!inReach || !inFront)
+            continue;
+        ZeldaSwing(player, unit, finisher ? 2 : 1);
+        if (style == Style::DualWield && unit->IsAlive())
+            player->AttackerStateUpdate(unit, OFF_ATTACK, true);
+        ++hit;
+    }
+    t_noSwingAnim = false;
+
+    if (hit == 0 && !clientAnimates)
+        player->HandleEmoteCommand(finisher ? EMOTE_ONESHOT_SPECIALATTACK1H : EMOTE_ONESHOT_ATTACK1H); // swing at the air
+    return true;
+}
+
+static void ZeldaShieldSlam(Player* player, Item* shield)
+{
+    const uint32 SHIELD_SLAM_SPELL = 23922;     // Shield Slam (rank 1): the shield-bash strike and look
+    const uint32 SLAM_STUN_SPELL = 7922;        // Charge Stun, held for 2 seconds
+    const int32 SLAM_STUN_MS = 2000;
+
+    StyleStats const reach = StatsFor(Style::OneHanded);
+    std::list<Unit*> enemies;
+    CollectEnemies(player, reach.slashRange + 8.0f, enemies);
+    Unit* selected = ObjectAccessor::GetUnit(*player, player->GetSelectionGuid());
+    // Shield Slam adds the block value itself, so the strike as a whole is the shield's armor
+    int32 const damage = std::max<int32>(1, int32(shield->GetProto()->Armor) - int32(player->GetShieldBlockValue()));
+    uint32 hit = 0;
+    for (Unit* unit : enemies)
+    {
+        if (!player->IsWithinDistInMap(unit, reach.slashRange + unit->GetCombatReach()))
+            continue;
+        if (!player->HasInArc(unit, reach.slashArc) && unit != selected)
+            continue;
+        player->CastCustomSpell(unit, SHIELD_SLAM_SPELL, nullptr, &damage, nullptr,
+                                TriggerCastFlags(TRIGGERED_OLD_TRIGGERED | TRIGGERED_IGNORE_COSTS));
+        ++hit;
+        if (!unit->IsAlive())
+            continue;
+        player->CastSpell(unit, SLAM_STUN_SPELL, TRIGGERED_OLD_TRIGGERED);
+        if (SpellAuraHolder* holder = unit->GetSpellAuraHolder(SLAM_STUN_SPELL, player->GetObjectGuid()))
+        {
+            holder->SetAuraMaxDuration(SLAM_STUN_MS);
+            holder->SetAuraDuration(SLAM_STUN_MS);
+            holder->UpdateAuraDuration();
+        }
+    }
+    if (hit == 0)
+        PlaySpellVisual(player, SHIELD_SLAM_SPELL, {});   // the slam at the air
+}
+
+// Berserker Stance's charged attack: a leaping strike on one enemy in front (the selected one when
+// it is there), for twice the hero's attack power. A melee-class spell (Leaping Strike, 40008), so
+// it crits like a melee hit and never glances. The Zelda client plays the leap (Special2H) itself.
+static void ZeldaLeapingStrike(Player* player, bool clientAnimates)
+{
+    // every enemy in front of the hero, within a two-hander's reach and arc, takes attack power x2
+    const uint32 LEAPING_STRIKE_SPELL = 40008;
+    StyleStats const reach = StatsFor(Style::TwoHanded);
+    std::list<Unit*> enemies;
+    CollectEnemies(player, reach.slashRange + 8.0f, enemies);
+    if (!clientAnimates)
+        player->HandleEmoteCommand(EMOTE_ONESHOT_SPECIALATTACK1H);
+    int32 const damage = std::max<int32>(1, int32(player->GetTotalAttackPowerValue(BASE_ATTACK) * 2.0f));
+    for (Unit* unit : enemies)
+    {
+        if (!unit->IsAlive() || !player->IsWithinDistInMap(unit, reach.slashRange + unit->GetCombatReach()) ||
+            !player->HasInArc(unit, reach.slashArc))
+            continue;
+        player->CastCustomSpell(unit, LEAPING_STRIKE_SPELL, &damage, nullptr, nullptr,
+                                TriggerCastFlags(TRIGGERED_OLD_TRIGGERED | TRIGGERED_IGNORE_COSTS));
+    }
+}
