+// the rank (1-5) of a talent the player has, by its ranks' spell ids; 0 without it
+static uint32 ZeldaTalentRank(Unit const* unit, std::initializer_list<uint32> ranks)
+{
+    uint32 rank = 0, n = 0;
+    for (uint32 id : ranks)
+    {
+        ++n;
+        if (unit->HasAura(id))
+            rank = n;
+    }
+    return rank;
+}
