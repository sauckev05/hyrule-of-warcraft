+uint32 ZeldaMarkTurnInXP(Player* player, Quest const* quest)
+{
+    static float const pct = std::max(0.0f, sConfig.GetFloatDefault("Zelda.MarkTurnInXPPercent", 3.0f));
+    if (!player || !quest || pct <= 0.0f)
+        return 0;
+    uint32 marks = 0;
+    for (uint8 i = 0; i < QUEST_ITEM_OBJECTIVES_COUNT; ++i)
+        if (quest->ReqItemId[i] == 20558 || quest->ReqItemId[i] == 20559 || quest->ReqItemId[i] == 20560)
+            marks += quest->ReqItemCount[i];
+    if (!marks)
+        return 0;
+    return uint32(player->GetUInt32Value(PLAYER_NEXT_LEVEL_XP) * pct / 100.0f * marks);
