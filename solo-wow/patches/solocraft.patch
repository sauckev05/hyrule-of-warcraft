+// ---------------------------------------------------------------- dungeon clears
+// Every dungeon and raid (or wing, for the ones with separate entrances) counts the enemies it
+// was spawned with. Killed ones stay dead, a bar under the minimap shows how many have fallen,
+// and clearing all of them gives the hero that dungeon's Crystal Shard (zelda_dungeon_clear).
+namespace
+{
+    struct ClearSection
+    {
+        uint32 map;
+        uint32 section;
+        std::string name;
+        uint32 item;
+        bool raid;
+        float minX, maxX, minY, maxY;
+    };
+
+    struct ClearCount
+    {
+        uint16 section;                 // index into s_clearSections
+        uint8 hostileTo;                // bit 0: Alliance heroes, bit 1: Horde heroes
+        bool killed;
+    };
+
+    struct ClearTracker
+    {
+        std::unordered_map<uint32, ClearCount> counted;   // by spawn (db guid)
+        std::set<uint16> awarded;                         // sections whose shard was handed out
+    };
+
+    std::vector<ClearSection> s_clearSections;
+    std::unordered_map<uint32, std::vector<std::pair<float, float>>> s_clearGrids;  // a point in each grid with spawns
+    std::unordered_map<uint32, std::vector<uint32>> s_clearSpawns;                  // the map's db guids
+    std::unordered_map<Map const*, ClearTracker> s_clearTrackers;
+    std::mutex s_clearLock;
+
+    uint32 const CLEAR_MAIL_SENDER = 190601;          // Navi
+    uint32 const RESPAWN_NEVER = 30 * DAY;
+
+    bool ClearMapTracked(uint32 mapId)
+    {
+        for (ClearSection const& c : s_clearSections)
+            if (c.map == mapId)
+                return true;
+        return false;
+    }
+
+    int32 ClearSectionAt(uint32 mapId, float x, float y)
+    {
+        for (size_t i = 0; i < s_clearSections.size(); ++i)
+        {
+            ClearSection const& c = s_clearSections[i];
+            if (c.map == mapId && x >= c.minX && x < c.maxX && y >= c.minY && y < c.maxY)
+                return int32(i);
+        }
+        return -1;
+    }
+
+    uint8 HostileMask(uint32 factionTemplate)
+    {
+        FactionTemplateEntry const* ft = sFactionTemplateStore.LookupEntry(factionTemplate);
+        FactionTemplateEntry const* alliance = sFactionTemplateStore.LookupEntry(1);   // human player
+        FactionTemplateEntry const* horde = sFactionTemplateStore.LookupEntry(2);      // orc player
+        if (!ft || !alliance || !horde)
+            return 0;
+        uint8 mask = uint8((ft->IsHostileTo(*alliance) ? 1 : 0) | (ft->IsHostileTo(*horde) ? 2 : 0));
+        // the other side's people are friends of every hero (cross-faction): an Undercity prisoner or
+        // a Horde quest giver can't be fought, so it never counts towards a clear
+        static bool const crossFaction = sConfig.GetBoolDefault("Zelda.CrossFaction", true);
+        if (crossFaction)
+        {
+            if (OppositeFactions(ALLIANCE).count(ft->faction))
+                mask &= ~uint8(1);
+            if (OppositeFactions(HORDE).count(ft->faction))
+                mask &= ~uint8(2);
+        }
+        return mask;
+    }
+
+    bool TemplateCounts(CreatureInfo const* info)
+    {
+        if (!info || info->CreatureType == CREATURE_TYPE_CRITTER)
+            return false;
+        if (info->ExtraFlags & (CREATURE_EXTRA_FLAG_INVISIBLE | CREATURE_EXTRA_FLAG_CIVILIAN))
+            return false;
+        if (info->UnitFlags & (UNIT_FLAG_SPAWNING | UNIT_FLAG_IMMUNE_TO_PLAYER | UNIT_FLAG_UNTARGETABLE | UNIT_FLAG_UNINTERACTIBLE))
+            return false;
+        std::string const name = info->Name ? info->Name : "";
+        for (char const* skip : { "Trigger", "Invisible", "Bunny", "Dummy", "(DND)" })
+            if (name.find(skip) != std::string::npos)
+                return false;
+        return true;
+    }
+
+    uint8 TeamBit(Player const* player)
+    {
+        return player->GetTeam() == HORDE ? 2 : 1;
+    }
+
+    void ClearProgress(ClearTracker const& t, uint16 section, uint8 team, uint32& killed, uint32& total)
+    {
+        killed = total = 0;
+        for (auto const& kv : t.counted)
+        {
+            if (kv.second.section != section || !(kv.second.hostileTo & team))
+                continue;
+            ++total;
+            if (kv.second.killed)
+                ++killed;
+        }
+    }
+
+    void GiveShard(Player* player, ClearSection const& c)
+    {
+        if (!c.item)
+            return;
+        std::string const key = "shard:" + std::to_string(c.item);
+        if (CharacterDatabase.PQuery("SELECT 1 FROM `ai_playerbot_db_store` WHERE `guid` = '%u' AND `preset` = 'zelda' AND `key` = '%s'",
+                                     player->GetGUIDLow(), key.c_str()) || player->HasItemCount(c.item, 1, true))
+            return;
+        CharacterDatabase.PExecute("INSERT INTO `ai_playerbot_db_store` (`guid`, `preset`, `key`, `value`) VALUES ('%u', 'zelda', '%s', '1')",
+                                   player->GetGUIDLow(), key.c_str());
+        ItemPrototype const* proto = sObjectMgr.GetItemPrototype(c.item);
+        char const* itemName = proto ? proto->Name1 : "Crystal Shard";
+        ChatHandler(player).PSendSysMessage("|cff33ff99Every foe in %s has fallen!|r", c.name.c_str());
+        player->GetSession()->SendAreaTriggerMessage("%s cleared!", c.name.c_str());
+        ItemPosCountVec dest;
+        if (player->CanStoreNewItem(NULL_BAG, NULL_SLOT, dest, c.item, 1) == EQUIP_ERR_OK)
+        {
+            if (Item* item = player->StoreNewItem(dest, c.item, true))
+                player->SendNewItem(item, 1, true, false);
+            return;
+        }
+        if (Item* item = Item::CreateItem(c.item, 1, player))
+        {
+            CharacterDatabase.BeginTransaction();
+            item->SaveToDB();
+            CharacterDatabase.CommitTransaction();
+            MailDraft(itemName, "Your bags were full, so I kept this safe for you. Hey! Listen! You did it!")
+                .AddItem(item).SendMailTo(player, MailSender(MAIL_CREATURE, CLEAR_MAIL_SENDER), MAIL_CHECK_MASK_COPIED);
+            ChatHandler(player).PSendSysMessage("|cff33ff99Your bags are full: the %s was sent to your mailbox.|r", itemName);
+        }
+    }
+
+    // after a kill or a despawn: hand out the shard of every section now fully cleared
+    void CheckClears(Map* map, ClearTracker& t)
+    {
+        for (auto const& ref : map->GetPlayers())
+        {
+            Player* player = ref.getSource();
+            if (!player || player->IsGameMaster())
+                continue;
+            uint8 const team = TeamBit(player);
+            std::set<uint16> sections;
+            for (auto const& kv : t.counted)
+                if (kv.second.hostileTo & team)
+                    sections.insert(kv.second.section);
+            for (uint16 section : sections)
+            {
+                if (t.awarded.count(section))
+                    continue;
+                uint32 killed, total;
+                ClearProgress(t, section, team, killed, total);
+                if (total && killed == total)
+                {
+                    t.awarded.insert(section);
+                    GiveShard(player, s_clearSections[section]);
+                }
+            }
+        }
+    }
+}
+
+void ZeldaLoadDungeonClears()
+{
+    s_clearSections.clear();
+    s_clearGrids.clear();
+    s_clearSpawns.clear();
+    auto result = WorldDatabase.Query("SELECT `map`, `section`, `name`, `item`, `raid`, `min_x`, `max_x`, `min_y`, `max_y` FROM `zelda_dungeon_clear` ORDER BY `map`, `section`");
+    if (!result)
+        return;
+    do
+    {
+        Field* f = result->Fetch();
+        s_clearSections.push_back({ f[0].GetUInt32(), f[1].GetUInt32(), f[2].GetCppString(), f[3].GetUInt32(), f[4].GetUInt32() != 0,
+                                    f[5].GetFloat(), f[6].GetFloat(), f[7].GetFloat(), f[8].GetFloat() });
+    }
+    while (result->NextRow());
+
+    struct Collect
+    {
+        bool operator()(std::pair<uint32 const, CreatureData> const& kv)
+        {
+            CreatureData const& d = kv.second;
+            if (!ClearMapTracked(d.mapid))
+                return false;
+            s_clearSpawns[d.mapid].push_back(kv.first);
+            GridPair const g = MaNGOS::ComputeGridPair(d.posX, d.posY);
+            uint32 const key = (d.mapid << 16) | (g.x_coord << 8) | g.y_coord;
+            if (seen.insert(key).second)
+                s_clearGrids[d.mapid].push_back({ d.posX, d.posY });
+            return false;
+        }
+        std::set<uint32> seen;
+    } collect;
+    sObjectMgr.DoCreatureData(collect);
+    sLog.outString(">> Zelda: %u dungeon clears", uint32(s_clearSections.size()));
+}
+
+uint32 ZeldaInstanceRespawnDelay(Creature const* creature, uint32 delay)
+{
+    static bool const never = sConfig.GetBoolDefault("Zelda.DungeonNoRespawn", true);
+    if (!never || !creature->GetMap()->IsDungeon() || !creature->HasStaticDBSpawnData() || !ClearMapTracked(creature->GetMapId()))
+        return delay;
+    return RESPAWN_NEVER;
+}
+
+void ZeldaClearMapInit(Map* map)
+{
+    if (!map->IsDungeon() || !ClearMapTracked(map->GetId()))
+        return;
+    {
+        std::lock_guard<std::mutex> guard(s_clearLock);
+        ClearTracker& t = s_clearTrackers[map];
+        // the ones already dead in a saved instance (a raid lockout, a server restart)
+        time_t const now = time(nullptr);
+        auto spawns = s_clearSpawns.find(map->GetId());
+        for (uint32 guid : spawns != s_clearSpawns.end() ? spawns->second : std::vector<uint32>())
+        {
+            if (map->GetPersistentState()->GetCreatureRespawnTime(guid) <= now)
+                continue;
+            CreatureData const* d = sObjectMgr.GetCreatureData(guid);
+            if (!d)
+                continue;
+            int32 const section = ClearSectionAt(map->GetId(), d->posX, d->posY);
+            if (section < 0)
+                continue;
+            CreatureInfo const* info = d->id ? ObjectMgr::GetCreatureTemplate(d->id) : nullptr;
+            if (d->id && !TemplateCounts(info))
+                continue;
+            uint8 const mask = info ? HostileMask(info->Faction) : 3;
+            if (mask)
+                t.counted[guid] = { uint16(section), mask, true };
+        }
+    }
+    // every grid with spawns comes alive with the instance, so the count is whole from the start
+    auto grids = s_clearGrids.find(map->GetId());          // filled once at startup, read-only after
+    if (grids != s_clearGrids.end())
+        for (auto const& pt : grids->second)
+            map->ForceLoadGrid(pt.first, pt.second);
+}
+
+void ZeldaClearMapGone(Map* map)
+{
+    std::lock_guard<std::mutex> guard(s_clearLock);
+    s_clearTrackers.erase(map);
+}
+
+void ZeldaClearCreatureAdded(Creature* creature)
+{
+    if (!creature->HasStaticDBSpawnData() || creature->IsPet() || creature->IsTotem() || creature->IsTemporarySummon() ||
+        !creature->IsAlive())
+        return;
+    Map* map = creature->GetMap();
+    std::lock_guard<std::mutex> guard(s_clearLock);
+    auto it = s_clearTrackers.find(map);
+    if (it == s_clearTrackers.end())
+        return;
+    CreatureData const* d = sObjectMgr.GetCreatureData(creature->GetDbGuid());
+    float const x = d ? d->posX : creature->GetPositionX();
+    float const y = d ? d->posY : creature->GetPositionY();
+    int32 const section = ClearSectionAt(map->GetId(), x, y);
+    if (section < 0 || !TemplateCounts(creature->GetCreatureInfo()) ||
+        creature->HasFlag(UNIT_FIELD_FLAGS, UNIT_FLAG_SPAWNING | UNIT_FLAG_IMMUNE_TO_PLAYER | UNIT_FLAG_UNTARGETABLE | UNIT_FLAG_UNINTERACTIBLE))
+        return;
+    uint8 const mask = HostileMask(creature->GetFaction());
+    if (!mask)
+        return;
+    it->second.counted[creature->GetDbGuid()] = { uint16(section), mask, false };
+}
+
+static void ClearMarkGone(Creature* creature)
+{
+    Map* map = creature->GetMap();
+    if (map->GetPlayers().isEmpty())
+        return;                                             // the instance is closing, not a fight
+    std::lock_guard<std::mutex> guard(s_clearLock);
+    auto it = s_clearTrackers.find(map);
+    if (it == s_clearTrackers.end())
+        return;
+    auto c = it->second.counted.find(creature->GetDbGuid());
+    if (c == it->second.counted.end() || c->second.killed)
+        return;
+    c->second.killed = true;
+    CheckClears(map, it->second);
+}
+
+void ZeldaClearCreatureDied(Creature* creature)
+{
+    if (creature->HasStaticDBSpawnData())
+        ClearMarkGone(creature);
+}
+
+void ZeldaClearCreatureRemoved(Creature* creature)
+{
+    // a counted enemy a script sends away alive is as good as beaten
+    if (creature->HasStaticDBSpawnData() && creature->IsAlive())
+        ClearMarkGone(creature);
+}
+
+// "killed;total;name" of the dungeon section the hero stands in, "" outside one
+static std::string ClearReport(Player* player)
+{
+    Map* map = player->GetMap();
+    if (!map->IsDungeon())
+        return "";
+    std::lock_guard<std::mutex> guard(s_clearLock);
+    auto it = s_clearTrackers.find(map);
+    if (it == s_clearTrackers.end())
+        return "";
+    int32 const section = ClearSectionAt(map->GetId(), player->GetPositionX(), player->GetPositionY());
+    if (section < 0)
+        return "";
+    uint32 killed, total;
+    ClearProgress(it->second, uint16(section), TeamBit(player), killed, total);
+    return std::to_string(killed) + ";" + std::to_string(total) + ";" + s_clearSections[section].name + ";" +
+           (s_clearSections[section].raid ? "1" : "0");
+}
+
+static void SendClearReport(Player* player, ZeldaState& state, bool force)
+{
+    std::string const report = ClearReport(player);
+    if (!force && report == state.lastClearReport)
+        return;
+    state.lastClearReport = report;
+    ChatHandler(player).PSendSysMessage("ZDUNGEON:%s", report.c_str());
+}
+
+bool ChatHandler::HandleZeldaDungeonCommand(char* args)
+{
+    Player* player = m_session->GetPlayer();
+    std::string const arg = args ? args : "";
+    if (arg.find("left") == std::string::npos)
+    {
+        SendClearReport(player, StateFor(player), true);
+        return true;
+    }
+    // the enemies still standing in this section, nearest first
+    Map* map = player->GetMap();
+    std::vector<std::pair<float, std::string>> left;
+    {
+        std::lock_guard<std::mutex> guard(s_clearLock);
+        auto it = s_clearTrackers.find(map);
+        int32 const section = ClearSectionAt(map->GetId(), player->GetPositionX(), player->GetPositionY());
+        if (it == s_clearTrackers.end() || section < 0)
+        {
+            SendSysMessage("You are not in a dungeon.");
+            return true;
+        }
+        uint8 const team = TeamBit(player);
+        for (auto const& kv : it->second.counted)
+        {
+            if (kv.second.killed || kv.second.section != uint16(section) || !(kv.second.hostileTo & team))
+                continue;
+            Creature* c = map->GetCreature(kv.first);
+            float dx, dy;
+            std::string name;
+            if (c)
+            {
+                dx = c->GetPositionX() - player->GetPositionX();
+                dy = c->GetPositionY() - player->GetPositionY();
+                name = c->GetName();
+            }
+            else if (CreatureData const* d = sObjectMgr.GetCreatureData(kv.first))
+            {
+                dx = d->posX - player->GetPositionX();
+                dy = d->posY - player->GetPositionY();
+                CreatureInfo const* info = ObjectMgr::GetCreatureTemplate(d->id);
+                name = info && info->Name ? info->Name : "an enemy";
+            }
+            else
+                continue;
+            float const dist = std::sqrt(dx * dx + dy * dy);
+            static char const* const dirs[] = { "north", "north-west", "west", "south-west", "south", "south-east", "east", "north-east" };
+            float const angle = std::atan2(dy, dx);             // +x is north, +y is west
+            int const octant = (int(std::floor(angle / (M_PI_F / 4.0f) + 0.5f)) + 8) % 8;
+            char line[160];
+            snprintf(line, sizeof(line), "%s - %u yd %s", name.c_str(), uint32(dist), dirs[octant]);
+            left.emplace_back(dist, line);
+        }
+    }
+    std::sort(left.begin(), left.end());
+    PSendSysMessage("|cff33ff99%u enemies left here:|r", uint32(left.size()));
+    for (size_t i = 0; i < left.size() && i < 12; ++i)
+        PSendSysMessage("  %s", left[i].second.c_str());
+    return true;
+}
