+bool ZeldaFlagTaking(Player* player, GameObject* flag, SpellEntry const* spellInfo)
+{
+    uint32 const OPENING = 21651;                   // Opening: Arathi Basin's ten-second banner cast
+    if (!player || !flag || !ZeldaSoloBattlegrounds() || player->GetMapId() != 489)
+        return false;
+    if (spellInfo && spellInfo->Id == OPENING)
+        return false;                               // the ten seconds are done: take it
+    // only the other side's flag is taken (Warsong Flag 179831, Silverwing Flag 179830)
+    if (flag->GetEntry() != (player->GetTeam() == ALLIANCE ? 179831u : 179830u))
+        return false;
+    if (player->IsNonMeleeSpellCasted(false))
+        return true;
+    if (SpellEntry const* open = sSpellTemplate.LookupEntry<SpellEntry>(OPENING))
+    {
+        Spell* spell = new Spell(player, open, TRIGGERED_NONE);
+        SpellCastTargets targets;
+        targets.setGOTarget(flag);
+        spell->SpellStart(&targets);
+        return true;
+    }
+    return false;
+}
