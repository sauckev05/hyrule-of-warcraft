+bool ChatHandler::HandleZeldaSpinCommand(char* args)
+{
+    Player* player = m_session->GetPlayer();
+    if (!CanAct(player))
+        return true;
+
+    ZeldaState& state = StateFor(player);
+    uint32 now = WorldTimer::getMSTime();
+    if (now < state.spinReadyAt)
+        return true;
+
+    // The spin costs 50 rage; without it there is no spin.
+    bool const usesRage = player->GetPowerType() == POWER_RAGE;
+    // armor sets can make it cheaper
+    uint32 const discount = std::min<uint32>(SPIN_RAGE_COST, uint32(SetBonusOf(player, SET_BONUS_SPIN_RAGE)) * 10);
+    uint32 const spinCost = SPIN_RAGE_COST - discount;
+    if (usesRage && player->GetPower(POWER_RAGE) < spinCost)
+    {
+        player->GetSession()->SendNotification("Not enough rage for a Spin Attack (%u needed)", spinCost / 10);
+        return true;
+    }
+    if (usesRage)
+        player->ModifyPower(POWER_RAGE, -int32(spinCost));
+
+    state.spinReadyAt = now + SPIN_COOLDOWN_MS;
+    state.comboCount = 0;
+
+    // Berserker Stance: a leaping strike on every enemy in front (".zspin 1" when the client animates it)
+    if (player->GetShapeshiftForm() == FORM_BERSERKERSTANCE)
+    {
+        uint32 clientAnimates = 0;
+        if (args && *args)
+            ExtractUInt32(&args, clientAnimates);
+        ZeldaLeapingStrike(player, clientAnimates != 0);
+        return true;
+    }
+
+    // Defensive Stance with a shield: the charged attack is a Shield Slam on the enemies in front
+    // instead of the spin - its damage is the shield's armor, and each is stunned for 2 seconds
+    if (player->GetShapeshiftForm() == FORM_DEFENSIVESTANCE)
+    {
+        if (Item* shield = player->GetShield(true))
+        {
+            ZeldaShieldSlam(player, shield);
+            return true;
+        }
+    }
+
+    StyleStats stats = StatsFor(StyleOf(player));
+    std::list<Unit*> enemies;
+    CollectEnemies(player, stats.spinRange + 8.0f, enemies);
+    std::vector<Unit*> victims;
+    std::vector<ObjectGuid> hitGuids;
+    for (Unit* unit : enemies)
+    {
+        if (player->IsWithinDistInMap(unit, stats.spinRange + unit->GetCombatReach()))
+        {
+            victims.push_back(unit);
+            hitGuids.push_back(unit->GetObjectGuid());
+        }
+    }
+    // the Whirlwind spin goes out first so the hits land while the hero is turning
+    PlayWhirlwind(player, hitGuids);
+    // two strikes per enemy, each worth three normal swings
+    t_meleeMultiplier = SPIN_DAMAGE_MULTIPLIER;
+    t_spinNoRage = true;
+    for (Unit* unit : victims)
+        ZeldaSwing(player, unit, SPIN_STRIKES);
+    t_spinNoRage = false;
+    t_meleeMultiplier = 1.0f;
+    return true;
+}
+
+static void ZeldaDodge(Player* player, float angleOffset, float horizontal, float vertical)
+{
+    ZeldaState& state = StateFor(player);
+    uint32 now = WorldTimer::getMSTime();
+    if (now < state.dodgeReadyAt)
+        return;
+    state.dodgeReadyAt = now + DODGE_COOLDOWN_MS;
+    state.invulnerableUntil = now + DODGE_INVULN_MS;
+
+    // KnockBackWithAngle launches the hero along the angle given (0 = straight ahead, pi/2 = left).
+    float angle = MapManager::NormalizeOrientation(player->GetOrientation() + angleOffset);
+    player->KnockBackWithAngle(angle, horizontal, vertical);
+}
+
+bool ChatHandler::HandleZeldaRollCommand(char* args)
+{
+    Player* player = m_session->GetPlayer();
+    if (!CanAct(player) || player->IsInWater())
+        return true;
+
+    // optional direction: f (forward, default), l (left), r (right), b (back)
+    float offset = 0.0f;
+    if (args && *args)
+    {
+        switch (args[0])
+        {
+            case 'l': case 'L': offset = M_PI_F / 2.0f; break;
+            case 'r': case 'R': offset = -M_PI_F / 2.0f; break;
+            case 'b': case 'B': offset = M_PI_F; break;
+            default: break;
+        }
+    }
+    // the forward roll covers about 9 yards (20 yd/s for ~0.47 s in the air); the side rolls are
+    // short hops of about 3 yards
+    if (offset == 0.0f)
+        ZeldaDodge(player, offset, 20.0f, 4.5f);
+    else
+        ZeldaDodge(player, offset, 11.0f, 2.5f);
+    return true;
+}
