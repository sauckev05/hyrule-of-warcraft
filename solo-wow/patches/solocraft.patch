+void ZeldaRecordSold(Player* player, Item* item, uint32 money)
+{
+    if (!player || !item)
+        return;
+    ZeldaState& state = StateFor(player);
+    ZeldaSoldItem sold;
+    sold.id = state.soldNextId++;
+    sold.entry = item->GetEntry();
+    sold.count = item->GetCount();
+    sold.randomProperty = item->GetItemRandomPropertyId();
+    sold.enchant = item->GetEnchantmentId(PERM_ENCHANTMENT_SLOT);
+    sold.price = money;
+    state.sold.push_back(sold);
+}
+
+void ZeldaForgetSold(Player* player, uint32 entry, uint32 count)
+{
+    ZeldaState& state = StateFor(player);
+    for (auto itr = state.sold.rbegin(); itr != state.sold.rend(); ++itr)
+        if (itr->entry == entry && itr->count == count)
+        {
+            state.sold.erase(std::next(itr).base());
+            return;
+        }
+}
+
+std::vector<ZeldaSoldItem> ZeldaSoldItems(Player* player)
+{
+    return StateFor(player).sold;
+}
+
+bool ZeldaBuyBackSold(Player* player, uint32 id, std::string& why)
+{
+    ZeldaState& state = StateFor(player);
+    auto itr = std::find_if(state.sold.begin(), state.sold.end(), [id](ZeldaSoldItem const& s) { return s.id == id; });
+    if (itr == state.sold.end())
+    {
+        why = "That one is already gone.";
+        return false;
+    }
+    if (player->GetMoney() < itr->price)
+    {
+        why = "You don't have enough money.";
+        return false;
+    }
+    ItemPosCountVec dest;
+    if (player->CanStoreNewItem(NULL_BAG, NULL_SLOT, dest, itr->entry, itr->count) != EQUIP_ERR_OK)
+    {
+        why = "Your bags are full.";
+        return false;
+    }
+    Item* item = player->StoreNewItem(dest, itr->entry, true, itr->randomProperty);
+    if (!item)
+    {
+        why = "That one is already gone.";
+        return false;
+    }
+    if (itr->enchant)
+    {
+        player->ApplyEnchantment(item, PERM_ENCHANTMENT_SLOT, false);
+        item->SetEnchantment(PERM_ENCHANTMENT_SLOT, itr->enchant, 0, 0);
+        player->ApplyEnchantment(item, PERM_ENCHANTMENT_SLOT, true);
+    }
+    player->ModifyMoney(-int32(itr->price));
+    player->SendNewItem(item, itr->count, true, false);
+    state.sold.erase(itr);
+    return true;
+}
