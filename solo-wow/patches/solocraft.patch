+bool ZeldaBattlegroundSpent(Player* player)
+{
+    if (!player || !player->IsInWorld() || !player->GetMap()->IsBattleGround())
+        return false;
+    for (ZeldaBgInfo const& bg : ZELDA_BGS)
+        if (bg.map == player->GetMapId())
+            return ExaltedFor(player, bg);
+    return false;
+}
