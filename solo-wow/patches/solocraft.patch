+void ZeldaHeroFirstLogin(Player* player)
+{
+    {
+        std::lock_guard<std::mutex> guard(s_heroLock);
+        if (!s_pendingHeroes.erase(player->GetGUIDLow()))
+            return;
+    }
+    CharacterDatabase.PExecute("DELETE FROM `ai_playerbot_db_store` WHERE `guid` = '%u' AND `preset` = 'zelda' AND `key` = 'herolevel'", player->GetGUIDLow());
+
+    if (player->GetLevel() < HERO_LEVEL)
+        player->GiveLevel(HERO_LEVEL);
+
+    // every class spell a trainer would have taught her by now (talents are hers to choose)
+    if (ChrClassesEntry const* classEntry = sChrClassesStore.LookupEntry(player->getClass()))
+    {
+        for (uint32 i = 0; i < sSkillLineAbilityStore.GetNumRows(); ++i)
+        {
+            SkillLineAbilityEntry const* ability = sSkillLineAbilityStore.LookupEntry(i);
+            if (!ability)
+                continue;
+            SpellEntry const* spellInfo = sSpellTemplate.LookupEntry<SpellEntry>(ability->spellId);
+            if (!spellInfo || spellInfo->spellLevel == 0 || spellInfo->spellLevel > HERO_LEVEL)
+                continue;
+            if (spellInfo->SpellFamilyName != classEntry->spellfamily)
+                continue;
+            uint32 reqLevel = 0;
+            if (!player->IsSpellFitByClassAndRace(spellInfo->Id, &reqLevel) || reqLevel > HERO_LEVEL)
+                continue;
+            if (GetTalentSpellCost(sSpellMgr.GetFirstSpellInChain(spellInfo->Id)) > 0)
+                continue;
+            if (!SpellMgr::IsSpellValid(spellInfo, player, false) || player->HasSpell(spellInfo->Id))
+                continue;
+            player->learnSpell(spellInfo->Id, false);
+        }
+    }
+
+    // a shaman's totems
+    if (player->getClass() == CLASS_SHAMAN)
+    {
+        for (uint32 totem : { 5175u, 5176u, 5177u })
+        {
+            ItemPosCountVec dest;
+            if (!player->HasItemCount(totem, 1) && player->CanStoreNewItem(NULL_BAG, NULL_SLOT, dest, totem, 1) == EQUIP_ERR_OK)
+                player->StoreNewItem(dest, totem, true);
+        }
+    }
+
+    player->SaveToDB();
+    sLog.outString("Zelda: %s is now level %u with her class spells", player->GetName(), player->GetLevel());
+}
