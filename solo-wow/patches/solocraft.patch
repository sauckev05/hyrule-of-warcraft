+// Linken's last quests (story.py): The Light of Every Dungeon asks for the hilt and a Crystal Shard of
+// each of the 24 dungeons - more items than the quest log's four, so the shards are checked and taken
+// here - and Reforged in the Black Anvil is finished at the Black Anvil in Blackrock Depths: using the
+// anvil (a goober of our own over the stock one) with the Shard-Bound Hilt forges the sword at once.
+namespace
+{
+    uint32 const QUEST_EVERY_DUNGEON = 90520;
+    uint32 const QUEST_BLACK_ANVIL = 90521;
+    uint32 const GO_BLACK_ANVIL = 191170;
+    uint32 const ITEM_SHARD_BOUND_HILT = 190534;
+    uint32 const FIRST_DUNGEON_SHARD = 191100, LAST_DUNGEON_SHARD = 191123;     // shards.py, raids excluded
+}
+
+bool ZeldaQuestExtraItem(uint32 questId, uint32 itemEntry)
+{
+    return questId == QUEST_EVERY_DUNGEON && itemEntry >= FIRST_DUNGEON_SHARD && itemEntry <= LAST_DUNGEON_SHARD;
+}
+
+bool ZeldaQuestExtraHeld(Player const* player, uint32 questId)
+{
+    if (questId != QUEST_EVERY_DUNGEON || !player)
+        return true;
+    for (uint32 shard = FIRST_DUNGEON_SHARD; shard <= LAST_DUNGEON_SHARD; ++shard)
+        if (!player->HasItemCount(shard, 1))
+            return false;
+    return true;
+}
+
+void ZeldaQuestExtraTake(Player* player, uint32 questId)
+{
+    if (questId != QUEST_EVERY_DUNGEON || !player)
+        return;
+    for (uint32 shard = FIRST_DUNGEON_SHARD; shard <= LAST_DUNGEON_SHARD; ++shard)
+        player->DestroyItemCount(shard, 1, true);
+}
+
+bool ZeldaGameObjectUse(Player* player, GameObject* go)
+{
+    if (!player || !go || go->GetEntry() != GO_BLACK_ANVIL)
+        return false;
+    Quest const* quest = sObjectMgr.GetQuestTemplate(QUEST_BLACK_ANVIL);
+    if (!quest || player->GetQuestStatus(QUEST_BLACK_ANVIL) != QUEST_STATUS_INCOMPLETE)
+        return true;                                // nothing to forge
+    if (!player->HasItemCount(ITEM_SHARD_BOUND_HILT, 1))
+    {
+        player->GetSession()->SendNotification("You need the Shard-Bound Hilt.");
+        return true;
+    }
+    for (uint32 i = 0; i < quest->GetRewItemsCount(); ++i)
+    {
+        ItemPosCountVec dest;
+        if (quest->RewItemId[i] &&
+            player->CanStoreNewItem(NULL_BAG, NULL_SLOT, dest, quest->RewItemId[i], quest->RewItemCount[i]) != EQUIP_ERR_OK)
+        {
+            player->GetSession()->SendNotification("Your bags are full.");
+            return true;
+        }
+    }
+    player->CompleteQuest(QUEST_BLACK_ANVIL);
+    player->RewardQuest(quest, 0, go, true);
+    player->GetSession()->SendAreaTriggerMessage("|cffffcc33The Black Anvil roars to life - Linken's blade is reforged!|r");
+    return true;
+}
