+/*######
+## npc_zelda_pawnbroker - buys back everything the hero sold since logging in (the core keeps the
+## list, ZeldaSoldItems), newest first, for what the vendor paid. Logging out empties it.
+######*/
+
+namespace
+{
+    uint32 const PAWN_TEXT = 902001;       // npc_text, 004_vendors.sql
+    uint32 const PAWN_TEXT_EMPTY = 902002;
+    uint32 const PAWN_SHOWN = 28;          // a gossip menu holds about 30 lines
+
+    std::string MoneyText(uint32 copper)
+    {
+        char buf[64];
+        uint32 const g = copper / 10000, sv = (copper / 100) % 100, c = copper % 100;
+        if (g)
+            snprintf(buf, sizeof(buf), "%ug %us %uc", g, sv, c);
+        else if (sv)
+            snprintf(buf, sizeof(buf), "%us %uc", sv, c);
+        else
+            snprintf(buf, sizeof(buf), "%uc", c);
+        return buf;
+    }
+
+    void ShowPawnMenu(Player* player, Creature* creature)
+    {
+        std::vector<ZeldaSoldItem> const sold = ZeldaSoldItems(player);
+        uint32 shown = 0;
+        for (auto itr = sold.rbegin(); itr != sold.rend() && shown < PAWN_SHOWN; ++itr, ++shown)
+        {
+            ItemPrototype const* proto = sObjectMgr.GetItemPrototype(itr->entry);
+            if (!proto)
+                continue;
+            std::string line = std::string("Buy back ") + proto->Name1;
+            if (itr->count > 1)
+                line += " x" + std::to_string(itr->count);
+            line += " (" + MoneyText(itr->price) + ")";
+            player->ADD_GOSSIP_ITEM(GOSSIP_ICON_VENDOR, line.c_str(), GOSSIP_SENDER_MAIN, GOSSIP_ACTION_INFO_DEF + itr->id);
+        }
+        player->SEND_GOSSIP_MENU(sold.empty() ? PAWN_TEXT_EMPTY : PAWN_TEXT, creature->GetObjectGuid());
+    }
+}
+
+bool GossipHello_npc_zelda_pawnbroker(Player* player, Creature* creature)
+{
+    ShowPawnMenu(player, creature);
+    return true;
+}
+
+bool GossipSelect_npc_zelda_pawnbroker(Player* player, Creature* creature, uint32 /*sender*/, uint32 action)
+{
+    player->GetPlayerMenu()->ClearMenus();
+    if (action > GOSSIP_ACTION_INFO_DEF)
+    {
+        std::string why;
+        if (ZeldaBuyBackSold(player, action - GOSSIP_ACTION_INFO_DEF, why))
+            creature->MonsterWhisper("Pleasure doing business! Again!", player);
+        else
+            player->GetSession()->SendNotification("%s", why.c_str());
+    }
+    ShowPawnMenu(player, creature);
+    return true;
+}
