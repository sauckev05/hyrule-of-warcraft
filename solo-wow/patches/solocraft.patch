+    void SetFlagMight(Creature* c, uint32 from, uint32 to)
+    {
+        if (from == to || !c->IsAlive())
+            return;
+        float const share = c->GetMaxHealth() ? float(c->GetHealth()) / float(c->GetMaxHealth()) : 1.0f;
+        for (UnitMods mod : { UNIT_MOD_HEALTH, UNIT_MOD_ARMOR, UNIT_MOD_DAMAGE_MAINHAND, UNIT_MOD_DAMAGE_OFFHAND })
+        {
+            if (from)
+                c->HandleStatModifier(mod, TOTAL_PCT, BG_FLAG_MIGHT_PCT * from, false);
+            if (to)
+                c->HandleStatModifier(mod, TOTAL_PCT, BG_FLAG_MIGHT_PCT * to, true);
+        }
+        c->SetHealth(std::max<uint32>(1, uint32(c->GetMaxHealth() * share + 0.5f)));
+    }
