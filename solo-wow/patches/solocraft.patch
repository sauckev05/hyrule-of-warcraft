+void ZeldaCritHeal(Unit* attacker)
+{
+    const uint32 VANQUISHERS_MERCY = 40018;
+    if (!attacker || !attacker->IsAlive() || attacker->GetHealth() >= attacker->GetMaxHealth())
+        return;
+    Aura* mercy = attacker->GetAura(VANQUISHERS_MERCY, EFFECT_INDEX_0);
+    if (!mercy)
+        return;
+    int32 const pct = std::max(1, mercy->GetModifier()->m_amount);
+    uint32 const amount = std::max<uint32>(1, attacker->GetMaxHealth() * uint32(pct) / 100);
+    if (SpellEntry const* info = sSpellTemplate.LookupEntry<SpellEntry>(VANQUISHERS_MERCY))
+        attacker->DealHeal(attacker, amount, info);
+}
+
+void ZeldaAfterMeleeHit(Unit* attacker, Unit* victim, bool hit, uint8 attType)
+{
+    if (!hit || !attacker || !attacker->IsPlayer() || !victim || t_bonusSwing)
+        return;
+    Player* player = static_cast<Player*>(attacker);
+
+    // Mace Specialization: every mace hit crushes the enemy's armor, 1% per talent point, stacking
+    // up to five times (Crushing Blows)
+    if (victim->IsAlive())
+    {
+        uint32 const rank = ZeldaTalentRank(player, { 12284, 12701, 12702, 12703, 12704 });
+        Item* weapon = rank ? player->GetWeaponForAttack(WeaponAttackType(attType), true, true) : nullptr;
+        if (weapon && weapon->GetProto()->Class == ITEM_CLASS_WEAPON &&
+            (weapon->GetProto()->SubClass == ITEM_SUBCLASS_WEAPON_MACE || weapon->GetProto()->SubClass == ITEM_SUBCLASS_WEAPON_MACE2))
+        {
+            // one spell per rank (40013 = 1% ... 40017 = 5% a stack), each stack its full amount
+            const uint32 CRUSHING_BLOWS_RANK1 = 40013;
+            player->CastSpell(victim, CRUSHING_BLOWS_RANK1 + rank - 1, TRIGGERED_OLD_TRIGGERED);
+        }
+    }
+
+    // a solid hit sends the enemy back a step
+    float const knock = SetBonusOf(player, SET_BONUS_KNOCKBACK);
+    if (knock > 0.0f && victim->IsAlive() && roll_chance_f(knock))
+    {
+        if (victim->IsPlayer())
+            victim->KnockBackFrom(player, 6.0f, 2.0f);
+        else
+        {
+            Creature* creature = static_cast<Creature*>(victim);
+            CreatureInfo const* info = creature->GetCreatureInfo();
+            if (!creature->IsWorldBoss() && !(info && info->Rank == CREATURE_ELITE_WORLDBOSS))
+                creature->GetMotionMaster()->MovePushedBack(*player, 2.5f, 12.0f);
+        }
+    }
+
+    // or stuns the enemy for a moment (not world bosses)
+    float const stun = SetBonusOf(player, SET_BONUS_STUN);
+    if (stun > 0.0f && victim->IsAlive() && roll_chance_f(stun))
+    {
+        Creature const* creature = victim->GetTypeId() == TYPEID_UNIT ? static_cast<Creature const*>(victim) : nullptr;
+        if (!creature || !creature->IsWorldBoss())
+        {
+            const uint32 STUN_SPELL = 7922;     // Charge Stun, held for 1 second
+            player->CastSpell(victim, STUN_SPELL, TRIGGERED_OLD_TRIGGERED);
+            if (SpellAuraHolder* holder = victim->GetSpellAuraHolder(STUN_SPELL, player->GetObjectGuid()))
+            {
+                holder->SetAuraMaxDuration(1000);
+                holder->SetAuraDuration(1000);
+                holder->UpdateAuraDuration();
+            }
+        }
+    }
+
+    // and sometimes the blade swings again before the enemy can answer
+    float const extra = SetBonusOf(player, SET_BONUS_EXTRA_SWING);
+    if (extra > 0.0f && victim->IsAlive() && roll_chance_f(extra))
+    {
+        t_bonusSwing = true;
+        player->AttackerStateUpdate(victim, BASE_ATTACK, true);
+        t_bonusSwing = false;
+    }
+}
+
+void ZeldaOnKill(Player* killer, Creature* victim)
+{
+    if (!killer || !victim || !killer->IsAlive())
+        return;
+    float const pct = SetBonusOf(killer, SET_BONUS_HEAL_ON_KILL);
+    if (pct <= 0.0f || killer->GetHealth() >= killer->GetMaxHealth())
+        return;
+    CreatureInfo const* info = victim->GetCreatureInfo();
+    if (!info || info->CreatureType == CREATURE_TYPE_CRITTER || victim->GetLevel() + 8 < killer->GetLevel())
+        return;
+    uint32 const amount = std::max<uint32>(1, uint32(killer->GetMaxHealth() * pct / 100.0f));
+    if (SpellEntry const* healInfo = sSpellTemplate.LookupEntry<SpellEntry>(NAVI_HEAL_VISUAL))
+        killer->DealHeal(killer, amount, healInfo);
+    else
+        killer->ModifyHealth(int32(amount));
+}
