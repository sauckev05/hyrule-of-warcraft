+bool GossipHello_npc_zelda_companion(Player* player, Creature* creature)
+{
+    int32 index = CompanionIndex(creature->GetEntry());
+    if (index < 0)
+        return false;
+
+    // Lyra in the Deadmines: only the rescue
+    if (creature->GetEntry() == LYRA_CAPTIVE)
+    {
+        if (player->GetQuestStatus(QUEST_LYRA_RESCUE) == QUEST_STATUS_INCOMPLETE)
+            player->ADD_GOSSIP_ITEM(GOSSIP_ICON_CHAT, "Lyra? Lyra Ashford? I'm here to get you out.", GOSSIP_SENDER_MAIN, ACTION_RESCUE);
+        player->SEND_GOSSIP_MENU(900100, creature->GetObjectGuid());
+        return true;
+    }
+
+    // she grows with you
+    if (!creature->IsTemporarySummon() && index != ELARA_INDEX && creature->GetLevel() != player->GetLevel() && !creature->IsInCombat())
+        creature->SelectLevel(player->GetLevel());
+
+    if (creature->isQuestGiver())
+        player->PrepareQuestMenu(creature->GetObjectGuid());
+
+    Companion const& c = COMPANIONS[index];
+    player->ADD_GOSSIP_ITEM(GOSSIP_ICON_CHAT, "Tell me about yourself.", GOSSIP_SENDER_MAIN, ACTION_ABOUT);
+    if (creature->IsTemporarySummon())
+        player->ADD_GOSSIP_ITEM(GOSSIP_ICON_CHAT, "Go on back to your usual spot - I'll find you later.", GOSSIP_SENDER_MAIN, ACTION_DISMISS);
+    else
+    {
+        std::string ask = std::string("Travel with me for a while, ") + c.name + "?";
+        player->ADD_GOSSIP_ITEM(GOSSIP_ICON_CHAT, ask.c_str(), GOSSIP_SENDER_MAIN, ACTION_FOLLOW);
+    }
+    player->SEND_GOSSIP_MENU(c.textAbout - 9, creature->GetObjectGuid()); // greeting text sits 9 below "about"
+    return true;
+}
+
+bool GossipSelect_npc_zelda_companion(Player* player, Creature* creature, uint32 /*sender*/, uint32 action)
+{
+    int32 index = CompanionIndex(creature->GetEntry());
+    if (index < 0)
+        return false;
+    Companion const& c = COMPANIONS[index];
+
+    switch (action)
+    {
+        case ACTION_ABOUT:
+            player->SEND_GOSSIP_MENU(c.textAbout, creature->GetObjectGuid());
+            return true;
+        case ACTION_RESCUE:
+            player->CLOSE_GOSSIP_MENU();
+            player->KilledMonsterCredit(LYRA_CAPTIVE, creature->GetObjectGuid());
+            creature->SetStandState(UNIT_STAND_STATE_STAND);
+            creature->MonsterSay("Y-you came for me? Thank the Light... thank YOU! The Defias kept talking about a 'lady in the Keep'...", LANG_UNIVERSAL, player);
+            creature->HandleEmoteCommand(EMOTE_ONESHOT_CRY);
+            // she gets up and stays at the hero's side out of the mine (and after, until sent home)
+            {
+                float x, y, z;
+                player->GetNearPoint(player, x, y, z, 0.0f, 2.0f, player->GetOrientation() + M_PI_F);
+                if (Creature* follower = player->SummonCreature(LYRA_FREED, x, y, z, player->GetOrientation(), TEMPSPAWN_CORPSE_TIMED_DESPAWN, 10000))
+                {
+                    ZeldaFollowerSet(player, uint32(index), follower->GetEntry(), follower->GetObjectGuid());
+                    follower->MonsterSay("I-I'm staying close to you, if that's alright. Let's get out of here - and then the Bishop has to hear about this.", LANG_UNIVERSAL, player);
+                }
+                creature->SetRespawnDelay(600, true);
+                creature->ForcedDespawn(500);
+            }
+            return true;
+        case ACTION_FOLLOW:
+        {
+            player->CLOSE_GOSSIP_MENU();
+            float x, y, z;
+            player->GetNearPoint(player, x, y, z, 0.0f, 2.0f, player->GetOrientation() + M_PI_F);
+            if (Creature* follower = player->SummonCreature(creature->GetEntry(), x, y, z, player->GetOrientation(), TEMPSPAWN_CORPSE_TIMED_DESPAWN, 10000))
+            {
+                ZeldaFollowerSet(player, FollowerSlot(index), follower->GetEntry(), follower->GetObjectGuid());
+                follower->MonsterSay(Pick(c.join), LANG_UNIVERSAL, player);
+                // she has left her haunt for now
+                creature->SetRespawnDelay(600, true);
+                creature->ForcedDespawn(500);
+            }
+            return true;
+        }
+        case ACTION_DISMISS:
+            player->CLOSE_GOSSIP_MENU();
+            creature->MonsterSay(Pick(c.leave), LANG_UNIVERSAL, player);
+            ZeldaFollowerClear(player, FollowerSlot(index));
+            creature->ForcedDespawn(2000);
+            return true;
+    }
+    return false;
+}
+
+bool QuestRewarded_npc_zelda_companion(Player* player, Creature* creature, Quest const* quest)
+{
+    switch (quest->GetQuestId())
+    {
+        case QUEST_FAELIN_SILITHUS:
+            // the Scarab Wall has waited long enough: the gates of Ahn'Qiraj stand open from now on
+            if (sWorldState.GetAqPhase() < PHASE_5_DONE)
+                sWorldState.HandleWarEffortPhaseTransition(PHASE_5_DONE);
+            creature->MonsterSay("Did you feel that?! The ground just SHOOK. The Scarab Wall... it's open. Oh, we are SO going in there.", LANG_UNIVERSAL, player);
+            break;
+        case QUEST_LYRA_ONYXIA:
+            creature->MonsterSay("She's gone. She was in the King's own court all this time... I was so scared. But I'm not anymore. Not with you here.", LANG_UNIVERSAL, player);
+            break;
+        default:
+            break;
+    }
+    return false;
+}
