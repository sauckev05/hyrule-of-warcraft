+        {
+            for (ObjectGuid const& guid : state.bgSoldiers)
+                if (Creature* c = player->GetMap()->GetAnyTypeCreature(guid))
+                    c->ForcedDespawn();
+            for (ObjectGuid& guid : state.bgGuards)
+                if (Creature* c = guid ? player->GetMap()->GetAnyTypeCreature(guid) : nullptr)
+                    c->ForcedDespawn();
+            for (ObjectGuid& guid : state.bgBoss)
+                if (Creature* c = guid ? player->GetMap()->GetAnyTypeCreature(guid) : nullptr)
+                    c->ForcedDespawn();
+        }
+        state.bgBoss[0] = state.bgBoss[1] = ObjectGuid();
+        state.bgSoldiers.clear();
+        state.bgMight.clear();
+        state.bgMightTold[0] = state.bgMightTold[1] = 0;
+        for (uint32 i = 0; i < 8; ++i)
+        {
+            state.bgGuards[i] = ObjectGuid();
+            state.bgGuardDeadAt[i] = 0;
+        }
+        state.bgInstance = 0;
