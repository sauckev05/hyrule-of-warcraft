+void ZeldaLoadItemSets()
+{
+    s_setOfItem.clear();
+    s_setBonuses.clear();
+    if (auto result = WorldDatabase.Query("SELECT item, set_id FROM zelda_itemset_item"))
+    {
+        do
+        {
+            Field* f = result->Fetch();
+            s_setOfItem[f[0].GetUInt32()] = f[1].GetUInt32();
+        }
+        while (result->NextRow());
+    }
+    if (auto result = WorldDatabase.Query("SELECT set_id, pieces, bonus_type, value FROM zelda_itemset_bonus"))
+    {
+        do
+        {
+            Field* f = result->Fetch();
+            s_setBonuses.push_back({ f[0].GetUInt32(), f[1].GetUInt32(), f[2].GetUInt32(), f[3].GetFloat() });
+        }
+        while (result->NextRow());
+    }
+    sLog.outString(">> Zelda: loaded %u armor set pieces and %u set bonuses", uint32(s_setOfItem.size()), uint32(s_setBonuses.size()));
+}
