+        return false;
+    ZeldaState& state = StateFor(player);
+    // a follower being summoned right now is not registered yet: give it the benefit of the doubt
+    // only while the slot is empty
+    return state.followerEntry[index] && (state.followerGuid[index] == guid || !state.followerGuid[index]);
