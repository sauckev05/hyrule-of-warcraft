+void ZeldaAutoSellJunk(Player* player)
+{
+    static bool const junk = sConfig.GetBoolDefault("Zelda.AutoSellJunk", true);
+    static bool const whiteGear = sConfig.GetBoolDefault("Zelda.AutoSellWhiteGear", true);
+    if (!player || !junk)
+        return;
+
+    auto isJunk = [](ItemPrototype const* proto)
+    {
+        if (!proto || proto->SellPrice == 0 || proto->StartQuest || proto->Class == ITEM_CLASS_QUEST)
+            return false;
+        if (proto->Quality == ITEM_QUALITY_POOR)
+            return true;
+        // plain white weapons and armor (not shirts, tabards, bags or tools)
+        return whiteGear && proto->Quality == ITEM_QUALITY_NORMAL &&
+               (proto->Class == ITEM_CLASS_WEAPON || proto->Class == ITEM_CLASS_ARMOR) &&
+               proto->InventoryType != INVTYPE_BODY && proto->InventoryType != INVTYPE_TABARD &&
+               proto->InventoryType != INVTYPE_NON_EQUIP;
+    };
+
+    std::vector<Item*> sell;
+    for (uint8 slot = INVENTORY_SLOT_ITEM_START; slot < INVENTORY_SLOT_ITEM_END; ++slot)
+        if (Item* item = player->GetItemByPos(INVENTORY_SLOT_BAG_0, slot))
+            if (isJunk(item->GetProto()))
+                sell.push_back(item);
+    for (uint8 bagSlot = INVENTORY_SLOT_BAG_START; bagSlot < INVENTORY_SLOT_BAG_END; ++bagSlot)
+        if (Bag* bag = dynamic_cast<Bag*>(player->GetItemByPos(INVENTORY_SLOT_BAG_0, bagSlot)))
+            for (uint32 slot = 0; slot < bag->GetBagSize(); ++slot)
+                if (Item* item = bag->GetItemByPos(uint8(slot)))
+                    if (isJunk(item->GetProto()))
+                        sell.push_back(item);
+    if (sell.empty())
+        return;
+
+    uint32 total = 0, count = 0;
+    for (Item* item : sell)
+    {
+        if (player->GetLootGuid() == item->GetObjectGuid())
+            continue;
+        uint32 const money = item->GetProto()->SellPrice * item->GetCount() * ZeldaSellMultiplier();
+        player->ItemRemovedQuestCheck(item->GetEntry(), item->GetCount());
+        player->RemoveItem(item->GetBagSlot(), item->GetSlot(), true);
+        item->RemoveFromUpdateQueueOf(player);
+        player->AddItemToBuyBackSlot(item, money);
+        player->ModifyMoney(money);
+        total += money;
+        ++count;
+    }
+    if (count)
+        ChatHandler(player).PSendSysMessage("|cffffff00Sold %u junk item%s for %ug %us %uc.|r", count, count == 1 ? "" : "s",
+                                            total / 10000, (total % 10000) / 100, total % 100);
+}
