+// ".zmount <item>": the mount slot (ZeldaControls potion.lua, key 7). Mounted, it gets off;
+// otherwise it uses that mount from the bags.
+bool ChatHandler::HandleZeldaMountCommand(char* args)
+{
+    Player* player = m_session->GetPlayer();
+    if (player->IsMounted())
+    {
+        player->RemoveSpellsCausingAura(SPELL_AURA_MOUNTED);
+        return true;
+    }
+    uint32 const itemId = args ? uint32(std::strtoul(args, nullptr, 10)) : 0;
+    Item* item = itemId ? player->GetItemByEntry(itemId) : nullptr;
+    if (!item || item->IsEquipped())
+    {
+        m_session->SendNotification("That mount is not in your bags.");
+        return true;
+    }
+    InventoryResult const msg = player->CanUseItem(item);
+    if (msg != EQUIP_ERR_OK)
+    {
+        player->SendEquipError(msg, item, nullptr);
+        return true;
+    }
+    if (player->IsInCombat() || player->IsNonMeleeSpellCasted(false))
+    {
+        m_session->SendNotification("You can't mount right now.");
+        return true;
+    }
+    SpellCastTargets targets;
+    targets.setUnitTarget(player);
+    player->CastItemUseSpell(item, targets, 0);
+    return true;
+}
+
+// .zbag <bag> <slot> (the client's container and 1-based slot): puts that bag on - into an empty
+// bag slot, else in place of the smallest bag worn when it is bigger. The smaller bag's things move
+// to free room elsewhere first, and the smaller bag goes where the new one was.
+bool ChatHandler::HandleZeldaBagCommand(char* args)
+{
+    Player* player = m_session->GetPlayer();
+    uint32 clientBag = 0, clientSlot = 0;
+    if (!args || sscanf(args, "%u %u", &clientBag, &clientSlot) != 2 || clientBag > 4 || clientSlot == 0)
+        return true;
+    auto pos = [](uint8 bag, uint8 slot) { return uint16((uint16(bag) << 8) | slot); };
+    uint8 const srcBag = clientBag == 0 ? uint8(INVENTORY_SLOT_BAG_0) : uint8(INVENTORY_SLOT_BAG_START + clientBag - 1);
+    uint8 const srcSlotIdx = clientBag == 0 ? uint8(INVENTORY_SLOT_ITEM_START + clientSlot - 1) : uint8(clientSlot - 1);
+    uint16 src = pos(srcBag, srcSlotIdx);
+    Item* item = player->GetItemByPos(src);
+    if (!item || item->GetProto()->InventoryType != INVTYPE_BAG)
+        return true;
+    if (player->IsInCombat())
+    {
+        m_session->SendNotification("You can't change bags in combat.");
+        return true;
+    }
+
+    // an empty bag slot: straight in
+    for (uint8 b = INVENTORY_SLOT_BAG_START; b < INVENTORY_SLOT_BAG_END; ++b)
+        if (!player->GetItemByPos(INVENTORY_SLOT_BAG_0, b))
+        {
+            player->SwapItem(src, pos(INVENTORY_SLOT_BAG_0, b));
+            return true;
+        }
+
+    // else the smallest bag worn
+    uint8 target = 0;
+    uint32 targetSize = 0xFFFFFFFF;
+    for (uint8 b = INVENTORY_SLOT_BAG_START; b < INVENTORY_SLOT_BAG_END; ++b)
+        if (Bag* bag = dynamic_cast<Bag*>(player->GetItemByPos(INVENTORY_SLOT_BAG_0, b)))
+            if (bag->GetBagSize() < targetSize)
+            {
+                target = b;
+                targetSize = bag->GetBagSize();
+            }
+    if (!target)
+        return true;
+    if (item->GetProto()->ContainerSlots <= targetSize)
+    {
+        m_session->SendNotification("Your smallest bag already holds %u - this one is no bigger.", targetSize);
+        return true;
+    }
+
+    // room for the smaller bag's things: the backpack and the other ordinary bags
+    std::vector<uint16> freeSlots;
+    for (uint8 s = INVENTORY_SLOT_ITEM_START; s < INVENTORY_SLOT_ITEM_END; ++s)
+        if (!player->GetItemByPos(INVENTORY_SLOT_BAG_0, s))
+            freeSlots.push_back(pos(INVENTORY_SLOT_BAG_0, s));
+    for (uint8 b = INVENTORY_SLOT_BAG_START; b < INVENTORY_SLOT_BAG_END; ++b)
+    {
+        if (b == target)
+            continue;
+        Bag* bag = dynamic_cast<Bag*>(player->GetItemByPos(INVENTORY_SLOT_BAG_0, b));
+        if (!bag || bag->GetProto()->SubClass != ITEM_SUBCLASS_CONTAINER)
+            continue;                                   // soul, herb and other special bags take only their own
+        for (uint32 s = 0; s < bag->GetBagSize(); ++s)
+            if (!bag->GetItemByPos(uint8(s)))
+                freeSlots.push_back(pos(b, uint8(s)));
+    }
+    std::vector<uint16> inside;
+    Bag* old = static_cast<Bag*>(player->GetItemByPos(INVENTORY_SLOT_BAG_0, target));
+    for (uint32 s = 0; s < old->GetBagSize(); ++s)
+        if (old->GetItemByPos(uint8(s)))
+            inside.push_back(pos(target, uint8(s)));
+    if (inside.size() > freeSlots.size())
+    {
+        m_session->SendNotification("Make room for %u more items first.", uint32(inside.size() - freeSlots.size()));
+        return true;
+    }
+    for (size_t i = 0; i < inside.size(); ++i)
+    {
+        player->SwapItem(inside[i], freeSlots[i]);
+        if (inside[i] == src)
+            src = freeSlots[i];                         // the new bag itself was in the small one
+    }
+    if (!old->IsEmpty())
+    {
+        m_session->SendNotification("Couldn't empty your smallest bag.");
+        return true;
+    }
+    player->SwapItem(src, pos(INVENTORY_SLOT_BAG_0, target));
+    return true;
+}
+
+bool ChatHandler::HandleZeldaShieldCommand(char* args)
+{
+    Player* player = m_session->GetPlayer();
+    ZeldaState& state = StateFor(player);
+
+    bool on = !state.shield;
+    if (args && *args)
+    {
+        std::string a = args;
+        if (a == "on" || a == "1")
+            on = true;
+        else if (a == "off" || a == "0")
+            on = false;
+    }
+    if (on && !CanAct(player))
+        on = false;
+    // with a shield the hero blocks; with only a weapon the hero holds it up to parry every melee
+    // blow from the front (ZeldaParryHolds); the Zelda client holds the pose while the key is down
+    bool const hasShield = player->GetShield(true) != nullptr;
+    bool const hasWeapon = player->GetWeaponForAttack(BASE_ATTACK, true, true) != nullptr;
+    if (on && !hasShield && !hasWeapon)
+    {
+        SendSysMessage("You need a shield to block or a weapon to parry.");
+        on = false;
+    }
+    bool const shield = on && hasShield;
+    bool const parry = on && !hasShield;
+    if (shield == state.shield && parry == state.parry)
+        return true;
+
+    state.shield = shield;
+    state.parry = parry;
+    player->UpdateSpeed(MOVE_RUN, true);       // ZeldaSpeedFactor slows a raised guard
+    // while the guard is up the hero stands firm, so the held pose never breaks into a walk
+    // (turning still works); a root or stun from elsewhere is left as it is
+    if ((shield || parry) && !state.guardRooted)
+    {
+        state.guardRooted = true;
+        player->addUnitState(UNIT_STAT_AI_ROOT);
+        player->SendMoveRoot(true);
+    }
+    else if (!shield && !parry && state.guardRooted)
+    {
+        state.guardRooted = false;
+        player->clearUnitState(UNIT_STAT_AI_ROOT);
+        if (!player->IsImmobilizedState())
+            player->SendMoveRoot(false);
+    }
+    if (shield)
+        player->HandleEmoteCommand(EMOTE_ONESHOT_PARRYSHIELD);
+    return true;
+}
+
+// The selected enemy if it is alive, in range and in sight; otherwise the enemy closest to where the
+// hero faces, within 60 degrees.
+static Unit* ZeldaAimTarget(Player* player, float range)
+{
+    Unit* target = ObjectAccessor::GetUnit(*player, player->GetSelectionGuid());
+    if (target && (target == player || !target->IsAlive() || !player->CanAttack(target) ||
+                   !player->IsWithinDistInMap(target, range) || !player->IsWithinLOSInMap(target)))
+        target = nullptr;
+    if (target)
+        return target;
+
+    std::list<Unit*> enemies;
+    CollectEnemies(player, range, enemies);
+    float best = M_PI_F / 3.0f;
+    for (Unit* unit : enemies)
+    {
+        float off = std::fabs(MapManager::NormalizeOrientation(player->GetAngle(unit) - player->GetOrientation()));
+        if (off > M_PI_F)
+            off = 2.0f * M_PI_F - off;
+        if (off < best)
+        {
+            best = off;
+            target = unit;
+        }
+    }
+    return target;
+}
