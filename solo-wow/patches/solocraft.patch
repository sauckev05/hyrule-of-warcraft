+uint32 ZeldaGameDayIndex(time_t now)
+{
+    static float const dayMinutes = sConfig.GetFloatDefault("Zelda.DayLengthMinutes", 60.0f);
+    if (dayMinutes <= 0.0f || dayMinutes >= 1440.0f)
+        return uint32(now / 86400);
+    float const factor = 1440.0f / dayMinutes;
+    time_t const anchor = 1767225600;               // as ZeldaPackedGameTime
+    double const elapsed = double(now > anchor ? now - anchor : 0);
+    return uint32((double(anchor) + elapsed * factor) / 86400.0);
+}
