+bool ZeldaManaPotionShield(Unit* target, ItemPrototype const* item, SpellEntry const& spell, int32 mana)
+{
+    if (!target || target->GetTypeId() != TYPEID_PLAYER || mana <= 0 || !ZeldaManaPotionShieldItem(item, spell))
+        return false;
+    Player* player = static_cast<Player*>(target);
+    player->RemoveAurasDueToSpell(POTION_SHIELD);
+    player->CastCustomSpell(player, POTION_SHIELD, &mana, nullptr, nullptr, TRIGGERED_OLD_TRIGGERED);
+    player->GetSession()->SendAreaTriggerMessage("Potion Shield: absorbs %d damage", mana);
+    return true;
+}
