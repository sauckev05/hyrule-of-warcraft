+
+    struct Rank { uint32 level; uint32 spell; };
+
+    uint32 BestRank(std::vector<Rank> const& ranks, uint32 level)
+    {
+        uint32 best = 0;
+        for (Rank const& r : ranks)
+            if (r.level <= level)
+                best = r.spell;
+        return best;
+    }
+
+    // ---------------------------------------------------------------- spells by rank (learn level)
