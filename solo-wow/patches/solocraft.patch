+    std::vector<Rank> const CURSE_OF_AGONY = { {8, 980}, {18, 1014}, {28, 6217}, {38, 11711}, {48, 11712}, {58, 11713} };
+    std::vector<Rank> const DEMON_ARMOR    = { {1, 687}, {10, 696}, {20, 706}, {30, 1086}, {40, 11733}, {50, 11734}, {60, 11735} };
+
+    // ---------------------------------------------------------------- who they are
+    struct Companion
+    {
+        char const* name;
+        Role role;
+        float castRange;
+        uint32 textAbout;                      // npc_text: "Tell me about yourself"
+        std::vector<char const*> idle;         // said now and then when a hero is near
+        std::vector<char const*> join;         // when she starts travelling with you
+        std::vector<char const*> leave;        // when she heads back to her haunt
+        std::vector<char const*> aggro;
+        std::vector<char const*> kill;
+        std::vector<char const*> hurt;         // the hero is badly hurt
+        std::vector<char const*> died;
+    };
+
+    std::vector<Companion> const COMPANIONS =
+    {
+        {   // 0: Lyra Ashford - human priest, shy but curious
+            "Lyra", ROLE_PRIEST, 20.0f, 900110,
+            {
+                "Oh! I didn't see you there... sorry. I was just, um, reading the inscriptions.",
+                "Did you know every chapel in Stormwind was built facing the sunrise? I counted. Twice.",
+                "*fidgets with the hem of her robe* ...Do you think the Light listens even when you whisper?",
+                "I keep wondering who carved these stones. Somebody's hands made all of this...",
+                "S-sorry, I talk to myself when I'm nervous. And when I'm not nervous. Sorry.",
+                "There's a book in the Cathedral library about the old dragon wars. Nobody ever checks it out but me.",
+            },
+            {
+                "Y-you want me to come with you? I'll... I'll do my best. I promise.",
+                "Okay. Okay! I'll stay close. Please don't walk too fast.",
+            },
+            {
+                "I'll wait where I always do. You... you'll come back, won't you?",
+                "Thank you for letting me tag along. It was... nice. Really nice.",
+            },
+            { "Light, give me courage...", "Stay behind me! No, wait - I'll stay behind you!", "I-I can do this!" },
+            { "Is it... is it over? Oh, thank the Light.", "Light forgive me. They didn't leave us a choice." },
+            { "You're hurt! Hold still, please!", "Don't you dare fall - I'm right here!" },
+            { "I... I'm sorry... I wasn't brave enough..." },
+        },
+        {   // 1: Faelin Swiftbreeze - night elf hunter, adventurous and high-energy
+            "Faelin", ROLE_HUNTER, 15.0f, 900210,
+            {
+                "Ten thousand years of sitting under trees and NOBODY thought to climb the big ones? Unbelievable.",
+                "Look at these tracks! Something with way too many legs went that way. Wanna find out what?",
+                "*bounces on her heels* I'm not restless. YOU'RE restless.",
+                "Race you to the next hill! ...Okay fine, but I'm counting this as a win.",
+                "The Sentinels say I'm 'reckless'. I say I'm efficient at finding trouble.",
+                "Shh! Hear that? Water, birds, wind... and something whispering under all of it.",
+            },
+            {
+                "YES! Finally, an adventure partner who doesn't nap! Let's go!",
+                "Lead the way - or don't, I'll probably run ahead anyway.",
+            },
+            {
+                "Okay, okay, I'll head back. But you'd better come find me for the next one!",
+                "That was amazing. Same time next adventure?",
+            },
+            { "Ooh, this one's mine!", "Arrows up! Let's dance!", "You picked the wrong elf to annoy!" },
+            { "Ha! Did you see that shot?!", "Next!", "Too easy. Find me a bigger one." },
+            { "Hey! Hey, stay on your feet! I'm not carrying you home!", "Back off from my friend!" },
+            { "Ugh... tell the trees... I almost had it..." },
+        },
+        {   // 2: Durza Stormcaller - orc shaman, aggressive but emotional
+            "Durza", ROLE_SHAMAN, 18.0f, 900310,
+            {
+                "What are you staring at? ...Sorry. I'm not angry at you. I'm angry at EVERYTHING.",
+                "The fire here won't listen to me. It used to. It used to sing.",
+                "My mother could calm a firestorm with one word. I can't even calm myself.",
+                "*cracks her knuckles* If one more elemental talks back to me, I swear on my ancestors...",
+                "Lok'tar. Or hello. Whatever you people say.",
+                "...Don't tell anyone you saw me cry. I had dust in my eyes. A lot of dust.",
+            },
+            {
+                "Fine. You fight beside me - and if you fall behind, I'm NOT waiting. ...I'll wait a little.",
+                "Good. I hit things harder when someone's watching my back.",
+            },
+            {
+                "Go on then. I'll be where I always am. ...Come back in one piece, you hear me?",
+                "You fought well. Don't let it go to your head.",
+            },
+            { "FOR THE ANCESTORS!", "You'll burn before I do!", "Spirits, give me your fury!" },
+            { "Stay down!", "That's what you get!", "Ha! The elements are with me today." },
+            { "NO! Not you too - Spirits, mend them!", "Get up! I'm not losing anyone else!" },
+            { "Mother... I tried..." },
+        },
+        {   // 3: Vesper Duskhollow - undead warlock, mysterious and gothic
+            "Vesper", ROLE_WARLOCK, 22.0f, 900410,
+            {
+                "The dead are such good listeners. You living types interrupt.",
+                "Lovely evening. Overcast, a little damp, the faint smell of rot. Perfect.",
+                "*traces a sigil in the air; it fades into violet smoke* Don't mind me. Old habits.",
+                "I used to be afraid of the dark. Then I became the reason others are.",
+                "Do you hear the bells? No? Good. That means they are only ringing for me.",
+                "Black isn't a color. It's a promise.",
+            },
+            {
+                "How sweet. You want company of the unliving kind. Very well.",
+                "I will walk with you. Try not to die - I would hate to have to bring you back.",
+            },
+            {
+                "The graves are calling me home. Do visit. Bring something dead.",
+                "Until the next night falls, then.",
+            },
+            { "Your soul looks... delicious.", "Shadows, take them.", "Scream if you like. It helps me focus." },
+            { "Another one for the dark.", "Rest. Or don't. I'm not the one to ask.", "Hm. Brittle." },
+            { "Stay with me. Death is MY hobby, not yours.", "Do not die. I mean it." },
