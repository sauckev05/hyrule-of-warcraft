+// .zhook is the boomerang now (the old hookshot key)
+bool ChatHandler::HandleZeldaHookCommand(char* args)
+{
+    return HandleZeldaBoomerangCommand(args);
+}
+
+uint32 ZeldaPackedGameTime(time_t now, float& speed)
+{
+    static float const dayMinutes = sConfig.GetFloatDefault("Zelda.DayLengthMinutes", 60.0f);
+    if (dayMinutes <= 0.0f || dayMinutes >= 1440.0f)
+    {
+        speed = 1.0f / 60.0f;                       // real time
+        return secsToTimeBitFields(now);
+    }
+    float const factor = 1440.0f / dayMinutes;      // game seconds per real second
+    time_t const anchor = 1767225600;               // 2026-01-01: keeps the packed year small
+    double const elapsed = double(now > anchor ? now - anchor : 0);
+    time_t const gameNow = anchor + time_t(elapsed * factor);
+    speed = factor / 60.0f;
+    return secsToTimeBitFields(gameNow);
+}
+
+uint32 ZeldaItemSheath(ItemPrototype const* proto)
+{
+    static bool const oneHandOnBack = sConfig.GetBoolDefault("Zelda.OneHandOnBack", true);
+    // one-handed maces stay at the hip: on the back they clash with the shield
+    if (oneHandOnBack && proto->Class == ITEM_CLASS_WEAPON && proto->Sheath == 3 &&
+        proto->SubClass != ITEM_SUBCLASS_WEAPON_MACE &&
+        (proto->InventoryType == INVTYPE_WEAPON || proto->InventoryType == INVTYPE_WEAPONMAINHAND ||
+         proto->InventoryType == INVTYPE_WEAPONOFFHAND))
+        return 1; // on the back, drawn over the shoulder
+    return proto->Sheath;
+}
+
+namespace
+{
+    // Bind on Equip weapons and armor by quality (green, blue, purple) and required level 1..60.
+    struct BoePools
+    {
+        std::array<std::array<std::vector<uint32>, 61>, 3> byQuality;
+    };
+
+    bool StartsWith(std::string const& s, char const* prefix)
+    {
+        return s.compare(0, std::char_traits<char>::length(prefix), prefix) == 0;
+    }
+
+    BoePools BuildBoePools()
+    {
+        BoePools pools;
+        for (uint32 id = 0; id < sItemStorage.GetMaxEntry(); ++id)
+        {
+            ItemPrototype const* proto = sItemStorage.LookupEntry<ItemPrototype>(id);
+            if (!proto || proto->Bonding != BIND_WHEN_EQUIPPED)
+                continue;
+            if (proto->Class != ITEM_CLASS_WEAPON && proto->Class != ITEM_CLASS_ARMOR)
+                continue;
+            if (proto->InventoryType == INVTYPE_NON_EQUIP || proto->InventoryType == INVTYPE_BODY || proto->InventoryType == INVTYPE_TABARD)
+                continue;
+            if (proto->Quality < ITEM_QUALITY_UNCOMMON || proto->Quality > ITEM_QUALITY_EPIC)
+                continue;
+            if (proto->RequiredLevel < 1 || proto->RequiredLevel > 60)
+                continue;
+            std::string const name = proto->Name1 ? proto->Name1 : "";
+            if (name.empty() || StartsWith(name, "Deprecated") || StartsWith(name, "Test") || StartsWith(name, "TEST") ||
+                StartsWith(name, "Monster") || StartsWith(name, "[PH]") || StartsWith(name, "OLD") || StartsWith(name, "QA") ||
+                name.find("Test ") != std::string::npos || name.find("(test)") != std::string::npos)
+                continue;
+            pools.byQuality[proto->Quality - ITEM_QUALITY_UNCOMMON][proto->RequiredLevel].push_back(proto->ItemId);
+        }
+        return pools;
+    }
+
+    // herbs, ore veins and fishing pools are chests to the game; they get nothing extra
+    bool IsGatheringNode(GameObjectInfo const* info)
+    {
+        if (LockEntry const* lock = sLockStore.LookupEntry(info->chest.lockId))
+            for (uint32 i = 0; i < MAX_LOCK_CASE; ++i)
+                if (lock->Type[i] == LOCK_KEY_SKILL &&
+                    (lock->Index[i] == LOCKTYPE_HERBALISM || lock->Index[i] == LOCKTYPE_MINING || lock->Index[i] == LOCKTYPE_FISHING))
+                    return true;
+        return false;
+    }
+
+    bool LooksLikeTreasure(GameObjectInfo const* info)
+    {
+        std::string name = info->name ? info->name : "";
+        for (char& c : name)
+            c = char(std::tolower(static_cast<unsigned char>(c)));
+        for (char const* word : { "chest", "strongbox", "coffer", "trunk", "footlocker", "lockbox", "treasure" })
+            if (name.find(word) != std::string::npos)
+                return true;
+        return false;
+    }
+
+    uint32 PickBoe(BoePools const& pools, uint32 quality, int32 level)
+    {
+        std::vector<uint32> const* lists[12];
+        uint32 count = 0;
+        uint32 total = 0;
+        // first the five levels up to the zone's, then a wider band
+        for (int32 spread : { 4, 8 })
+        {
+            count = 0;
+            total = 0;
+            for (int32 l = std::max(1, level - spread); l <= std::min(60, level + (spread > 4 ? 2 : 0)); ++l)
+            {
+                auto const& list = pools.byQuality[quality][l];
+                if (!list.empty() && count < 12)
+                {
+                    lists[count++] = &list;
+                    total += uint32(list.size());
+                }
+            }
+            if (total)
+                break;
+        }
+        if (!total)
+            return 0;
+        uint32 pick = urand(0, total - 1);
+        for (uint32 i = 0; i < count; ++i)
+        {
+            if (pick < lists[i]->size())
+                return (*lists[i])[pick];
+            pick -= uint32(lists[i]->size());
+        }
+        return 0;
+    }
+}
+
+void ZeldaChestBonus(Loot* loot, GameObject* chest, Player* opener)
+{
+    static int32 const chance = sConfig.GetIntDefault("Zelda.ChestBoEChance", 50);
+    if (!loot || !chest || !opener || chance <= 0)
+        return;
+    GameObjectInfo const* info = chest->GetGOInfo();
+    if (!info || info->type != GAMEOBJECT_TYPE_CHEST || IsGatheringNode(info) || !LooksLikeTreasure(info))
+        return;
+    if (!roll_chance_i(chance))
+        return;
+
+    // the zone's level: the area's exploration level, else its zone's, else the hero's own
+    uint32 zoneId = 0, areaId = 0;
+    chest->GetZoneAndAreaId(zoneId, areaId);
+    int32 level = 0;
+    if (AreaTableEntry const* area = GetAreaEntryByAreaID(areaId))
+        level = area->area_level;
+    if (level <= 0)
+        if (AreaTableEntry const* zone = GetAreaEntryByAreaID(zoneId))
+            level = zone->area_level;
+    if (level <= 0)
+        level = int32(opener->GetLevel());
+    level = std::min(60, std::max(1, level));
+
+    static BoePools const pools = BuildBoePools();
+    uint32 const roll = urand(1, 100);
+    uint32 quality = roll <= 2 ? 2u : (roll <= 17 ? 1u : 0u); // 2% purple, 15% blue, else green
+    uint32 itemId = 0;
+    for (int32 q = int32(quality); q >= 0 && !itemId; --q)
+        itemId = PickBoe(pools, uint32(q), level);
+    if (itemId)
+        loot->AddItem(LootStoreItem(0, itemId, 100.0f, 0, 0, 1, 1));
+}
+
+void ZeldaAutoLoot(Player* looter, Loot* loot)
+{
+    static bool const autoLoot = sConfig.GetBoolDefault("Zelda.AutoLoot", true);
+    if (!autoLoot || !looter || !loot || !looter->IsInWorld() || !looter->GetSession() || looter->GetGroup())
+        return;
+
+    loot->AutoStore(looter);
+
+    uint32 const gold = loot->GetGoldAmount();
+    if (gold)
+    {
+        ChatHandler(looter).PSendSysMessage("|cffffff00You loot %ug %us %uc.|r", gold / 10000, (gold % 10000) / 100, gold % 100);
+        loot->SendGold(looter);               // releases the corpse when it is now empty
+    }
+    else if (loot->IsLootedFor(looter))
+        loot->Release(looter);                // empty: stop the sparkle, allow skinning
+}
+
+uint32 ZeldaBoomerangDamage(Player* player)
+{
+    // one roll of the main-hand weapon, as a normal swing would deal before armor
+    return player->CalculateDamage(BASE_ATTACK, false, 0);
+}
+
+bool ZeldaBoomerangTrigger(Player* player, Unit* target, uint8 effIndex)
+{
+    if (effIndex == 1 && target && target->IsAlive())
+        player->CastSpell(target, roll_chance_i(50) ? 15753u : 15752u, TRIGGERED_OLD_TRIGGERED); // Knockdown : Disarm
+    return true; // the DBC's own triggers (both at 101%) are replaced by the 50/50 above
+}
+
+bool ChatHandler::HandleZeldaBowCommand(char* /*args*/)
+{
+    Player* player = m_session->GetPlayer();
+    if (!CanAct(player))
+        return true;
+
+    Item* ranged = player->GetWeaponForAttack(RANGED_ATTACK, true, true);
+    if (!ranged)
+    {
+        SendSysMessage("Equip a bow, crossbow, gun, thrown weapon or wand in your ranged slot first.");
+        return true;
+    }
+
+    uint32 spellId = 0;
+    switch (ranged->GetProto()->SubClass)
+    {
+        case ITEM_SUBCLASS_WEAPON_BOW:      spellId = 2480; break; // Shoot Bow
+        case ITEM_SUBCLASS_WEAPON_GUN:      spellId = 7918; break; // Shoot Gun
+        case ITEM_SUBCLASS_WEAPON_CROSSBOW: spellId = 7919; break; // Shoot Crossbow
+        case ITEM_SUBCLASS_WEAPON_THROWN:   spellId = 2764; break; // Throw
+        case ITEM_SUBCLASS_WEAPON_WAND:     spellId = 5019; break; // Shoot (wand)
+        default:
+            SendSysMessage("That ranged item can't be fired.");
+            return true;
+    }
+
+    ZeldaState& state = StateFor(player);
+    uint32 now = WorldTimer::getMSTime();
+    if (now < state.bowReadyAt)
+        return true;
+
+    Unit* target = ZeldaAimTarget(player, BOW_RANGE);
+    if (!target)
+    {
+        SendSysMessage("No enemy in your sights.");
+        return true;
+    }
+
+    state.bowReadyAt = now + BOW_COOLDOWN_MS;
+    player->SetFacingToObject(target);
+    // Arrows come from your ammo pouch, like Link's quiver: no ammo, no shot.
+    player->CastSpell(target, spellId, TRIGGERED_INSTANT_CAST | TRIGGERED_IGNORE_GCD | TRIGGERED_IGNORE_COOLDOWNS);
+    return true;
+}
