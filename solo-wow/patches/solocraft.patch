+void ZeldaWorldThreadUpdate(Player* player)
+{
+    static bool const resetOnLeave = sConfig.GetBoolDefault("Zelda.ResetDungeonsOnLeave", true);
+    if (!player || !player->IsInWorld() || player->IsBeingTeleported())
+        return;
+    ZeldaState& state = StateFor(player);
+    if (!state.pendingDungeonReset)
+        return;
+    state.pendingDungeonReset = false;
+    if (resetOnLeave && !state.inDungeonMap && !player->GetMap()->IsDungeon() && !player->GetGroup())
+        player->ResetInstances(INSTANCE_RESET_ALL);
+}
