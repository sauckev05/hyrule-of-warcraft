+
+int32 ZeldaRageGain(int32 gain)
+{
+    static float const rate = std::max(0.0f, sConfig.GetFloatDefault("Zelda.RageGainRate", 0.5f));
+    if (gain > 0 && t_spinNoRage)
+        return 0;
+    if (gain <= 0 || rate == 1.0f)
+        return gain;
+    // rage is stored x10, so a half of an odd amount keeps its tenth of a point on average
+    float const scaled = gain * rate;
+    int32 whole = int32(scaled);
+    if (scaled - whole > 0.0f && roll_chance_f((scaled - whole) * 100.0f))
+        ++whole;
+    return whole;
+}
+
+uint32 ZeldaDungeonXP(uint32 xp)
+{
+    static float const rate = std::max(0.0f, sConfig.GetFloatDefault("Zelda.DungeonXPRate", 0.5f));
+    if (rate == 1.0f)
+        return xp;
+    return std::max<uint32>(1, uint32(xp * rate + 0.5f));
+}
