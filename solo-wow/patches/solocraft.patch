+namespace
+{
+    // ------------------------------------------------------------------ cross-faction friendship
+    // Every faction that stands with the other side (its cities, guards, vendors, flight masters)
+    // is forced friendly for the hero, so Alliance and Horde can walk, talk and trade together.
+    std::set<uint32> const& OppositeFactions(Team team)
+    {
+        // Factions of the other side. A faction counts only when every template of it belongs to that
+        // side, or it is a real reputation faction (Orgrimmar has a neutral template too). Faction 7,
+        // "Creature", also has one Horde template, and must never be included: it is every neutral boar,
+        // wolf and crab in the world.
+        static std::set<uint32> horde, alliance;
+        static std::once_flag once;
+        std::call_once(once, []()
+        {
+            std::map<uint32, uint32> sides;     // faction -> bit 1 horde, 2 alliance, 4 neither
+            for (uint32 i = 0; i < sFactionTemplateStore.GetNumRows(); ++i)
+            {
+                FactionTemplateEntry const* t = sFactionTemplateStore.LookupEntry(i);
+                if (!t || !t->faction)
+                    continue;
+                bool const isHorde = (t->factionGroupMask & FACTION_GROUP_MASK_HORDE) ||
+                    ((t->friendGroupMask & FACTION_GROUP_MASK_HORDE) && (t->enemyGroupMask & FACTION_GROUP_MASK_ALLIANCE));
+                bool const isAlliance = (t->factionGroupMask & FACTION_GROUP_MASK_ALLIANCE) ||
+                    ((t->friendGroupMask & FACTION_GROUP_MASK_ALLIANCE) && (t->enemyGroupMask & FACTION_GROUP_MASK_HORDE));
+                sides[t->faction] |= (isHorde && !isAlliance) ? 1 : (isAlliance && !isHorde) ? 2 : 4;
+            }
+            for (auto const& [faction, bits] : sides)
+            {
+                FactionEntry const* entry = sFactionStore.LookupEntry(faction);
+                bool const reputation = entry && entry->HasReputation();
+                if ((bits & 4) && !reputation)
+                    continue;
+                if (bits == 1 || bits == (1 | 4))
+                    horde.insert(faction);
+                else if (bits == 2 || bits == (2 | 4))
+                    alliance.insert(faction);
+            }
+        });
+        return team == ALLIANCE ? horde : alliance;
+    }
+
+    void ApplyCrossFaction(Player* player)
+    {
+        static bool const crossFaction = sConfig.GetBoolDefault("Zelda.CrossFaction", true);
+        if (!crossFaction)
+            return;
+        ReputationMgr& rep = player->GetReputationMgr();
+        for (uint32 faction : OppositeFactions(player->GetTeam()))
+            rep.ApplyForceReaction(faction, REP_FRIENDLY, true);
+        rep.SendForceReactions();
+    }
+
+    // ------------------------------------------------------------------ the companions' chapters
+    // zelda_stage: which spawn of a companion a hero can see, by quest progress. A state of 0 means
+    // "taken (or done)", 1 means "rewarded".
+    struct StageRule
+    {
+        uint32 showQuest = 0;
+        uint8 showState = 1;
+        uint32 hideQuest = 0;
+        uint8 hideState = 1;
+    };
+    std::unordered_map<uint32, StageRule> s_stages;
+
+    bool QuestReached(Player const* player, uint32 quest, uint8 state)
+    {
+        if (player->GetQuestRewardStatus(quest))
+            return true;
+        if (state == 0)
+            return player->GetQuestStatus(quest) != QUEST_STATUS_NONE;
+        return false;
+    }
+
+    uint32 const COMPANION_COUNT = 6;
+
+    // Navi and her light: while the trinket is worn, the wisp follows, heals in combat and revives
+    uint32 const NAVI_INDEX = 4;
+    uint32 const NAVI_ENTRY = 190601;
+    uint32 const NAVI_TRINKET = 190601;
+    uint32 const NAVI_HEAL_VISUAL = 2061;          // Flash Heal's golden glow on the hero
+    uint32 const HEART_PIECE = 190602;
+    uint32 const HEART_PIECE_QUEST = 90502;
+
+    // ---- Zelda armor sets (zelda_itemset_item / zelda_itemset_bonus, made by build_content.py) ----
+    enum SetBonusType
+    {
+        SET_BONUS_CRIT          = 1,    // % melee and ranged critical strike chance
+        SET_BONUS_CRIT_DAMAGE   = 2,    // % more critical strike damage
+        SET_BONUS_WEAPON_DAMAGE = 3,    // % more weapon damage
+        SET_BONUS_KNOCKBACK     = 4,    // % chance a hit pushes the enemy back
+        SET_BONUS_EXTRA_SWING   = 5,    // % chance a hit swings again at once
+        SET_BONUS_SPIN_RAGE     = 6,    // rage the Spin Attack costs less
+        SET_BONUS_HEAL_ON_KILL  = 7,    // % of health back on every kill
+        SET_BONUS_MAX           = 8
+    };
+    struct SetBonusRow
+    {
+        uint32 set;
+        uint32 pieces;
+        uint32 type;
+        float value;
+    };
+    std::unordered_map<uint32, uint32> s_setOfItem;
+    std::vector<SetBonusRow> s_setBonuses;
+
+    thread_local bool t_bonusSwing = false;     // an extra swing from a set never chains another
+
+    float SetBonusOf(Unit const* unit, uint32 type)
+    {
+        if (!unit || !unit->IsPlayer() || type >= SET_BONUS_MAX)
+            return 0.0f;
+        return StateFor(const_cast<Player*>(static_cast<Player const*>(unit))).setBonus[type];
+    }
+
+    void UpdateSetBonuses(Player* player, ZeldaState& state)
+    {
+        if (state.setsAppliedFor != player)
+        {
+            state.setsAppliedFor = player;      // a new login starts without the old crit bonus
+            state.appliedCrit = 0.0f;
+        }
+        std::unordered_map<uint32, uint32> worn;
+        if (!s_setOfItem.empty())
+        {
+            for (uint8 slot = EQUIPMENT_SLOT_START; slot < EQUIPMENT_SLOT_END; ++slot)
+                if (Item* item = player->GetItemByPos(INVENTORY_SLOT_BAG_0, slot))
+                {
+                    auto itr = s_setOfItem.find(item->GetEntry());
+                    if (itr != s_setOfItem.end())
+                        ++worn[itr->second];
+                }
+        }
+        float totals[SET_BONUS_MAX] = { 0, 0, 0, 0, 0, 0, 0, 0 };
+        for (SetBonusRow const& row : s_setBonuses)
+        {
+            auto itr = worn.find(row.set);
+            if (itr != worn.end() && itr->second >= row.pieces && row.type < SET_BONUS_MAX)
+                totals[row.type] += row.value;
+        }
+        for (uint32 i = 0; i < SET_BONUS_MAX; ++i)
+            state.setBonus[i] = totals[i];
+
+        float const crit = totals[SET_BONUS_CRIT];
+        if (crit != state.appliedCrit)
+        {
+            for (BaseModGroup group : { CRIT_PERCENTAGE, OFFHAND_CRIT_PERCENTAGE, RANGED_CRIT_PERCENTAGE })
+            {
+                if (state.appliedCrit != 0.0f)
+                    player->HandleBaseModValue(group, FLAT_MOD, state.appliedCrit, false);
+                if (crit != 0.0f)
+                    player->HandleBaseModValue(group, FLAT_MOD, crit, true);
+            }
+            state.appliedCrit = crit;
+        }
+    }
+
+    bool WearsNavisLight(Player const* player)
+    {
+        return player->HasItemWithIdEquipped(NAVI_TRINKET, 1);
+    }
+
+    Creature* NaviOf(Player* player, ZeldaState const& state)
+    {
+        if (!state.followerGuid[NAVI_INDEX] || !player->IsInWorld())
+            return nullptr;
+        return player->GetMap()->GetCreature(state.followerGuid[NAVI_INDEX]);
+    }
+}
+
+void ZeldaLoadStages()
+{
+    s_stages.clear();
+    auto result = WorldDatabase.Query("SELECT entry, show_quest, show_state, hide_quest, hide_state FROM zelda_stage");
+    if (!result)
+    {
+        sLog.outString(">> Zelda: no companion stages loaded");
+        return;
+    }
+    do
+    {
+        Field* f = result->Fetch();
+        StageRule rule;
+        rule.showQuest = f[1].GetUInt32();
+        rule.showState = f[2].GetUInt8();
+        rule.hideQuest = f[3].GetUInt32();
+        rule.hideState = f[4].GetUInt8();
+        s_stages[f[0].GetUInt32()] = rule;
+    }
+    while (result->NextRow());
+    sLog.outString(">> Zelda: loaded %u companion stages", uint32(s_stages.size()));
+}
+
+bool ZeldaStageHidden(Creature const* creature, Player const* player)
+{
+    if (!creature || !player || creature->IsTemporarySummon())
+        return false;
+    auto itr = s_stages.find(creature->GetEntry());
+    if (itr == s_stages.end())
+        return false;
+    StageRule const& rule = itr->second;
+    if (rule.showQuest && !QuestReached(player, rule.showQuest, rule.showState))
+        return true;
+    if (rule.hideQuest && QuestReached(player, rule.hideQuest, rule.hideState))
+        return true;
+    return false;
+}
