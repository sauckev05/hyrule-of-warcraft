+float ZeldaDualWieldHit(Unit const* unit)
+{
+    if (!unit || unit->GetTypeId() != TYPEID_PLAYER)
+        return 0.0f;
+    Player const* player = static_cast<Player const*>(unit);
+    Item* main = player->GetItemByPos(INVENTORY_SLOT_BAG_0, EQUIPMENT_SLOT_MAINHAND);
+    Item* off = player->GetItemByPos(INVENTORY_SLOT_BAG_0, EQUIPMENT_SLOT_OFFHAND);
+    if (!main || !off || off->GetProto()->Class != ITEM_CLASS_WEAPON || main->GetProto()->Class != ITEM_CLASS_WEAPON)
+        return 0.0f;
+    uint32 const warrior = ZeldaTalentRank(player, { 23584, 23585, 23586, 23587, 23588 });
+    uint32 const rogue = ZeldaTalentRank(player, { 13715, 13848, 13849, 13851, 13852 });
+    return float(std::max(warrior, rogue));
+}
