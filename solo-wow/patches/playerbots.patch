index 0000000..f0c1d3b
--- /dev/null
+++ b/playerbot/ZeldaMemory.h
@@ -0,0 +1,331 @@
+#pragma once
+
+// Zelda of Warcraft: an AI chat bot keeps what was said to her between server restarts, and a random
+// bot gets her personality from the LLM character card too (the module only loads the card for bots
+// that belong to a player). The conversation is kept in ai_playerbot_db_store under the preset
+// 'zelda', one row per chat channel, so the module's own saving and loading never touch it.
+
+#include "Database/DatabaseEnv.h"
+#include <cctype>
+#include <fstream>
+#include <map>
+#include <mutex>
+#include <regex>
+#include <set>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace zelda_memory
+{
+    inline std::string SafeKey(std::string key)
+    {
+        if (key.size() > 32)
+            key.resize(32);
+        CharacterDatabase.escape_string(key);
+        return key;
+    }
+
+    inline std::string LoadValue(uint32 guid, std::string const& rawKey)
+    {
+        std::string const key = SafeKey(rawKey);
+        auto result = CharacterDatabase.PQuery("SELECT `value` FROM `ai_playerbot_db_store` WHERE `guid` = '%u' AND `preset` = 'zelda' AND `key` = '%s' LIMIT 1", guid, key.c_str());
+        if (!result)
+            return "";
+        return result->Fetch()[0].GetCppString();
+    }
+
+    inline void SaveValue(uint32 guid, std::string const& rawKey, std::string text)
+    {
+        if (text.size() > 3900)
+            text = text.substr(text.size() - 3900);
+        std::string const key = SafeKey(rawKey);
+        CharacterDatabase.escape_string(text);
+        CharacterDatabase.PExecute("DELETE FROM `ai_playerbot_db_store` WHERE `guid` = '%u' AND `preset` = 'zelda' AND `key` = '%s'", guid, key.c_str());
+        CharacterDatabase.PExecute("INSERT INTO `ai_playerbot_db_store` (`guid`, `preset`, `key`, `value`) VALUES ('%u', 'zelda', '%s', '%s')", guid, key.c_str(), text.c_str());
+    }
+
+    // the conversation so far, one per chat channel
+    inline std::string Load(uint32 guid, std::string const& channel) { return LoadValue(guid, "mem" + channel); }
+    inline void Save(uint32 guid, std::string const& channel, std::string const& text) { SaveValue(guid, "mem" + channel, text); }
+
+    // what a player asked to be called
+    inline std::string Nick(uint32 guid, std::string const& player) { return LoadValue(guid, "nick" + player); }
+    inline void SetNick(uint32 guid, std::string const& player, std::string const& nick) { SaveValue(guid, "nick" + player, nick); }
+
+    // things she decided to remember for good, newest last (kept to the last 20)
+    inline std::vector<std::string> Facts(uint32 guid)
+    {
+        std::vector<std::string> facts;
+        std::string const all = LoadValue(guid, "facts");
+        size_t start = 0;
+        while (start < all.size())
+        {
+            size_t end = all.find('\n', start);
+            if (end == std::string::npos)
+                end = all.size();
+            if (end > start)
+                facts.push_back(all.substr(start, end - start));
+            start = end + 1;
+        }
+        return facts;
+    }
+
+    inline void AddFact(uint32 guid, std::string fact)
+    {
+        for (char& c : fact)
+            if (c == '\n' || c == '\r')
+                c = ' ';
+        if (fact.size() < 3)
+            return;
+        if (fact.size() > 160)
+            fact.resize(160);
+        std::vector<std::string> facts = Facts(guid);
+        for (auto i = facts.begin(); i != facts.end(); ++i)
+        {
+            if (*i == fact)
+            {
+                facts.erase(i);
+                break;
+            }
+        }
+        facts.push_back(fact);
+        while (facts.size() > 20)
+            facts.erase(facts.begin());
+        std::string all;
+        for (std::string const& f : facts)
+            all += f + "\n";
+        SaveValue(guid, "facts", all);
+    }
+
+    // the bot's line in the character card ("Name::personality"), read straight from the file so it
+    // works on the very first start too, before the card has been copied into the database
+    inline std::string PersonalityFromCard(std::string const& botName)
+    {
+        static std::mutex lock;
+        static std::map<std::string, std::string> cards;
+        static bool loaded = false;
+        std::lock_guard<std::mutex> guard(lock);
+        if (!loaded)
+        {
+            loaded = true;
+            for (char const* fileName : { "llm_character_card.txt", "llm_character_card" })
+            {
+                std::ifstream file(fileName);
+                if (!file.is_open())
+                    continue;
+                std::string line;
+                while (std::getline(file, line))
+                {
+                    while (!line.empty() && (line.back() == '\r' || line.back() == ' '))
+                        line.pop_back();
+                    size_t const delim = line.find("::");
+                    if (line.empty() || line[0] == '#' || delim == std::string::npos || delim == 0)
+                        continue;
+                    cards[line.substr(0, delim)] = line.substr(delim + 2);
+                }
+                break;
+            }
+        }
+        auto found = cards.find(botName);
+        return found != cards.end() ? found->second : "";
+    }
+
+    inline std::string Personality(uint32 guid, std::string const& botName)
+    {
+        std::string card = PersonalityFromCard(botName);
+        if (!card.empty())
+            return card;
+        static std::string const prefix = "manual saved string::llmdefaultprompt>";
+        auto result = CharacterDatabase.PQuery("SELECT `value` FROM `ai_playerbot_db_store` WHERE `guid` = '%u' AND `key` = 'value' AND `value` LIKE 'manual saved string::llmdefaultprompt>%%' LIMIT 1", guid);
+        if (!result)
+            return "";
+        std::string value = result->Fetch()[0].GetCppString();
+        return value.size() > prefix.size() ? value.substr(prefix.size()) : "";
+    }
+}
+
+// Zelda of Warcraft: what an AI chat bot says she will do, she does. The LLM ends a reply with an
+// action tag ([go Stormwind City], [follow], [stay], [free], [leave]); the tag is taken out of the
+// chat line here (on the thread that asked the LLM) and queued for the bot, and the bot carries it
+// out on her next update (PlayerbotAI::UpdateAI).
+namespace zelda_ai
+{
+    struct Pending
+    {
+        std::string action;
+        std::string arg;
+        uint32 requester;
+    };
+
+    inline std::mutex& QueueLock() { static std::mutex lock; return lock; }
+    inline std::map<uint32, std::vector<Pending>>& Queue() { static std::map<uint32, std::vector<Pending>> queue; return queue; }
+
+    // who the reply being generated on this thread is from, and who it answers
+    inline thread_local uint32 t_bot = 0;
+    inline thread_local uint32 t_requester = 0;
+
+    inline std::string Trim(std::string text)
+    {
+        size_t const first = text.find_first_not_of(" \t*.,;!-");
+        if (first == std::string::npos)
+            return "";
+        size_t const last = text.find_last_not_of(" \t*,;-");
+        return text.substr(first, last - first + 1);
+    }
+
+    inline void ExtractActions(std::vector<std::string>& lines)
+    {
+        static std::regex const tag(R"(\[\s*(go|travel|follow|stay|wait|free|leave|remember)\b\s*([^\]]*)\])", std::regex::icase);
+        std::vector<std::string> kept;
+        for (std::string const& line : lines)
+        {
+            std::string out;
+            auto begin = line.cbegin();
+            std::smatch match;
+            while (std::regex_search(begin, line.cend(), match, tag))
+            {
+                out.append(begin, match[0].first);
+                if (t_bot)
+                {
+                    std::string action = match[1].str();
+                    for (char& c : action)
+                        c = char(std::tolower((unsigned char)c));
+                    std::lock_guard<std::mutex> guard(QueueLock());
+                    Queue()[t_bot].push_back({ action, Trim(match[2].str()), t_requester });
+                }
+                begin = match[0].second;
+            }
+            out.append(begin, line.cend());
+            if (!Trim(out).empty())
+                kept.push_back(out);
+        }
+        lines = kept;
+    }
+
+    inline void Push(uint32 bot, std::string const& action, std::string const& arg, uint32 requester)
+    {
+        std::lock_guard<std::mutex> guard(QueueLock());
+        Queue()[bot].push_back({ action, arg, requester });
+    }
+
+    inline std::vector<Pending> Take(uint32 bot)
+    {
+        std::lock_guard<std::mutex> guard(QueueLock());
+        auto found = Queue().find(bot);
+        if (found == Queue().end())
+            return {};
+        std::vector<Pending> pending = std::move(found->second);
+        Queue().erase(found);
+        return pending;
+    }
+
+    // item entries linked in a chat message ("|Hitem:190901:...")
+    inline std::string LinkedItems(std::string const& message)
+    {
+        static std::regex const link(R"(Hitem:(\d+))");
+        std::string ids;
+        for (auto i = std::sregex_iterator(message.begin(), message.end(), link); i != std::sregex_iterator(); ++i)
+            ids += (*i)[1].str() + " ";
+        return ids;
+    }
+
+    // what the player plainly asks of her, recognised without the LLM: [action, place-or-name]
+    inline std::vector<std::pair<std::string, std::string>> DetectIntent(std::string const& message)
+    {
+        static std::regex const nick(R"(\b(?:call me|my name is|my name's|i go by|just call me)\s+([A-Za-z][A-Za-z'-]{1,15}))", std::regex::icase);
+        static std::regex const leave(R"(\b(?:leave|quit|drop|exit)\s+(?:the\s+|my\s+|your\s+|our\s+|this\s+)?(?:party|group)\b|\bdisband\b)", std::regex::icase);
+        static std::regex const follow(R"(\b(?:follow me|come with me|join me|join (?:my|the|our) (?:party|group)|come along|travel with me|team up|come here|come to me|party up|group up|let'?s go together|stay with me)\b)", std::regex::icase);
+        static std::regex const stay(R"(\b(?:wait|stay)\s+(?:here|there|right there|for me)\b|^\s*(?:wait|stay)\s*[.!]*\s*$)", std::regex::icase);
+        static std::regex const ownWay(R"(\b(?:do your own thing|go your own way|you'?re free|go explore|go on your own|go adventure)\b)", std::regex::icase);
+        static std::regex const go(R"(\b(?:meet(?: me| up| you)?(?: with me)?|go|head|travel|walk|run|come|let'?s go)\s+(?:over\s+)?(?:to|in|at|into)\s+(?:the\s+)?([A-Za-z' ]{3,40}))", std::regex::icase);
+
+        std::vector<std::pair<std::string, std::string>> found;
+        std::smatch match;
+        if (std::regex_search(message, match, nick))
+            found.push_back({ "nick", match[1].str() });
+        static std::regex const equip(R"(\b(?:equip\w*|wear|put (?:it |them |those |these |that |this )?on|try (?:it |them |those |these )?on|dress (?:up|in))\b)", std::regex::icase);
+        static std::regex const unequip(R"(\b(?:unequip\w*|take off|remove)\b)", std::regex::icase);
+        if (std::regex_search(message, unequip) && !LinkedItems(message).empty())
+            found.push_back({ "unequip", LinkedItems(message) });
+        else if (std::regex_search(message, equip))
+            found.push_back({ "equip", LinkedItems(message) });
+
+        if (std::regex_search(message, leave))
+            found.push_back({ "leave", "" });
+        else if (std::regex_search(message, follow))
+            found.push_back({ "follow", "" });
+        else if (std::regex_search(message, stay))
+            found.push_back({ "stay", "" });
+        else if (std::regex_search(message, ownWay))
+            found.push_back({ "free", "" });
+        else if (std::regex_search(message, match, go))
+        {
+            std::string place = Trim(match[1].str());
+            static std::set<std::string> const notPlaces = { "me", "you", "us", "here", "there", "him", "her", "them", "it", "bed", "sleep", "work" };
+            std::string lower = place;
+            for (char& c : lower)
+                c = char(std::tolower((unsigned char)c));
+            if (!place.empty() && !notPlaces.count(lower.substr(0, lower.find(' '))))
+                found.push_back({ "go", place });
+        }
+        return found;
+    }
+
+    // items a real player handed her in a trade this session (what "wear what I gave you" means)
+    inline std::mutex& GiftLock() { static std::mutex lock; return lock; }
+    inline std::map<uint32, std::vector<uint32>>& Gifts() { static std::map<uint32, std::vector<uint32>> gifts; return gifts; }
+
+    inline void AddGift(uint32 bot, uint32 item)
+    {
+        std::lock_guard<std::mutex> guard(GiftLock());
+        Gifts()[bot].push_back(item);
+    }
+
+    inline std::vector<uint32> TakeGifts(uint32 bot)
+    {
+        std::lock_guard<std::mutex> guard(GiftLock());
+        std::vector<uint32> gifts = std::move(Gifts()[bot]);
+        Gifts().erase(bot);
+        return gifts;
+    }
+
+    // what she was asked to wear: the bot AI's gear upgrades leave these on (kept across restarts)
+    inline std::mutex& WornLock() { static std::mutex lock; return lock; }
+    inline std::map<uint32, std::set<uint32>>& WornCache() { static std::map<uint32, std::set<uint32>> worn; return worn; }
+
+    inline std::set<uint32>& WornLocked(uint32 bot)
+    {
+        auto found = WornCache().find(bot);
+        if (found != WornCache().end())
+            return found->second;
+        std::set<uint32>& worn = WornCache()[bot];
+        std::istringstream in(zelda_memory::LoadValue(bot, "worn"));
+        for (uint32 item; in >> item;)
+            worn.insert(item);
+        return worn;
+    }
+
+    inline bool IsKeptWorn(uint32 bot, uint32 item)
+    {
+        std::lock_guard<std::mutex> guard(WornLock());
+        return WornLocked(bot).count(item) != 0;
+    }
+
+    inline void SetKeptWorn(uint32 bot, uint32 item, bool keep)
+    {
+        std::string all;
+        {
+            std::lock_guard<std::mutex> guard(WornLock());
+            std::set<uint32>& worn = WornLocked(bot);
+            if (keep)
+                worn.insert(item);
+            else
+                worn.erase(item);
+            for (uint32 entry : worn)
+                all += std::to_string(entry) + " ";
+        }
+        zelda_memory::SaveValue(bot, "worn", all);
+    }
+
+}
