+// Zelda of Warcraft: the longest start of the words that names a place she can travel to
+static std::string ZeldaFindPlace(Player* bot, std::string const& words)
+{
+    std::vector<std::string> parts;
+    std::istringstream in(words);
+    for (std::string word; in >> word;)
+        parts.push_back(word);
+    for (size_t n = std::min<size_t>(parts.size(), 4); n > 0; --n)
+    {
+        std::string candidate;
+        for (size_t i = 0; i < n; ++i)
+            candidate += (i ? " " : "") + parts[i];
+        if (candidate.size() >= 3 && !ai::ChooseTravelTargetAction::FindDestination(bot, candidate).empty())
+            return candidate;
+    }
+    return "";
+}
+
+static std::string ZeldaDescribe(std::string const& action, std::string const& arg)
+{
+    if (action == "go") return "you are setting off for " + arg + " right now";
+    if (action == "follow") return "you are joining their party to travel at their side";
+    if (action == "stay") return "you wait right where you are";
+    if (action == "free") return "you go back to your own adventures";
+    if (action == "leave") return "you leave the party";
+    if (action == "equip") return "you put on the gear they gave you";
+    if (action == "unequip") return "you take that gear off";
+    return "";
+}
+
+// what she knows about the person and about herself right now, for the LLM
+static std::string ZeldaSituation(PlayerbotAI* ai, Player* bot, Player* player, std::string const& callName, std::string const& doing)
+{
+    AiObjectContext* context = ai->GetAiObjectContext();
+    std::ostringstream out;
+    out << " The person talking to you is " << player->GetName();
+    if (callName != player->GetName())
+        out << ", who asked you to call them " << callName << ", so always call them " << callName << " and never " << player->GetName();
+    out << ".";
+
+    std::vector<std::string> facts = zelda_memory::Facts(bot->GetGUIDLow());
+    if (!facts.empty())
+    {
+        out << " Things you remember:";
+        for (std::string const& fact : facts)
+            out << " " << fact << ";";
+    }
+
+    Group* group = bot->GetGroup();
+    if (group && group->IsMember(player->GetObjectGuid()))
+        out << " Right now you are in a party with " << callName << (ai->HasStrategy("stay", BotState::BOT_STATE_NON_COMBAT) ? " and waiting where you are." : " and travelling at their side.");
+    else if (group)
+        out << " Right now you are in a party with other people.";
+    else
+        out << " Right now you are on your own adventure, not in anyone's party.";
+
+    TravelTarget* target = AI_VALUE(TravelTarget*, "travel target");
+    if (target && target->IsForced() && target->GetDestination())
+        out << " You are on your way to " << target->GetDestination()->GetTitle() << ".";
+
+    if (bot->GetMapId() == player->GetMapId() && bot->IsWithinDist(player, 40.0f))
+        out << " " << callName << " is right next to you.";
+    else if (bot->GetMapId() == player->GetMapId())
+        out << " " << callName << " is about " << uint32(bot->GetDistance(player)) << " yards away from you.";
+    else
+        out << " " << callName << " is far away, in another land.";
+
+    if (!doing.empty())
+        out << " You do what " << callName << " asked: " << doing << ", so say yes and do not add an action tag.";
+    else
+        out << " When you decide to really do something, end your reply with one action tag in square brackets:"
+               " [go PLACE] to travel there yourself (a city or zone, for example [go Stormwind City]),"
+               " [follow] to team up with " << callName << " and travel at their side, [stay] to wait where you are,"
+               " [free] to go back to your own adventures, [leave] to leave their party."
+               " If " << callName << " tells you something important about themselves, you may end with [remember <a short note>] instead."
+               " Only add a tag when you truly decide to act on it, never more than one, and keep your promises.";
+    return out.str();
+}
