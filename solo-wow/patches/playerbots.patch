diff --git a/playerbot/ZeldaMemory.h b/playerbot/ZeldaMemory.h
new file mode 100644
index 0000000..932b07d
--- /dev/null
+++ b/playerbot/ZeldaMemory.h
@@ -0,0 +1,161 @@
+#pragma once
+
+// Zelda of Warcraft: an AI chat bot keeps what was said to her between server restarts, and a random
+// bot gets her personality from the LLM character card too (the module only loads the card for bots
+// that belong to a player). The conversation is kept in ai_playerbot_db_store under the preset
+// 'zelda', one row per chat channel, so the module's own saving and loading never touch it.
+
+#include "Database/DatabaseEnv.h"
+#include <fstream>
+#include <map>
+#include <mutex>
+#include <regex>
+#include <string>
+#include <vector>
+
+namespace zelda_memory
+{
+    inline std::string Key(std::string const& channel)
+    {
+        std::string key = "mem" + channel;
+        if (key.size() > 32)
+            key.resize(32);
+        CharacterDatabase.escape_string(key);
+        return key;
+    }
+
+    inline std::string Load(uint32 guid, std::string const& channel)
+    {
+        std::string const key = Key(channel);
+        auto result = CharacterDatabase.PQuery("SELECT `value` FROM `ai_playerbot_db_store` WHERE `guid` = '%u' AND `preset` = 'zelda' AND `key` = '%s' LIMIT 1", guid, key.c_str());
+        if (!result)
+            return "";
+        return result->Fetch()[0].GetCppString();
+    }
+
+    inline void Save(uint32 guid, std::string const& channel, std::string text)
+    {
+        if (text.size() > 3900)
+            text = text.substr(text.size() - 3900);
+        std::string const key = Key(channel);
+        CharacterDatabase.escape_string(text);
+        CharacterDatabase.PExecute("DELETE FROM `ai_playerbot_db_store` WHERE `guid` = '%u' AND `preset` = 'zelda' AND `key` = '%s'", guid, key.c_str());
+        CharacterDatabase.PExecute("INSERT INTO `ai_playerbot_db_store` (`guid`, `preset`, `key`, `value`) VALUES ('%u', 'zelda', '%s', '%s')", guid, key.c_str(), text.c_str());
+    }
+
+    // the bot's line in the character card ("Name::personality"), read straight from the file so it
+    // works on the very first start too, before the card has been copied into the database
+    inline std::string PersonalityFromCard(std::string const& botName)
+    {
+        static std::mutex lock;
+        static std::map<std::string, std::string> cards;
+        static bool loaded = false;
+        std::lock_guard<std::mutex> guard(lock);
+        if (!loaded)
+        {
+            loaded = true;
+            for (char const* fileName : { "llm_character_card.txt", "llm_character_card" })
+            {
+                std::ifstream file(fileName);
+                if (!file.is_open())
+                    continue;
+                std::string line;
+                while (std::getline(file, line))
+                {
+                    while (!line.empty() && (line.back() == '\r' || line.back() == ' '))
+                        line.pop_back();
+                    size_t const delim = line.find("::");
+                    if (line.empty() || line[0] == '#' || delim == std::string::npos || delim == 0)
+                        continue;
+                    cards[line.substr(0, delim)] = line.substr(delim + 2);
+                }
+                break;
+            }
+        }
+        auto found = cards.find(botName);
+        return found != cards.end() ? found->second : "";
+    }
+
+    inline std::string Personality(uint32 guid, std::string const& botName)
+    {
+        std::string card = PersonalityFromCard(botName);
+        if (!card.empty())
+            return card;
+        static std::string const prefix = "manual saved string::llmdefaultprompt>";
+        auto result = CharacterDatabase.PQuery("SELECT `value` FROM `ai_playerbot_db_store` WHERE `guid` = '%u' AND `key` = 'value' AND `value` LIKE 'manual saved string::llmdefaultprompt>%%' LIMIT 1", guid);
+        if (!result)
+            return "";
+        std::string value = result->Fetch()[0].GetCppString();
+        return value.size() > prefix.size() ? value.substr(prefix.size()) : "";
+    }
+}
+
+// Zelda of Warcraft: what an AI chat bot says she will do, she does. The LLM ends a reply with an
+// action tag ([go Stormwind City], [follow], [stay], [free], [leave]); the tag is taken out of the
+// chat line here (on the thread that asked the LLM) and queued for the bot, and the bot carries it
+// out on her next update (PlayerbotAI::UpdateAI).
+namespace zelda_ai
+{
+    struct Pending
+    {
+        std::string action;
+        std::string arg;
+        uint32 requester;
+    };
+
+    inline std::mutex& QueueLock() { static std::mutex lock; return lock; }
+    inline std::map<uint32, std::vector<Pending>>& Queue() { static std::map<uint32, std::vector<Pending>> queue; return queue; }
+
+    // who the reply being generated on this thread is from, and who it answers
+    inline thread_local uint32 t_bot = 0;
+    inline thread_local uint32 t_requester = 0;
+
+    inline std::string Trim(std::string text)
+    {
+        size_t const first = text.find_first_not_of(" \t*.,;!-");
+        if (first == std::string::npos)
+            return "";
+        size_t const last = text.find_last_not_of(" \t*,;-");
+        return text.substr(first, last - first + 1);
+    }
+
+    inline void ExtractActions(std::vector<std::string>& lines)
+    {
+        static std::regex const tag(R"(\[\s*(go|travel|follow|stay|wait|free|leave)\b\s*([^\]]*)\])", std::regex::icase);
+        std::vector<std::string> kept;
+        for (std::string const& line : lines)
+        {
+            std::string out;
+            auto begin = line.cbegin();
+            std::smatch match;
+            while (std::regex_search(begin, line.cend(), match, tag))
+            {
+                out.append(begin, match[0].first);
+                if (t_bot)
+                {
+                    std::string action = match[1].str();
+                    for (char& c : action)
+                        c = char(std::tolower((unsigned char)c));
+                    std::lock_guard<std::mutex> guard(QueueLock());
+                    Queue()[t_bot].push_back({ action, Trim(match[2].str()), t_requester });
+                }
+                begin = match[0].second;
+            }
+            out.append(begin, line.cend());
+            if (!Trim(out).empty())
+                kept.push_back(out);
+        }
+        lines = kept;
+    }
+
+    inline std::vector<Pending> Take(uint32 bot)
+    {
+        std::lock_guard<std::mutex> guard(QueueLock());
+        auto found = Queue().find(bot);
+        if (found == Queue().end())
+            return {};
+        std::vector<Pending> pending = std::move(found->second);
+        Queue().erase(found);
+        return pending;
+    }
+}
