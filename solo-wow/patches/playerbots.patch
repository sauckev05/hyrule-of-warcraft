+// Zelda of Warcraft: takes an AI chat bot out of any party (or pending invitation) that does not
+// have keepWith in it
+static void ZeldaLeaveParty(Player* bot, Player* keepWith)
+{
+    if (bot->GetGroupInvite())
+        bot->UninviteFromGroup();
+    Group* group = bot->GetGroup();
+    if (group && (!keepWith || !group->IsMember(keepWith->GetObjectGuid())))
+        Player::RemoveFromGroup(group, bot->GetObjectGuid());
+}
+
+// a party left over from before (no real player's character in it) is let go of at login
+static void ZeldaDropStaleParty(Player* bot)
+{
+    if (bot->GetGroupInvite())
+        bot->UninviteFromGroup();
+    Group* group = bot->GetGroup();
+    if (!group)
+        return;
+    uint32 const botAccount = bot->GetSession()->GetAccountId();
+    for (auto const& slot : group->GetMemberSlots())
+    {
+        if (slot.guid != bot->GetObjectGuid() && sObjectMgr.GetPlayerAccountIdByGUID(slot.guid) != botAccount &&
+            !sPlayerbotAIConfig.IsInRandomAccountList(sObjectMgr.GetPlayerAccountIdByGUID(slot.guid)))
+            return;
+    }
+    Player::RemoveFromGroup(group, bot->GetObjectGuid());
+}
+
+// Zelda of Warcraft: carries out what an AI chat bot said she would do (zelda_ai in ZeldaMemory.h)
+static void ZeldaRunAction(PlayerbotAI* ai, Player* bot, zelda_ai::Pending const& pending)
+{
+    if (pending.action == "remember")
+    {
+        zelda_memory::AddFact(bot->GetGUIDLow(), pending.arg);
+        return;
+    }
+
+    Player* requester = sObjectMgr.GetPlayer(ObjectGuid(HIGHGUID_PLAYER, pending.requester));
+    if (!requester || !requester->IsInWorld())
+        return;
+    Group* group = bot->GetGroup();
+    bool const together = group && group->IsMember(requester->GetObjectGuid());
+
+    if (pending.action == "go" || pending.action == "travel")
+    {
+        if (pending.arg.empty())
+            return;
+        if (together)
+            ai->DoSpecificAction("free chat shortcut", Event("zelda", "", requester), true);
+        ai->DoSpecificAction("go", Event("zelda", "travel " + pending.arg, requester), true);
+    }
+    else if (pending.action == "follow")
+    {
+        if (together)
+        {
+            ai->DoSpecificAction("follow chat shortcut", Event("zelda", "", requester), true);
+            return;
+        }
+        ZeldaLeaveParty(bot, requester);
+        if (bot->GetGroup() || (requester->GetGroup() && requester->GetGroup()->IsFull()))
+            return;
+        // she asks to come along: the hero invites her, and she accepts like any invited bot
+        std::unique_ptr<WorldPacket> invite(new WorldPacket(CMSG_GROUP_INVITE));
+        *invite << std::string(bot->GetName());
+        requester->GetSession()->QueuePacket(std::move(invite));
+    }
+    else if (pending.action == "stay" || pending.action == "wait")
+        ai->DoSpecificAction("stay chat shortcut", Event("zelda", "", requester), true);
+    else if (pending.action == "free")
+        ai->DoSpecificAction("free chat shortcut", Event("zelda", "", requester), true);
+    else if (pending.action == "equip")
+    {
+        // the items linked in the request, or else everything the player just handed her
+        std::vector<uint32> items;
+        std::istringstream in(pending.arg);
+        for (uint32 entry; in >> entry;)
+            items.push_back(entry);
+        if (items.empty())
+            items = zelda_ai::TakeGifts(bot->GetGUIDLow());
+        if (items.empty())
+        {
+            // nothing handed over this session: the Zelda gear in her bags (armor sets, boutique)
+            for (uint32 entry = 190700; entry < 191000; ++entry)
+            {
+                Item* item = bot->GetItemByEntry(entry);
+                if (item && !item->IsEquipped())
+                    items.push_back(entry);
+            }
+        }
+        for (uint32 entry : items)
+        {
+            Item* item = bot->GetItemByEntry(entry);
+            if (!item)
+                continue;
+            if (!item->IsEquipped())
+            {
+                WorldPacket packet(CMSG_AUTOEQUIP_ITEM, 2);
+                packet << item->GetBagSlot() << item->GetSlot();
+                bot->GetSession()->HandleAutoEquipItemOpcode(packet);
+            }
+            Item* now = bot->GetItemByEntry(entry);
+            if (now && now->IsEquipped())
+                zelda_ai::SetKeptWorn(bot->GetGUIDLow(), entry, true);
+        }
+    }
+    else if (pending.action == "unequip")
+    {
+        std::istringstream in(pending.arg);
+        for (uint32 entry; in >> entry;)
+        {
+            zelda_ai::SetKeptWorn(bot->GetGUIDLow(), entry, false);
+            Item* item = bot->GetItemByEntry(entry);
+            if (!item || !item->IsEquipped())
+                continue;
+            ItemPosCountVec dest;
+            uint8 bagSlot = 0;
+            if (bot->CanStoreItem(NULL_BAG, NULL_SLOT, dest, item, bagSlot, false) == EQUIP_ERR_OK)
+            {
+                bot->RemoveItem(INVENTORY_SLOT_BAG_0, item->GetSlot(), true);
+                bot->StoreItem(dest, item, true);
+            }
+        }
+    }
+    else if (pending.action == "leave")
+    {
+        ZeldaLeaveParty(bot, nullptr);
+        if (ai->GetMaster() == requester)
+        {
+            ai->SetMaster(nullptr);
+            ai->ResetStrategies();
+        }
+    }
+}
