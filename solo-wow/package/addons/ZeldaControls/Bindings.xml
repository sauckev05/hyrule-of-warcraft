<Bindings>
	<Binding name="ZELDA_ATTACK" runOnUp="true" header="ZELDA">ZeldaControls_Attack(keystate)</Binding>
	<Binding name="ZELDA_SHIELD" runOnUp="true">ZeldaControls_Shield(keystate)</Binding>
	<Binding name="ZELDA_ROLL">ZeldaControls_Command(".zroll f")</Binding>
	<Binding name="ZELDA_ROLL_LEFT">ZeldaControls_ShiftMove(".zroll l")</Binding>
	<Binding name="ZELDA_ROLL_RIGHT">ZeldaControls_ShiftMove(".zroll r")</Binding>
	<Binding name="ZELDA_FLIP">ZeldaControls_ShiftMove(".zflip")</Binding>
	<Binding name="ZELDA_BOW">ZeldaControls_Command(".zbow")</Binding>
	<Binding name="ZELDA_HOOK">ZeldaControls_Command(".zboomerang")</Binding>
	<Binding name="ZELDA_POTION">ZeldaControls_DrinkPotion()</Binding>
	<Binding name="ZELDA_MOUNT">ZeldaControls_Ride()</Binding>
	<Binding name="ZELDA_INVENTORY">ZeldaControls_Inventory()</Binding>
	<Binding name="ZELDA_SUBSCREEN">ZeldaControls_Subscreen()</Binding>
	<Binding name="ZELDA_SUB_PREV">ZeldaControls_SubscreenPrev()</Binding>
	<Binding name="ZELDA_SUB_NEXT">ZeldaControls_SubscreenNext()</Binding>
	<Binding name="ZELDA_STANCE_PREV">ZeldaControls_StancePrev()</Binding>
	<Binding name="ZELDA_STANCE_NEXT">ZeldaControls_StanceNext()</Binding>
	<Binding name="ZELDA_TARGET" runOnUp="true">ZeldaControls_Target(keystate)</Binding>
</Bindings>
